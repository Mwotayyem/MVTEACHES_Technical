@page
@model MVTeaches.Web.Pages.Account.LoginWith2faModel
@{
    ViewData["Title"] = T["Two-factor verification"].Value;
}

<h1>@T["Two-factor verification"]</h1>
<p class="text-muted">@T["Enter the 6-digit code from your authenticator app."]</p>

<div class="row">
    <div class="col-md-6">
        <form method="post" asp-route-rememberMe="@Model.RememberMe" asp-route-returnUrl="@Model.ReturnUrl">
            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <div class="form-floating mb-3">
                <input asp-for="Input.Code" class="form-control" autocomplete="one-time-code" aria-required="true" />
                <label asp-for="Input.Code">@T["Verification code"]</label>
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>
            <div class="checkbox mb-3">
                <label asp-for="Input.RememberMachine" class="form-label">
                    <input class="form-check-input" asp-for="Input.RememberMachine" />
                    @T["Remember this device"]
                </label>
            </div>
            <button type="submit" class="btn btn-primary">@T["Verify"]</button>
        </form>
        <p class="mt-3">
            <a asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">@T["I don't have access to my authenticator device — use a recovery code"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
