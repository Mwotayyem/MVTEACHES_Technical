@page
@model MVTeaches.Web.Pages.Account.LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Recovery code";
}

<h1>Recovery code verification</h1>
<p class="text-muted">Enter one of the recovery codes you saved when you set up two-factor authentication. Each code works only once.</p>

<div class="row">
    <div class="col-md-6">
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" aria-required="true" />
                <label asp-for="Input.RecoveryCode"></label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Verify</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
