@page
@model MVTeaches.Web.Pages.Student.MySessionsModel
@using MVTeaches.Domain.People
@{
    ViewData["Title"] = T["My Sessions"].Value;
}

@functions {
    string StudentStatusClass(StudentStatus status) => status switch
    {
        StudentStatus.Active => "app-status is-success",
        StudentStatus.PendingVerification or StudentStatus.PendingLevel => "app-status is-warning",
        StudentStatus.PaymentBlocked or StudentStatus.Suspended => "app-status is-danger",
        _ => "app-status is-muted",
    };
}

<h1>@T["My Sessions"]</h1>

@if (Model.NoStudentProfileLinked)
{
    <div class="alert alert-warning" role="alert">@T["This account has no linked student profile yet — ask an admin to link it on /Admin/Students."]</div>
}
else
{
    @* A student could previously see their next lesson here but not whether
       they still owed anything, how much of the package was left, or what to
       do about either. The money figures come from the same shared helper the
       admin screens use, so the two can never disagree. *@
    <section class="app-profile-hero">
        <div class="app-profile-id">
            <h2>@Model.StudentName</h2>
            <p>
                @if (Model.CurrentPlacements.Count == 0)
                {
                    <span class="app-chip is-level">@T["Awaiting a level"]</span>
                }
                else
                {
                    @* One chip per course: a student placed in two subjects has
                       two levels, and a single chip would have to lie about one. *@
                    foreach (var placement in Model.CurrentPlacements)
                    {
                        <span class="app-chip is-level">@placement.CourseName @placement.LevelCode</span>
                    }
                }
                <span class="@StudentStatusClass(Model.StudentStatus)">@T["StudentStatus." + Model.StudentStatus]</span>
                <span class="app-chip">@T["Student number"]: <span class="app-ref">@Model.StudentNumber</span></span>
            </p>
            @if (Model.CurrentPackageName is not null)
            {
                <p class="text-muted mb-0">@T["Current package"]: <strong>@Model.CurrentPackageName</strong></p>
            }
        </div>
    </section>

    <div class="app-stat-grid">
        <article class="app-stat">
            <span class="app-stat-label">@T["Balance left"]</span>
            <strong class="app-stat-value">@T.Minutes(Model.RemainingMinutes)</strong>
            @if (Model.PurchasedMinutes > 0)
            {
                <div class="app-meter" role="img" aria-label="@T["{0}% of the purchased time has been used.", Model.UsedPercent]">
                    <span class="app-meter-fill @(Model.UsedPercent >= 85 ? "is-warning" : "is-primary")" style="width:@(Model.UsedPercent)%"></span>
                </div>
                <span class="app-stat-note">@T["Used"] @T.Minutes(Model.UsedMinutes) / @T.Minutes(Model.PurchasedMinutes)</span>
            }
        </article>

        <article class="app-stat">
            <span class="app-stat-label">@T["Lessons attended"]</span>
            <strong class="app-stat-value">@Model.LessonsAttended</strong>
            <span class="app-stat-note">@T["Lessons ahead"]: @Model.LessonsUpcoming</span>
        </article>

        @if (Model.MoneyCurrency is not null)
        {
            <article class="app-stat">
                <span class="app-stat-label">@T["Paid"]</span>
                <strong class="app-stat-value">@T.Money(Model.Paid, Model.MoneyCurrency)</strong>
                <span class="app-stat-note">@T["Package price"]: @T.Money(Model.Billed, Model.MoneyCurrency)</span>
            </article>

            <article class="app-stat @(Model.Outstanding > 0m ? "is-bad" : "is-good")">
                <span class="app-stat-label">@T["Still owed"]</span>
                <strong class="app-stat-value">@T.Money(Model.Outstanding, Model.MoneyCurrency)</strong>
                <span class="app-stat-note">
                    @if (Model.HasPaymentAwaitingConfirmation)
                    {
                        @T["A transfer is under review - please wait for the centre to confirm it."]
                    }
                    else if (Model.Outstanding > 0m)
                    {
                        @T["The package activates once the full amount is confirmed."]
                    }
                    else
                    {
                        @T["Fully paid."]
                    }
                </span>
            </article>
        }
    </div>

    @* The missing step: a package paid short must be finished on the SAME
       package, not by buying another one. This only navigates - the amount is
       recomputed server-side by /PurchasePackage before anything is requested. *@
    @if (Model.TopUpSubscriptionId is not null)
    {
        <div class="app-callout is-warning">
            <div>
                <strong>@T["You still have an amount to complete on your current package."]</strong>
                <p class="mb-0">
                    @T["Remaining owed"]: <strong>@T.Money(Model.TopUpRemaining, Model.MoneyCurrency)</strong>.
                    @T["Do not buy a new package - finish paying this one. Send only the remaining amount and upload the receipt for it."]
                </p>
            </div>
            <a class="btn btn-primary" asp-page="/PurchasePackage" asp-fragment="finish-paying">@T["Complete the remaining amount"]</a>
        </div>
    }
    else if (Model.HasPaymentAwaitingConfirmation)
    {
        <div class="app-callout is-info">
            <div>
                <strong>@T["Your transfer is being reviewed."]</strong>
                <p class="mb-0">@T["The centre confirms the money first, and only then does the package activate. You do not need to send anything again."]</p>
            </div>
            <a class="btn btn-outline-secondary" asp-page="/PurchasePackage">@T["See my payment requests"]</a>
        </div>
    }

    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }
    @if (Model.NoLevelAssigned)
    {
        <div class="alert alert-warning" role="alert">@T["You don't have a level assigned yet — ask an admin. You'll be able to browse and book sessions once you do."]</div>
    }

    <h2 class="h4">@T["My enrolled sessions"]</h2>
    <div class="table-responsive mb-4">
        <table class="table table-sm table-striped">
            <thead><tr><th>@T["When"]</th><th>@T["Course and level"]</th><th>@T["Status"]</th><th>@T["Attendance"]</th><th>@T["Actions"]</th></tr></thead>
            <tbody>
                @foreach (var s in Model.MySessions)
                {
                    <tr>
                        <td>
                            @* Owner decision 2026-09-04: the student's own country
                               time, always labelled; the centre's schedule time is
                               added only when the two zones actually differ. *@
                            @T.SessionMoment(s.StartsAtUtc, Model.StudentTimeZone)
                            <div class="text-muted small">@DisplayFormat.ZoneLabel(Model.StudentTimeZone)</div>
                            @if (!string.Equals(Model.StudentTimeZone, s.ScheduleTimeZone, StringComparison.Ordinal))
                            {
                                <div class="text-muted small">@T["Centre time: {0} ({1})", T.SessionMoment(s.StartsAtUtc, s.ScheduleTimeZone), DisplayFormat.ZoneLabel(s.ScheduleTimeZone)]</div>
                            }
                        </td>
                        <td>@s.CourseName / @s.LevelCode</td>
                        <td>@T["ClassSessionStatus." + s.SessionStatus]</td>
                        <td>
                            @switch (s.Attendance)
                            {
                                case MVTeaches.Web.Pages.Student.MySessionsModel.AttendanceState.Present:
                                    <span class="app-status is-success">@T["Present"]</span>
                                    break;
                                case MVTeaches.Web.Pages.Student.MySessionsModel.AttendanceState.NoShow:
                                    <span class="app-status is-danger">@T["No-show"]</span>
                                    break;
                                default:
                                    <span class="text-muted">@T["Not specified"]</span>
                                    break;
                            }
                        </td>
                        <td>
                            @if (s.CanJoin)
                            {
                                <form method="post" asp-page-handler="Join" class="d-inline">
                                    <input type="hidden" name="sessionId" value="@s.SessionId" />
                                    <button type="submit" class="btn btn-sm btn-primary">@T["Join"]</button>
                                </form>
                            }
                            @if (s.CanRequestReplacement)
                            {
                                <form method="post" asp-page-handler="RequestReplacement" class="d-flex gap-1 flex-wrap">
                                    <input type="hidden" name="sessionId" value="@s.SessionId" />
                                    <input type="text" name="CompensationReason" class="form-control form-control-sm w-auto"
                                           placeholder="@T["Reason (optional)"]" aria-label="@T["Reason (optional)"]" style="max-width:180px" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning">@T["Request replacement"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.MySessions.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">@T["No enrolled sessions in this window."]</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.NoLevelAssigned)
    {
        <h2 class="h4">@T["Available sessions for your level"]</h2>
        <div class="table-responsive mb-4">
            <table class="table table-sm table-striped">
                <thead><tr><th>@T["When"]</th><th>@T["Course and level"]</th><th>@T["Enrolled / seats"]</th><th>@T["Status"]</th><th>@T["Actions"]</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.AvailableSessions)
                    {
                        <tr>
                            <td>
                                @T.SessionMoment(s.StartsAtUtc, Model.StudentTimeZone)
                                <div class="text-muted small">@DisplayFormat.ZoneLabel(Model.StudentTimeZone)</div>
                                @if (!string.Equals(Model.StudentTimeZone, s.ScheduleTimeZone, StringComparison.Ordinal))
                                {
                                    <div class="text-muted small">@T["Centre time: {0} ({1})", T.SessionMoment(s.StartsAtUtc, s.ScheduleTimeZone), DisplayFormat.ZoneLabel(s.ScheduleTimeZone)]</div>
                                }
                            </td>
                            <td>@s.CourseName / @s.LevelCode</td>
                            <td>
                                <strong>@s.SeatsTaken</strong> / @s.Capacity
                                <div class="text-muted small">@T["students enrolled"]</div>
                            </td>
                            <td>
                                @if (s.AlreadyBooked)
                                {
                                    <span class="app-status is-success">@T["You are already booked"]</span>
                                }
                                else if (s.IsFull)
                                {
                                    <span class="app-status is-danger">@T["Full"]</span>
                                }
                                else
                                {
                                    <span class="app-status is-success">@T["Seats available"]</span>
                                    <div class="text-muted small">@T["Free seats: {0}", s.SeatsRemaining]</div>
                                }
                            </td>
                            <td>
                                @if (s.CanBook)
                                {
                                    <form method="post" asp-page-handler="Book">
                                        <input type="hidden" name="sessionId" value="@s.SessionId" />
                                        <button type="submit" class="btn btn-sm btn-success">@T["Book"]</button>
                                    </form>
                                    @if (Model.RemainingMinutes < s.DurationMinutes)
                                    {
                                        <div class="text-warning small mt-1">@T["Your remaining balance may not cover this lesson."]</div>
                                    }
                                }
                                else if (s.AlreadyBooked)
                                {
                                    <span class="text-muted small">@T["It is already in your list above."]</span>
                                }
                                else
                                {
                                    <span class="text-muted small">@T["No seat left in this lesson."]</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.AvailableSessions.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted">@T["No available sessions for your level in the next 30 days."]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2 class="h4">@T["My replacement requests"]</h2>
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead><tr><th>@T["Missed session"]</th><th>@T["Reason"]</th><th>@T["Status"]</th><th>@T["Replacement"]</th></tr></thead>
            <tbody>
                @foreach (var r in Model.MyCompensationRequests)
                {
                    <tr>
                        <td>@T.SessionMoment(r.OriginalSessionStartsAtUtc, r.OriginalSessionTimeZone)</td>
                        <td>@(r.Reason ?? T["Not specified"].Value)</td>
                        <td>@T["CompensationRequestStatus." + r.Status]</td>
                        <td>
                            @if (r.Status == MVTeaches.Domain.Scheduling.CompensationRequestStatus.Approved && r.ReplacementStartsAtUtc is not null)
                            {
                                @T.SessionMoment(r.ReplacementStartsAtUtc, r.ReplacementTimeZone)
                            }
                            else if (r.Status == MVTeaches.Domain.Scheduling.CompensationRequestStatus.Rejected)
                            {
                                @(T["CompensationRequestStatus.Rejected"].Value + (r.RejectionReason is not null ? $" — {r.RejectionReason}" : ""))
                            }
                            else
                            {
                                <span class="text-muted">@T["Pending review"]</span>
                            }
                        </td>
                    </tr>
                }
                @if (Model.MyCompensationRequests.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted">@T["No replacement requests yet."]</td></tr>
                }
            </tbody>
        </table>
    </div>
}
