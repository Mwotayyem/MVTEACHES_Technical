@page
@model MVTeaches.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = T["Dashboard"].Value;
}

<h1>@T["Dashboard"]</h1>
<p class="text-muted">@T["Live counts, read directly from the database — nothing here is cached or precomputed."]</p>

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@T["Active students"]</h5>
                <p class="card-text display-6">@Model.ActiveStudents</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@T["Active teachers"]</h5>
                <p class="card-text display-6">@Model.ActiveTeachers</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@T["Sessions today (UTC)"]</h5>
                <p class="card-text display-6">@Model.SessionsToday</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">@T["Open payroll periods"]</h5>
                <p class="card-text display-6">@Model.OpenPayrollPeriods</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card @(Model.UnresolvedScheduleConflicts > 0 ? "border-warning" : "")">
            <div class="card-body">
                <h5 class="card-title">@T["Unresolved schedule conflicts"]</h5>
                <p class="card-text display-6">@Model.UnresolvedScheduleConflicts</p>
                @if (Model.UnresolvedScheduleConflicts > 0)
                {
                    <p class="card-text text-warning small">@T["A teacher-overlap or time-off collision the schedule generator could not resolve on its own."]</p>
                }
            </div>
        </div>
    </div>
</div>
