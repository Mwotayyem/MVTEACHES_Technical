@page
@model MVTeaches.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = T["Dashboard"].Value;
    var busiest = Model.BusiestDayCount;
}

<div class="app-page-head">
    <div>
        <h1>@T["Dashboard"]</h1>
        <p class="text-muted">@T["Everything on this page is counted live from the database as you load it."]</p>
    </div>
    <div class="app-page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Students">@T["Students"]</a>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Schedules">@T["Schedules"]</a>
        <a class="btn btn-primary btn-sm" asp-page="/Admin/AssistedRegistration">@T["Register a family step by step"]</a>
    </div>
</div>

@if (Model.TotalWaiting == 0)
{
    <div class="alert alert-success" role="status">
        <strong>@T["Nothing is waiting on you."]</strong>
        @T["No payment to confirm, no request to review, no student stuck without a level."]
    </div>
}
else
{
    <div class="alert alert-warning" role="status">
        <strong>@T["{0} thing(s) are waiting on you.", Model.TotalWaiting]</strong>
        @T["Each card below is a queue: open it, deal with it, and the number goes down."]
        <div class="d-flex flex-wrap gap-2 mt-2">
            @if (Model.PaymentsAwaitingConfirmation > 0)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Payments">@T["Confirm payments"] (@Model.PaymentsAwaitingConfirmation)</a>
            }
            @if (Model.StudentsWithoutLevel > 0)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Students">@T["Set levels"] (@Model.StudentsWithoutLevel)</a>
            }
            @if (Model.ReplacementRequestsAwaitingReview > 0)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/CompensationRequests">@T["Review make-up requests"] (@Model.ReplacementRequestsAwaitingReview)</a>
            }
            @if (Model.DeliveriesAwaitingVerification > 0)
            {
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Payroll">@T["Check delivered lessons"] (@Model.DeliveriesAwaitingVerification)</a>
            }
        </div>
    </div>
}

@* The money and the shape of the student body - the two questions a head
   count of "active students" never answered. Every figure is counted live
   from the same tables the screens below it use, per currency, and never
   summed across currencies (D-53). *@
<h2 class="h4">@T["Money"]</h2>
<div class="app-stat-grid">
    @foreach (var money in Model.Money)
    {
        <div class="app-stat">
            <span class="app-stat-label">@T["Paid this month"] (@money.Currency)</span>
            <strong class="app-stat-value">@T.Money(money.PaidThisMonth, money.Currency)</strong>
            <span class="app-stat-note">@T["Confirmed as received since the first of this month."]</span>
        </div>
        <div class="app-stat @(money.Outstanding > 0m ? "is-attention" : null)">
            <span class="app-stat-label">@T["Outstanding"] (@money.Currency)</span>
            <strong class="app-stat-value @(money.Outstanding > 0m ? "is-bad" : "is-good")">@T.Money(money.Outstanding, money.Currency)</strong>
            <span class="app-stat-note">@T["Billed on running and unpaid packages, minus everything confirmed."]</span>
        </div>
    }
    @if (Model.Money.Count == 0)
    {
        <div class="app-stat">
            <span class="app-stat-label">@T["Money"]</span>
            <strong class="app-stat-value is-text is-empty">—</strong>
            <span class="app-stat-note">@T["Nothing has been billed or paid yet."]</span>
        </div>
    }
    <div class="app-stat">
        <span class="app-stat-label">@T["Running packages"]</span>
        <strong class="app-stat-value">@Model.RunningPackages</strong>
        <span class="app-stat-note">@T["{0} weekly class(es) are producing sessions.", Model.RunningWeeklyClasses]</span>
    </div>
</div>

<h2 class="h4">@T["Where the students stand"]</h2>
<p class="text-muted small">@T["The same states shown on each row of the register — click one to see exactly those students."]</p>
<div class="app-state-chips mb-4">
    @foreach (var state in new[]
    {
        MVTeaches.Web.Display.StudentLifecycleState.Active,
        MVTeaches.Web.Display.StudentLifecycleState.StartingSoon,
        MVTeaches.Web.Display.StudentLifecycleState.PaymentDue,
        MVTeaches.Web.Display.StudentLifecycleState.EndingSoon,
        MVTeaches.Web.Display.StudentLifecycleState.Completed,
        MVTeaches.Web.Display.StudentLifecycleState.Inactive,
    })
    {
        <a class="app-state-chip is-@state.ToString().ToLowerInvariant()" asp-page="/Admin/Students" asp-route-state="@state">
            @T["StudentLifecycleState." + state] <span>@Model.StudentStates.GetValueOrDefault(state)</span>
        </a>
    }
</div>
@if (Model.StudentsNeedingAttention > 0)
{
    <div class="alert alert-warning" role="status">
        <strong>@T["{0} student(s) need attention.", Model.StudentsNeedingAttention]</strong>
        @T["Either their money is not settled, or what is left will not cover the lesson they are already booked into."]
        <a class="btn btn-sm btn-outline-secondary ms-2" asp-page="/Admin/Students" asp-route-state="PaymentDue">@T["Open the register"]</a>
    </div>
}

<h2 class="h4">@T["Waiting for you"] @if (Model.TotalWaiting > 0) { <span class="app-status is-warning">@Model.TotalWaiting</span> }</h2>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 mb-4">
    <div class="col">
        <a class="app-kpi @(Model.PaymentsAwaitingConfirmation > 0 ? "is-attention" : "")" asp-page="/Admin/Payments">
            <span class="app-kpi-label">@T["Payments awaiting confirmation"]</span>
            <span class="app-kpi-value">@Model.PaymentsAwaitingConfirmation</span>
            <span class="app-kpi-hint">@T["Confirm the money actually arrived, then the package activates."]</span>
        </a>
    </div>
    <div class="col">
        @* Owner report 2026-09-05: this counted the drafts but sent the admin to
           the unfiltered payments screen, so the number named a problem and then
           refused to say whose. It now opens the register filtered to exactly
           the students it counted, where each row carries the child's name, the
           guardian, the package and what is still owed. *@
        <a class="app-kpi @(Model.PackagesAwaitingPayment > 0 ? "is-attention" : "")"
           asp-page="/Admin/Students" asp-route-state="PaymentDue">
            <span class="app-kpi-label">@T["Package requests awaiting payment"]</span>
            <span class="app-kpi-value">@Model.PackagesAwaitingPayment</span>
            <span class="app-kpi-hint">@T["Families have asked for these packages and not paid yet. Open the list to see who, and take the payment."]</span>
        </a>
    </div>
    <div class="col">
        <a class="app-kpi @(Model.ReplacementRequestsAwaitingReview > 0 ? "is-attention" : "")" asp-page="/Admin/CompensationRequests">
            <span class="app-kpi-label">@T["Replacement requests to review"]</span>
            <span class="app-kpi-value">@Model.ReplacementRequestsAwaitingReview</span>
            <span class="app-kpi-hint">@T["A student asked for a make-up lesson after a no-show."]</span>
        </a>
    </div>
    <div class="col">
        <a class="app-kpi @(Model.DeliveriesAwaitingVerification > 0 ? "is-attention" : "")" asp-page="/Admin/Payroll">
            <span class="app-kpi-label">@T["Teacher deliveries to verify"]</span>
            <span class="app-kpi-value">@Model.DeliveriesAwaitingVerification</span>
            <span class="app-kpi-hint">@T["A teacher declared a delivered session; a different admin must verify it."]</span>
        </a>
    </div>
    <div class="col">
        <a class="app-kpi @(Model.StudentsAwaitingVerification > 0 ? "is-attention" : "")" asp-page="/Admin/Students">
            <span class="app-kpi-label">@T["Students awaiting verification"]</span>
            <span class="app-kpi-value">@Model.StudentsAwaitingVerification</span>
            <span class="app-kpi-hint">@T["Registered but not yet marked verified."]</span>
        </a>
    </div>
    <div class="col">
        <a class="app-kpi @(Model.StudentsWithoutLevel > 0 ? "is-attention" : "")" asp-page="/Admin/Students">
            <span class="app-kpi-label">@T["Students with no level yet"]</span>
            <span class="app-kpi-value">@Model.StudentsWithoutLevel</span>
            <span class="app-kpi-hint">@T["No package can be purchased until a level is assigned."]</span>
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <h2 class="h4">@T["The week ahead"]</h2>
        <p class="text-muted small">@T["How many lessons are scheduled on each of the next seven days."]</p>
        <div class="card">
            <div class="card-body">
                @if (busiest == 0)
                {
                    <div class="app-empty">
                        <strong>@T["No lesson is scheduled this week."]</strong>
                        <span>@T["Either no weekly class is running, or its sessions have not been generated yet."]</span>
                        <span><a class="btn btn-sm btn-outline-primary mt-2" asp-page="/Admin/Schedules">@T["Open schedules"]</a></span>
                    </div>
                }
                else
                {
                    <div class="app-chart" role="img"
                         aria-label="@T["Lessons scheduled on each of the next seven days."]">
                        @foreach (var day in Model.WeekAhead)
                        {
                            <div class="app-chart-col @(day.SessionCount == 0 ? "is-empty" : "")">
                                <span class="app-chart-value">@day.SessionCount</span>
                                <span class="app-chart-bar" style="--mv-bar: @(((double)day.SessionCount / busiest).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"></span>
                            </div>
                        }
                    </div>
                    <div class="app-chart-axis">
                        @foreach (var day in Model.WeekAhead)
                        {
                            <span>@T.ShortDay(day.Day)</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <h2 class="h4">@T["Next lessons"]</h2>
        <p class="text-muted small">@T["The ones starting soonest, with how many seats are taken."]</p>
        <div class="app-feed">
            @foreach (var s in Model.UpcomingSessions)
            {
                <div class="app-feed-item">
                    <span class="app-feed-when">@T.SessionMoment(s.StartsAtUtc, s.TimeZoneId)</span>
                    <span class="app-feed-what">@s.TeacherName · @s.LevelCode</span>
                    @* Same wording as /Admin/Schedules: the number is the number
                       of students in the lesson, and the count on the button is
                       read from the very same roster the modal shows. *@
                    <span class="app-feed-meta">
                        @{ var enrolled = Model.Rosters.TryGetValue(s.Id, out var roster) ? roster.Students.Count : 0; }
                        @T["Enrolled / seats"]: <strong>@enrolled</strong> / @s.Capacity
                        @if (s.SeatsTaken >= s.Capacity)
                        {
                            <span class="app-status is-warning">@T["Full"]</span>
                        }
                        @if (enrolled > 0)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal" data-bs-target="#roster-@s.Id">
                                @T["See the students"]
                                <span class="app-tab-count">@enrolled</span>
                            </button>
                        }
                        else
                        {
                            <span class="text-muted small">@T["Nobody is enrolled yet"]</span>
                        }
                    </span>
                </div>
            }
            @if (Model.UpcomingSessions.Count == 0)
            {
                <div class="app-empty">
                    <strong>@T["Nothing is coming up."]</strong>
                    <span>@T["No lesson is scheduled in the next seven days."]</span>
                </div>
            }
        </div>
    </div>
</div>

<h2 class="h4">@T["The school right now"]</h2>
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
    <div class="col">
        <a class="app-kpi" asp-page="/Admin/Students">
            <span class="app-kpi-label">@T["Active students"]</span>
            <span class="app-kpi-value">@Model.ActiveStudents</span>
            <span class="app-kpi-hint">@T["Verified, with a level assigned."]</span>
        </a>
    </div>
    <div class="col">
        <a class="app-kpi" asp-page="/Admin/Teachers">
            <span class="app-kpi-label">@T["Active teachers"]</span>
            <span class="app-kpi-value">@Model.ActiveTeachers</span>
            <span class="app-kpi-hint">@T["Available to be scheduled."]</span>
        </a>
    </div>
    <div class="col">
        <a class="app-kpi" asp-page="/Admin/Schedules">
            <span class="app-kpi-label">@T["Sessions today"]</span>
            <span class="app-kpi-value">@Model.SessionsToday</span>
            <span class="app-kpi-hint">@T["Counted over the UTC calendar day."]</span>
        </a>
    </div>
    <div class="col">
        <a class="app-kpi" asp-page="/Admin/Payroll">
            <span class="app-kpi-label">@T["Open payroll periods"]</span>
            <span class="app-kpi-value">@Model.OpenPayrollPeriods</span>
            <span class="app-kpi-hint">@T["Still accepting verified deliveries."]</span>
        </a>
    </div>
    <div class="col">
        <a class="app-kpi @(Model.UnresolvedScheduleConflicts > 0 ? "is-attention" : "")" asp-page="/Admin/Schedules">
            <span class="app-kpi-label">@T["Unresolved schedule conflicts"]</span>
            <span class="app-kpi-value">@Model.UnresolvedScheduleConflicts</span>
            <span class="app-kpi-hint">@T["A teacher-overlap or time-off collision the schedule generator could not resolve on its own."]</span>
        </a>
    </div>
    <div class="col">
        <a class="app-kpi" asp-page="/Admin/FinancialReport">
            <span class="app-kpi-label">@T["Financial Report"]</span>
            <span class="app-kpi-value">@T["Open"]</span>
            <span class="app-kpi-hint">@T["Confirmed income, expenses, and payroll for a period."]</span>
        </a>
    </div>
</div>

<partial name="_SessionRosterModals" model="Model.Rosters" />
