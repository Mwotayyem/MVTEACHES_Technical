@page
@model MVTeaches.Web.Pages.Admin.AssistedRegistrationModel
@using MVTeaches.Domain.Catalog
@using MVTeaches.Domain.Payments
@using MVTeaches.Domain.People
@{
    ViewData["Title"] = T["Assisted Registration"].Value;
    var step = Model.CurrentStep;
    var hasStudent = Model.SelectedStudentId is not null;

    string StepClass(int index)
    {
        if (!hasStudent)
        {
            return index == 1 ? "is-current" : string.Empty;
        }
        if (index < step) { return "is-done"; }
        return index == step ? "is-current" : string.Empty;
    }
}

<nav class="app-crumbs" aria-label="@T["Breadcrumb"]">
    <a asp-page="/Admin/Dashboard">@T["Dashboard"]</a>
    <span class="app-crumb-sep" aria-hidden="true">/</span>
    <a asp-page="/Admin/Students">@T["Students"]</a>
    <span class="app-crumb-sep" aria-hidden="true">/</span>
    <span>@T["Assisted Registration"]</span>
</nav>

<div class="app-page-head">
    <div>
        <h1>@T["Register a family, step by step"]</h1>
        <p class="text-muted">@T["For the parent who phones the centre and cannot do the steps online. Work down the five steps in order — each one only opens what the previous one made possible."]</p>
    </div>
    <div class="app-page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Students">@T["All students"]</a>
        @if (hasStudent)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/StudentDetails" asp-route-id="@Model.SelectedStudentId">@T["Open file"]</a>
            <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/AssistedRegistration">@T["Start a new family"]</a>
        }
    </div>
</div>

<ol class="app-steps">
    <li class="@StepClass(1)"><span class="app-step-label">@T["The guardian"]<span class="app-step-hint">@T["Find them, or create the account"]</span></span></li>
    <li class="@StepClass(2)"><span class="app-step-label">@T["The student"]<span class="app-step-hint">@T["Find them, or register the child"]</span></span></li>
    <li class="@StepClass(3)"><span class="app-step-label">@T["The link"]<span class="app-step-hint">@T["Who is responsible for whom"]</span></span></li>
    <li class="@StepClass(4)"><span class="app-step-label">@T["The level"]<span class="app-step-hint">@T["From the student's own test"]</span></span></li>
    <li class="@StepClass(5)"><span class="app-step-label">@T["Package and payment"]<span class="app-step-hint">@T["Choose it, then record the transfer"]</span></span></li>
</ol>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert" tabindex="-1">
        <strong>@T["Some fields still need attention"]</strong>
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

@if (hasStudent)
{
    <dl class="app-summary">
        <div>
            <dt>@T["Working on"]</dt>
            <dd>@Model.SelectedStudentName</dd>
        </div>
        <div>
            <dt>@T["Guardians"]</dt>
            <dd>@(Model.SelectedStudentGuardianNames.Count > 0 ? string.Join("، ", Model.SelectedStudentGuardianNames) : T["Not linked yet"].Value)</dd>
        </div>
        <div>
            <dt>@T["Level"]</dt>
            <dd>@(Model.SelectedStudentLevelCode ?? T["Awaiting the test"].Value)</dd>
        </div>
    </dl>
}

@* ---------------------------------------------------------------- step 1 *@
<section class="app-step-panel @(hasStudent ? "is-done" : string.Empty)">
    <h2><span class="app-step-badge">1</span>@T["Find the family before creating anything"]</h2>
    <p class="app-step-lead">@T["Search by name or email first. Creating a second account for a family that already exists is the one mistake that is painful to undo later."]</p>
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="q">@T["Name or email"]</label>
            <input id="q" name="q" value="@Model.Search.Query" class="form-control" placeholder="@T["Part of a name is enough"]" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary">@T["Search"]</button>
        </div>
    </form>

    @if (Model.GuardianResults.Count > 0 || Model.StudentResults.Count > 0)
    {
        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <h3 class="h6">@T["Guardians found"]</h3>
                <ul class="list-group">
                    @foreach (var g in Model.GuardianResults)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <span>@g.FullName @(g.Email is not null ? $"({g.Email})" : string.Empty)</span>
                            <span class="app-status is-success">@T["Already registered"]</span>
                        </li>
                    }
                    @if (Model.GuardianResults.Count == 0)
                    {
                        <li class="list-group-item text-muted">@T["No guardian matches — create one in step 2."]</li>
                    }
                </ul>
            </div>
            <div class="col-md-6">
                <h3 class="h6">@T["Students found"]</h3>
                <ul class="list-group">
                    @foreach (var st in Model.StudentResults)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <a asp-page="/Admin/AssistedRegistration" asp-route-studentId="@st.Id">@st.FullName</a>
                            <span class="app-status is-info">@T["StudentStatus." + st.Status]</span>
                        </li>
                    }
                    @if (Model.StudentResults.Count == 0)
                    {
                        <li class="list-group-item text-muted">@T["No student matches — register one in step 2."]</li>
                    }
                </ul>
            </div>
        </div>
        <div class="app-outcome mt-3">@T["Pick the student's name above to carry on with the rest of the steps for them."]</div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.Search.Query))
    {
        <div class="app-empty mt-3">
            <strong>@T["Nobody matches that search."]</strong>
            <span>@T["This family is new — create the guardian and the student in step 2 below."]</span>
        </div>
    }
</section>

@* ---------------------------------------------------------------- step 2 *@
<section class="app-step-panel @(hasStudent ? "is-done" : string.Empty)">
    <h2><span class="app-step-badge">2</span>@T["Create whoever is missing"]</h2>
    <p class="app-step-lead">@T["The guardian gets a real sign-in. The child normally does not — they are reached through their guardian's account."]</p>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title h6">@T["New guardian"]</h3>
                    <form method="post" asp-page-handler="RegisterGuardian" class="row g-2">
                        <div class="col-12">
                            <label class="form-label" asp-for="NewGuardian.FullName">@T["Full name"]<span class="app-required">*</span></label>
                            <input asp-for="NewGuardian.FullName" class="form-control" autocomplete="off" />
                            <span asp-validation-for="NewGuardian.FullName" class="text-danger small"></span>
                        </div>
                        @* Owner decision 2026-09-04: the guardian is the person the
                           centre phones about this family — no guardian account is
                           created without one. Stored on their own Identity user
                           (AspNetUsers.PhoneNumber), so no schema change. *@
                        <div class="col-12">
                            <label class="form-label" asp-for="NewGuardian.PhoneNumber">@T["Phone number"]<span class="app-required">*</span></label>
                            <input asp-for="NewGuardian.PhoneNumber" type="tel" class="form-control" autocomplete="off" />
                            <div class="form-text">@T["The number the centre calls about this family. Include the country code."]</div>
                            <span asp-validation-for="NewGuardian.PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label" asp-for="NewGuardian.Email">@T["Email address"]<span class="app-required">*</span></label>
                            <input asp-for="NewGuardian.Email" class="form-control" autocomplete="off" />
                            <span asp-validation-for="NewGuardian.Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label" asp-for="NewGuardian.Password">@T["Temporary password"]<span class="app-required">*</span></label>
                            <input asp-for="NewGuardian.Password" type="password" class="form-control" autocomplete="new-password" />
                            <div class="form-text">@T["At least 8 characters. Read it out on the call; they change it after signing in."]</div>
                            <span asp-validation-for="NewGuardian.Password" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">@T["Create the guardian"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h3 class="card-title h6">@T["New student"]</h3>
                    <p class="text-muted small">@T["No sign-in is created here: this child uses their guardian's account. An older student who really will sign in alone can be given one later from the students screen."]</p>
                    <form method="post" asp-page-handler="RegisterStudent" class="row g-2">
                        <div class="col-12">
                            <label class="form-label" asp-for="NewStudent.FullName">@T["Full name"]<span class="app-required">*</span></label>
                            <input asp-for="NewStudent.FullName" class="form-control" autocomplete="off" />
                            <span asp-validation-for="NewStudent.FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="NewStudent.CountryId">@T["Country"]<span class="app-required">*</span></label>
                            <select asp-for="NewStudent.CountryId" class="form-select">
                                <option value="">@T["Select placeholder"]</option>
                                @foreach (var country in Model.Countries)
                                {
                                    <option value="@country.Id">@(Model.IsArabic ? country.NameAr : country.NameEn)</option>
                                }
                            </select>
                            <span asp-validation-for="NewStudent.CountryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="NewStudent.DateOfBirth">@T["Date of birth"]<span class="app-required">*</span></label>
                            <input asp-for="NewStudent.DateOfBirth" type="date" class="form-control" />
                            <div class="form-text">@T["Used to pick the right age group for sessions."]</div>
                            <span asp-validation-for="NewStudent.DateOfBirth" class="text-danger small"></span>
                        </div>
                        @* Owner decision 2026-09-04: optional here - this form
                           registers a child whose reachable number is their
                           guardian's. Stored on the Student row when given. *@
                        <div class="col-12">
                            <label class="form-label" asp-for="NewStudent.PhoneNumber">@T["Phone number (optional for a child under a guardian)"]</label>
                            <input asp-for="NewStudent.PhoneNumber" type="tel" class="form-control" autocomplete="off" />
                            <span asp-validation-for="NewStudent.PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">@T["Register the student"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@* ---------------------------------------------------------------- step 3 *@
<section class="app-step-panel @(Model.SelectedStudentHasGuardian ? "is-done" : hasStudent ? string.Empty : "is-waiting")">
    <h2><span class="app-step-badge">3</span>@T["Link the guardian to the student"]</h2>
    <p class="app-step-lead">@T["Until they are linked, the guardian cannot see this child or pay for them."]</p>
    @if (!hasStudent)
    {
        <div class="app-empty">
            <strong>@T["Pick a student first."]</strong>
            <span>@T["Search for them in step 1, or register them in step 2."]</span>
        </div>
    }
    else
    {
        <form method="post" asp-page-handler="Link" class="row g-3">
            <div class="col-md-4">
                <label class="form-label" asp-for="Link.GuardianId">@T["Guardian"]<span class="app-required">*</span></label>
                <input type="search" class="form-control mb-1" data-mv-select-filter="#linkGuardianPicker"
                       placeholder="@T["Search by name…"]" aria-label="@T["Search by name…"]" />
                <select asp-for="Link.GuardianId" id="linkGuardianPicker" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var g in Model.AllGuardians)
                    {
                        <option value="@g.Id">@g.FullName</option>
                    }
                </select>
                <span asp-validation-for="Link.GuardianId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Link.StudentId">@T["Student"]<span class="app-required">*</span></label>
                <input type="search" class="form-control mb-1" data-mv-select-filter="#linkStudentPicker"
                       placeholder="@T["Search by name…"]" aria-label="@T["Search by name…"]" />
                <select asp-for="Link.StudentId" id="linkStudentPicker" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var st in Model.AllStudents)
                    {
                        <option value="@st.Id">@st.FullName</option>
                    }
                </select>
                <span asp-validation-for="Link.StudentId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Link.Relationship">@T["Relationship"]</label>
                <select asp-for="Link.Relationship" class="form-select">
                    <option value="@GuardianRelationship.Parent">@T["GuardianRelationship.Parent"]</option>
                    <option value="@GuardianRelationship.LegalGuardian">@T["GuardianRelationship.LegalGuardian"]</option>
                    <option value="@GuardianRelationship.Other">@T["GuardianRelationship.Other"]</option>
                </select>
            </div>
            <div class="col-12">
                <div class="form-check mb-2">
                    <input asp-for="Link.IsPrimary" class="form-check-input" />
                    <label class="form-check-label" asp-for="Link.IsPrimary">@T["This is the main guardian"]</label>
                </div>
                <button type="submit" class="btn btn-primary">@T["Link them"]</button>
            </div>
        </form>
    }
</section>

@* ---------------------------------------------------------------- step 4 *@
<section class="app-step-panel @(Model.SelectedStudentHasLevel ? "is-done" : hasStudent ? string.Empty : "is-waiting")">
    <h2><span class="app-step-badge">4</span>@T["The student's own placement test"]</h2>
    <p class="app-step-lead">@T["The level decides which packages exist for this student. It comes from the test the student sits themselves — an admin cannot sit it for them."]</p>
    @if (!hasStudent)
    {
        <div class="app-empty">
            <strong>@T["Pick a student first."]</strong>
            <span>@T["A level belongs to one specific student."]</span>
        </div>
    }
    else if (!Model.SelectedStudentHasLevel)
    {
        <div class="alert alert-info mb-0">
            <p class="mb-2">@T["No placement result yet. Send the family to the test — the guardian opens it from their own account, on their own device."]</p>
            <a asp-page="/PlacementTest" asp-route-studentId="@Model.SelectedStudentId" class="btn btn-sm btn-outline-primary">@T["Open the placement test"]</a>
            <div class="mt-3 text-muted small">@T["If the level has to be set by hand instead — a transfer from another centre, for example — that is a recorded override on the students screen."]</div>
            <a class="btn btn-sm btn-outline-secondary mt-2" asp-page="/Admin/Students" asp-route-studentId="@Model.SelectedStudentId" asp-fragment="assign-level">@T["Set the level by hand"]</a>
        </div>
    }
    else
    {
        <p class="mb-0">@T["Current level"]: <strong>@Model.SelectedStudentLevelCode</strong> <span class="app-status is-success">@T["Ready to buy a package"]</span></p>
    }
</section>

@* ---------------------------------------------------------------- step 5 *@
<section class="app-step-panel @(hasStudent && Model.SelectedStudentHasLevel ? string.Empty : "is-waiting")">
    <h2><span class="app-step-badge">5</span>@T["Choose the package, then record the transfer"]</h2>
    <p class="app-step-lead">@T["Only packages published for this student's own level appear. Choosing one creates an unpaid request; the package activates only once the money is confirmed as received."]</p>

    @if (!hasStudent || !Model.SelectedStudentHasLevel)
    {
        <div class="app-empty">
            <strong>@T["Not yet."]</strong>
            <span>@T["A package can only be chosen once the student has a level."]</span>
        </div>
    }
    else if (!Model.CanPurchasePackages && !Model.CanRecordPayments)
    {
        @* Security review 2026-09-04: this whole step is money, and money needs
           the money keys. The three handlers behind it refuse the POST
           regardless - this only saves an admin from filling in a form that
           was always going to be refused. *@
        <div class="app-empty">
            <strong>@T["This step needs a different permission."]</strong>
            <span>@T["Choosing a package needs the packages permission, and recording a transfer needs the payments one. Everything above is done — ask a system administrator for those permissions, or hand this family to somebody who has them."]</span>
        </div>
    }
    else if (Model.EligiblePlans.Count == 0)
    {
        <div class="app-empty">
            <strong>@T["No package is published for this level yet."]</strong>
            <span>@T["Create one on the packages screen, then come back here."]</span>
            <span><a class="btn btn-sm btn-outline-primary mt-2" asp-page="/Admin/Subscriptions">@T["Open packages"]</a></span>
        </div>
    }
    else
    {
        <div class="row g-3 mb-3">
            @foreach (var plan in Model.EligiblePlans)
            {
                <div class="col-md-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h3 class="card-title h6">@plan.CourseName — @plan.LevelCode</h3>
                            <p class="card-text mb-3">
                                <span class="app-status is-info">@T["SessionType." + plan.SessionType]</span><br />
                                <span class="text-muted">@T["Sessions"]: <strong>@plan.SessionsCount</strong></span><br />
                                <span class="fs-5 fw-bold">@T.Money(plan.Amount, plan.Currency)</span>
                            </p>
                            <form method="post" asp-page-handler="Purchase" class="mt-auto">
                                <input type="hidden" name="Purchase.StudentId" value="@Model.SelectedStudentId" />
                                <input type="hidden" name="Purchase.PricingPlanId" value="@plan.Id" />
                                <button type="submit" class="btn btn-primary w-100"
                                        data-mv-confirm="@T["Create an unpaid package request for this student?"]">@T["Choose this package"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.SelectedStudentDraftSubscriptions.Count > 0)
    {
        <h3 class="h6">@T["Record what the family sent"]</h3>
        <p class="text-muted small">@T["Recording a transfer does not activate anything on its own — an admin still confirms on the payments screen that the money really arrived."]</p>
        @foreach (var d in Model.SelectedStudentDraftSubscriptions)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h4 class="card-title h6">@T["Unpaid package"] — @T.Money(d.Price, d.Currency)</h4>
                    <dl class="row small mb-2">
                        <dt class="col-sm-3">@T["Package price"]</dt>
                        <dd class="col-sm-9">@T.Money(d.Price, d.Currency)</dd>
                        @if (d.ConfirmedReceived > 0)
                        {
                            <dt class="col-sm-3">@T["Confirmed received"]</dt>
                            <dd class="col-sm-9">@T.Money(d.ConfirmedReceived, d.Currency)</dd>
                            <dt class="col-sm-3">@T["Remaining owed"]</dt>
                            <dd class="col-sm-9 fw-bold">@T.Money(d.RemainingOwed, d.Currency)</dd>
                        }
                    </dl>
                    @if (d.ConfirmedReceived > 0)
                    {
                        <div class="alert alert-warning small">@T["Your earlier transfer arrived short of the full price — this is normal after bank/transfer fees. Send the remaining amount below to activate the package."]</div>
                    }
                    <form method="post" asp-page-handler="RecordManualPayment" class="row g-2 align-items-end">
                        <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                        <input type="hidden" name="subscriptionId" value="@d.Id" />
                        <div class="col-md-2">
                            <label class="form-label small mb-0">@T["Amount"]</label>
                            <input type="number" step="0.001" name="amount" value="@d.RemainingOwed.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small mb-0">@T["Currency"]</label>
                            @* Deliberately left editable: an international transfer can
                               genuinely arrive in a different currency, so locking this
                               would change what a payment can record — a business
                               change, not a display one. *@
                            <input type="text" name="currency" value="@d.Currency" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-0">@T["How did they pay?"]</label>
                            <select name="method" class="form-select form-select-sm">
                                @foreach (var v in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@v">@T["PaymentMethod." + v]</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-0">@T["Which of our accounts received it? (optional)"]</label>
                            <select name="paymentMethodConfigId" class="form-select form-select-sm">
                                <option value="">@T["Not specified"]</option>
                                @foreach (var m in Model.ActiveMethods)
                                {
                                    <option value="@m.Id">@T["PaymentMethod." + m.Type] — @m.BeneficiaryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-sm">@T["Record the payment"]</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }

    @if (Model.StudentPayments.Count > 0)
    {
        <h3 class="h6">@T["Payments on this student"]</h3>
        <div class="table-responsive mb-3">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>@T["Reference"]</th>
                        <th>@T["Amount"]</th>
                        <th>@T["Method type"]</th>
                        <th>@T["Status"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.StudentPayments)
                    {
                        <tr>
                            <td><span class="app-ref">@p.ReferenceCode</span></td>
                            <td>
                                @T.Money(p.Amount, p.Currency)
                                @if (p.Status == PaymentStatus.Confirmed && p.ReceivedAmount is not null && p.ReceivedCurrency == p.Currency && p.ReceivedAmount < p.Amount)
                                {
                                    <br /><span class="app-status is-warning">@T["Remaining owed"]: @T.Money(p.Amount - p.ReceivedAmount.Value, p.Currency)</span>
                                }
                            </td>
                            <td>@T["PaymentMethod." + p.Method]</td>
                            <td>
                                @if (p.Status == PaymentStatus.Pending && !p.HasSubmittedTransferDetails)
                                {
                                    <span class="app-status is-warning">@T["Awaiting transfer"]</span>
                                }
                                else if (p.Status == PaymentStatus.Pending)
                                {
                                    <span class="app-status is-info">@T["Under review"]</span>
                                }
                                else
                                {
                                    <span class="app-status is-muted">@T["PaymentStatus." + p.Status]</span>
                                }
                            </td>
                            <td>
                                @if (p.Status == PaymentStatus.Pending)
                                {
                                    <a href="#transfer-@p.Id" class="btn btn-sm btn-outline-primary">@T["Enter transfer details"]</a>
                                }
                            </td>
                        </tr>
                        @if (p.Status == PaymentStatus.Pending)
                        {
                            <tr id="transfer-@p.Id">
                                <td colspan="5">
                                    <div class="alert alert-info small">@T["The full package price must arrive at the centre's account after any transfer fees are deducted. If a smaller amount arrives, the remaining difference must be sent before the package can activate."]</div>
                                    <form method="post" asp-page-handler="SubmitTransfer" enctype="multipart/form-data" class="row g-2">
                                        <input type="hidden" name="Transfer.PaymentId" value="@p.Id" />
                                        <div class="col-md-3">
                                            <label class="form-label">@T["Which of our accounts received it?"]</label>
                                            <select name="Transfer.PaymentMethodConfigId" class="form-select">
                                                <option value="">@T["Not specified"]</option>
                                                @foreach (var m in Model.ActiveMethods)
                                                {
                                                    <option value="@m.Id">@T["PaymentMethod." + m.Type] — @m.BeneficiaryName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">@T["Payer name"]</label>
                                            <input name="Transfer.PayerDisplayName" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">@T["Transfer date"]</label>
                                            <input name="Transfer.TransferDate" type="date" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">@T["Bank reference number"]</label>
                                            <input name="Transfer.BankReferenceNumber" class="form-control" />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label">@T["Receipt"]</label>
                                            <input name="Transfer.Receipt" type="file" accept="image/jpeg,image/png,application/pdf" class="form-control" />
                                        </div>
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-primary btn-sm">@T["Submit transfer details"]</button>
                                            <div class="app-outcome mt-2">@T["Next: an admin confirms on the payments screen that the money arrived, and only then does the package activate."]</div>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Payments" asp-route-studentId="@Model.SelectedStudentId">@T["Open payments for this student"]</a>
    }
</section>
