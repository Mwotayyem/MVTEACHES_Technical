@page
@model MVTeaches.Web.Pages.Admin.MakeUpCreditsModel
@{
    ViewData["Title"] = "Makeup Credits";
}

<h1>Makeup credits</h1>
<p class="text-muted">
    D-19/D-20: most missed sessions are handled by cancelling with a direct replacement on
    <a asp-page="/Admin/Schedules">/Admin/Schedules</a> — the substitute session's own Join is the one deduction, no separate credit needed.
    This page is for the one case the Technical Study reserves for the admin's own judgment (§17.4): a student already
    pressed Join and the session then failed for reasons outside their control.
</p>
<p class="text-muted small">
    ⚠️ Known limitation, not silently resolved: a credit granted here is an accurate record and appears on the queue
    below, but is not yet spendable through Join — the Technical Study's own CONF-04 (whether a makeup credit's
    validity is independent of any subscription or must attach to one) is explicitly marked as a business decision
    for the owner, not a technical one. See docs/deployment/STATUS.md.
</p>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Grant a makeup credit</h5>
        <p class="text-muted small">D-63: you set the deadline per case — there is no fixed system default. The current suggested starting point is @Model.DefaultExpiryDays days, offered here only, never enforced.</p>
        <form method="post" asp-page-handler="Grant" class="row g-2">
            <div class="col-md-3">
                <label class="form-label" asp-for="Grant.StudentId">Student</label>
                <select asp-for="Grant.StudentId" class="form-select">
                    <option value="">-- select --</option>
                    @foreach (var s in Model.Students)
                    {
                        <option value="@s.Id">@s.FullName (#@s.Id)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="Grant.CourseId">Course</label>
                <select asp-for="Grant.CourseId" class="form-select">
                    <option value="">-- select --</option>
                    @foreach (var c in Model.Courses)
                    {
                        <option value="@c.Id">@c.NameEn</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" asp-for="Grant.LevelId">Level</label>
                <select asp-for="Grant.LevelId" class="form-select">
                    <option value="">-- select --</option>
                    @foreach (var l in Model.Levels)
                    {
                        <option value="@l.Id">@l.Code</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" asp-for="Grant.Minutes">Minutes</label>
                <input asp-for="Grant.Minutes" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label" asp-for="Grant.ExpiresOn">Deadline</label>
                <input asp-for="Grant.ExpiresOn" type="date" class="form-control" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Grant credit</button>
            </div>
        </form>
    </div>
</div>

<h2>Awaiting makeup (D-66) — soonest deadline first</h2>
<div class="table-responsive">
    <table class="table table-sm table-striped">
        <thead><tr><th>Student</th><th>Course</th><th>Level</th><th>Minutes</th><th>Deadline</th><th>Granted</th></tr></thead>
        <tbody>
            @foreach (var q in Model.Queue)
            {
                <tr>
                    <td>@q.StudentFullName (#@q.StudentId)</td>
                    <td>#@q.CourseId</td>
                    <td>#@q.LevelId</td>
                    <td>@q.Minutes</td>
                    <td>@q.ExpiresOn</td>
                    <td>@q.GrantedAtUtc</td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Queue.Count == 0)
    {
        <p class="text-muted">No students currently awaiting a makeup.</p>
    }
</div>
