@page
@model MVTeaches.Web.Pages.Admin.CompensationRequestsModel
@{
    ViewData["Title"] = "Compensation Requests";
}

<h1>Compensation requests</h1>
<p class="text-muted">Student-submitted requests for a missed (no-show) session. Approving links exactly one specific future session — the original absence and its consumption are never touched.</p>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<h2 class="h4">Pending</h2>
<div class="table-responsive mb-4">
    <table class="table table-sm table-striped">
        <thead><tr><th>Student</th><th>Level</th><th>Missed session</th><th>Reason</th><th>Requested</th><th>Approve</th><th>Reject</th></tr></thead>
        <tbody>
            @foreach (var r in Model.PendingRequests)
            {
                <tr>
                    <td>@r.StudentName</td>
                    <td>@r.LevelCode</td>
                    <td>#@r.OriginalSessionId — @r.OriginalSessionStartsAtUtc</td>
                    <td>@(r.Reason ?? "—")</td>
                    <td>@r.RequestedAtUtc</td>
                    <td>
                        <form method="post" asp-page-handler="Approve" class="d-flex gap-1">
                            <input type="hidden" name="requestId" value="@r.RequestId" />
                            <select name="replacementSessionId" class="form-select form-select-sm">
                                <option value="">-- select --</option>
                                @foreach (var opt in r.CandidateReplacementSessions)
                                {
                                    <option value="@opt.Id">@opt.Label</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary">Approve</button>
                        </form>
                    </td>
                    <td>
                        <form method="post" asp-page-handler="Reject">
                            <input type="hidden" name="requestId" value="@r.RequestId" />
                            <input type="text" name="RejectReason" class="form-control form-control-sm mb-1" placeholder="Reason" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.PendingRequests.Count == 0)
    {
        <p class="text-muted">No pending requests.</p>
    }
</div>

<h2 class="h4">Recently resolved</h2>
<div class="table-responsive">
    <table class="table table-sm table-striped">
        <thead><tr><th>Student</th><th>Outcome</th><th>Replacement / reason</th></tr></thead>
        <tbody>
            @foreach (var r in Model.RecentlyResolved)
            {
                <tr>
                    <td>@r.StudentName</td>
                    <td>@r.Status</td>
                    <td>
                        @if (r.Status == MVTeaches.Domain.Scheduling.CompensationRequestStatus.Approved)
                        {
                            @r.ReplacementStartsAtUtc
                        }
                        else
                        {
                            @r.RejectionReason
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.RecentlyResolved.Count == 0)
    {
        <p class="text-muted">Nothing resolved yet.</p>
    }
</div>
