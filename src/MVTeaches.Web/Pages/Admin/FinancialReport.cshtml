@page
@model MVTeaches.Web.Pages.Admin.FinancialReportModel
@using Microsoft.AspNetCore.Authorization
@using MVTeaches.Infrastructure.Identity
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = T["Financial Report"].Value;
    var canManage = (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.FinancialReportManage)).Succeeded;
}

<nav class="app-crumbs" aria-label="@T["Breadcrumb"]">
    <a asp-page="/Admin/Dashboard">@T["Dashboard"]</a>
    <span class="app-crumb-sep" aria-hidden="true">/</span>
    <span>@T["Financial Report"]</span>
</nav>

<div class="app-page-head">
    <div>
        <h1>@T["Financial Report"]</h1>
        <p class="text-muted">@T["What came in, what went out, and what is left — for whatever dates you choose."]</p>
    </div>
    <div class="app-page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Payments">@T["Payments"]</a>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Payroll">@T["Payroll"]</a>
    </div>
</div>

<div class="app-guide">
    <p class="app-guide-title">@T["How to read this"]</p>
    <ul>
        <li>@T["Money in counts a payment on the day it was confirmed as received, not the day it was requested."]</li>
        <li>@T["Teacher pay is taken from the payroll lines automatically — never type it in as an expense."]</li>
        <li>@T["Every other running cost — rent, marketing, tools — is entered by hand at the bottom of this page."]</li>
    </ul>
</div>

<form method="get" class="row row-cols-lg-auto g-3 align-items-center mb-4">
    <div class="col-12">
        <label class="visually-hidden" asp-for="From">@T["From"]</label>
        <div class="input-group">
            <div class="input-group-text">@T["From"]</div>
            <input asp-for="From" type="date" class="form-control" />
        </div>
    </div>
    <div class="col-12">
        <label class="visually-hidden" asp-for="To">@T["To"]</label>
        <div class="input-group">
            <div class="input-group-text">@T["To"]</div>
            <input asp-for="To" type="date" class="form-control" />
        </div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">@T["Run"]</button>
    </div>
</form>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (Model.Report is { } report)
{
    <p class="text-muted">@T["{0} to {1} — cash-basis (confirmed payments by confirmation date), live from the database, nothing cached.", T.Date(report.PeriodStart), T.Date(report.PeriodEnd)]</p>

    <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@T["Revenue (confirmed payments)"]</h5>
                    @if (report.RevenueByCurrency.Count == 0)
                    {
                        <p class="card-text text-muted">@T["No confirmed payments in this range."]</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var line in report.RevenueByCurrency)
                            {
                                <li>@T.Money(line.Amount, line.Currency)</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@T["Payroll cost"]</h5>
                    @if (report.PayrollCostByCurrency.Count == 0)
                    {
                        <p class="card-text text-muted">@T["No payroll lines in this range."]</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var line in report.PayrollCostByCurrency)
                            {
                                <li>@T.Money(line.Amount, line.Currency)</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
        <div class="col">
            <div class="card @(report.PaymentBlockedStudents > 0 ? "border-warning" : "")">
                <div class="card-body">
                    <h5 class="card-title">@T["Students payment-blocked right now"]</h5>
                    <p class="card-text display-6">@report.PaymentBlockedStudents</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@T["Payments awaiting confirmation"]</h5>
                    <p class="card-text display-6">@report.PendingPayments</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@T["Scheduled teaching hours"]</h5>
                    <p class="card-text display-6">@((report.ScheduledTeachingMinutes / 60.0).ToString("N1", System.Globalization.CultureInfo.InvariantCulture))</p>
                    <p class="card-text text-muted small">@T["{0} minutes across every non-cancelled session scheduled in this range.", report.ScheduledTeachingMinutes]</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@T["Net profit (revenue − payroll − expenses)"]</h5>
                    @if (report.NetProfitByCurrency.Count == 0)
                    {
                        <p class="card-text text-muted">@T["Nothing to report in this range."]</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var line in report.NetProfitByCurrency)
                            {
                                <li class="@(line.Amount < 0 ? "text-danger" : "")">@T.Money(line.Amount, line.Currency)</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.PreviousPeriodReport is { } previous)
    {
        <h2>@T["Month-over-month comparison"]</h2>
        <p class="text-muted small">@T["Compared against the immediately preceding period of the same length ({0} to {1}).", T.Date(previous.PeriodStart), T.Date(previous.PeriodEnd)]</p>
        <div class="table-responsive mb-4">
            <table class="table table-sm table-striped">
                <thead><tr><th>@T["Currency"]</th><th>@T["Revenue (this period)"]</th><th>@T["Revenue (previous)"]</th><th>@T["Net profit (this period)"]</th><th>@T["Net profit (previous)"]</th></tr></thead>
                <tbody>
                    @{
                        var currencies = report.RevenueByCurrency.Select(c => c.Currency)
                            .Concat(report.NetProfitByCurrency.Select(c => c.Currency))
                            .Concat(previous.RevenueByCurrency.Select(c => c.Currency))
                            .Concat(previous.NetProfitByCurrency.Select(c => c.Currency))
                            .Distinct();
                    }
                    @foreach (var currency in currencies)
                    {
                        <tr>
                            <td>@currency</td>
                            <td>@T.Money(report.RevenueByCurrency.FirstOrDefault(c => c.Currency == currency)?.Amount ?? 0m, currency)</td>
                            <td>@T.Money(previous.RevenueByCurrency.FirstOrDefault(c => c.Currency == currency)?.Amount ?? 0m, currency)</td>
                            <td>@T.Money(report.NetProfitByCurrency.FirstOrDefault(c => c.Currency == currency)?.Amount ?? 0m, currency)</td>
                            <td>@T.Money(previous.NetProfitByCurrency.FirstOrDefault(c => c.Currency == currency)?.Amount ?? 0m, currency)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @*
        Owner decision 2026-09-04 (Payroll-simplification, Review Required):
        a plain read-only reading of what each teacher is actually owed —
        delivered hours × the applicable rate — with no PayrollPeriod,
        PayrollLine, or SessionDelivery involved at all. See
        FinancialReportModel.LoadTeacherDuesAsync for exactly what counts as
        "delivered" and how the rate is found. Disbursement itself still
        happens by hand, outside the system — this table only calculates
        and displays.
    *@
    <h2>@T["Teacher dues — read only"]</h2>
    <p class="text-muted small">@T["Based only on lessons that already happened in this range (no payroll period needed). Actual pay is arranged outside the system."]</p>
    @if (Model.TeacherDues.Count == 0)
    {
        <p class="text-muted mb-4">@T["No completed lessons in this range yet."]</p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>@T["Teacher"]</th>
                        <th>@T["Lessons"]</th>
                        <th>@T["Hours delivered"]</th>
                        <th>@T["Amount due"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.TeacherDues)
                    {
                        <tr>
                            <td>@row.TeacherName</td>
                            <td>@row.SessionCount</td>
                            <td>@((row.DeliveredMinutes / 60.0).ToString("N1", System.Globalization.CultureInfo.InvariantCulture))</td>
                            <td>
                                @if (row.DueByCurrency.Count == 0)
                                {
                                    <span class="text-muted">@T["No rate configured"]</span>
                                }
                                else
                                {
                                    @foreach (var amount in row.DueByCurrency)
                                    {
                                        <div>@T.Money(amount.Amount, amount.Currency)</div>
                                    }
                                }
                                @if (row.SessionsMissingRate > 0)
                                {
                                    <div class="text-warning small">@T["{0} lesson(s) have no rate configured yet and are not included above.", row.SessionsMissingRate]</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@T["Record a running cost"]</h5>
            <p class="text-muted small">@T["Rent, marketing, subscriptions, anything the centre pays out that is not teacher pay. Teacher pay is already counted from payroll and is refused here."]</p>
            @if (Model.StatusMessage is not null)
            {
                <div class="alert alert-success">@Model.StatusMessage</div>
            }
            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            @if (canManage)
            {
                <form method="post" asp-page-handler="RecordExpense" class="row g-2">
                    <div class="col-md-2">
                        <label class="form-label" asp-for="NewExpense.CountryId">@T["Country"]<span class="app-required">*</span></label>
                        <select asp-for="NewExpense.CountryId" class="form-select">
                            <option value="">@T["Select placeholder"]</option>
                            @foreach (var country in Model.Countries)
                            {
                                <option value="@country.Id">@Model.DisplayCountry(country)</option>
                            }
                        </select>
                        <span asp-validation-for="NewExpense.CountryId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" asp-for="NewExpense.Category">@T["What was it for?"]<span class="app-required">*</span></label>
                        <input asp-for="NewExpense.Category" class="form-control" list="expenseCategories"
                               placeholder="@T["e.g. Rent, Marketing"]" autocomplete="off" />
                        <datalist id="expenseCategories">
                            @foreach (var category in Model.KnownCategories)
                            {
                                <option value="@category"></option>
                            }
                        </datalist>
                        <div class="form-text">@T["Reuse the same wording each month so the totals group together."]</div>
                        <span asp-validation-for="NewExpense.Category" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" asp-for="NewExpense.Amount">@T["Amount"]<span class="app-required">*</span></label>
                        <input asp-for="NewExpense.Amount" class="form-control" inputmode="decimal" />
                        <span asp-validation-for="NewExpense.Amount" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" asp-for="NewExpense.Currency">@T["Currency"]<span class="app-required">*</span></label>
                        <select asp-for="NewExpense.Currency" class="form-select">
                            @foreach (var code in Model.Currencies)
                            {
                                <option value="@code">@code</option>
                            }
                        </select>
                        <span asp-validation-for="NewExpense.Currency" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" asp-for="NewExpense.IncurredOn">@T["Date it was paid"]<span class="app-required">*</span></label>
                        <input asp-for="NewExpense.IncurredOn" type="date" class="form-control" />
                        <span asp-validation-for="NewExpense.IncurredOn" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" asp-for="NewExpense.Note">@T["Note (optional)"]</label>
                        <input asp-for="NewExpense.Note" class="form-control" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary">@T["Record it"]</button>
                    </div>
                    <div class="col-12">
                        <div class="app-outcome">@T["It is counted against the dates chosen at the top of this page, and comes off the profit figure."]</div>
                    </div>
                </form>
            }
            else
            {
                <p class="text-muted small mb-0">@T["View only"]</p>
            }
        </div>
    </div>

    <h2>@T["Running costs in these dates"]</h2>
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead><tr><th>@T["Date"]</th><th>@T["Category"]</th><th>@T["Amount"]</th><th>@T["Note"]</th></tr></thead>
            <tbody>
                @foreach (var e in Model.Expenses)
                {
                    <tr>
                        <td>@T.Date(e.IncurredOn)</td>
                        <td>@e.Category</td>
                        <td>@T.Money(e.Amount.Amount, e.Amount.Currency)</td>
                        <td>@e.Note</td>
                    </tr>
                }
                @if (Model.Expenses.Count == 0)
                {
                    <tr>
                        <td colspan="4">
                            <div class="app-empty">
                                <strong>@T["No running cost recorded in these dates."]</strong>
                                <span>@T["Teacher pay is not shown here — it is counted separately from payroll."]</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
