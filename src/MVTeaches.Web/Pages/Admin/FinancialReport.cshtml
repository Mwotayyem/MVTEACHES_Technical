@page
@model MVTeaches.Web.Pages.Admin.FinancialReportModel
@{
    ViewData["Title"] = "Financial Report";
}

<h1>Financial report</h1>

<form method="get" class="row row-cols-lg-auto g-3 align-items-center mb-4">
    <div class="col-12">
        <label class="visually-hidden" asp-for="From">From</label>
        <div class="input-group">
            <div class="input-group-text">From</div>
            <input asp-for="From" type="date" class="form-control" />
        </div>
    </div>
    <div class="col-12">
        <label class="visually-hidden" asp-for="To">To</label>
        <div class="input-group">
            <div class="input-group-text">To</div>
            <input asp-for="To" type="date" class="form-control" />
        </div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Run</button>
    </div>
</form>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (Model.Report is { } report)
{
    <p class="text-muted">@report.PeriodStart.ToString("yyyy-MM-dd", null) to @report.PeriodEnd.ToString("yyyy-MM-dd", null) — cash-basis (confirmed payments by confirmation date), live from the database, nothing cached.</p>

    <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Revenue (confirmed payments)</h5>
                    @if (report.RevenueByCurrency.Count == 0)
                    {
                        <p class="card-text text-muted">No confirmed payments in this range.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var line in report.RevenueByCurrency)
                            {
                                <li>@line.Amount.ToString("N3", null) @line.Currency</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Payroll cost</h5>
                    @if (report.PayrollCostByCurrency.Count == 0)
                    {
                        <p class="card-text text-muted">No payroll lines in this range.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var line in report.PayrollCostByCurrency)
                            {
                                <li>@line.Amount.ToString("N3", null) @line.Currency</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
        <div class="col">
            <div class="card @(report.PaymentBlockedStudents > 0 ? "border-warning" : "")">
                <div class="card-body">
                    <h5 class="card-title">Students payment-blocked right now</h5>
                    <p class="card-text display-6">@report.PaymentBlockedStudents</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Payments awaiting confirmation</h5>
                    <p class="card-text display-6">@report.PendingPayments</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Scheduled teaching hours</h5>
                    <p class="card-text display-6">@((report.ScheduledTeachingMinutes / 60.0).ToString("N1", null))</p>
                    <p class="card-text text-muted small">@report.ScheduledTeachingMinutes minutes across every non-cancelled session scheduled in this range.</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Net profit (revenue − payroll − expenses)</h5>
                    @if (report.NetProfitByCurrency.Count == 0)
                    {
                        <p class="card-text text-muted">Nothing to report in this range.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var line in report.NetProfitByCurrency)
                            {
                                <li class="@(line.Amount < 0 ? "text-danger" : "")">@line.Amount.ToString("N3", null) @line.Currency</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.PreviousPeriodReport is { } previous)
    {
        <h2>Month-over-month comparison</h2>
        <p class="text-muted small">Compared against the immediately preceding period of the same length (@previous.PeriodStart.ToString("yyyy-MM-dd", null) to @previous.PeriodEnd.ToString("yyyy-MM-dd", null)).</p>
        <div class="table-responsive mb-4">
            <table class="table table-sm table-striped">
                <thead><tr><th>Currency</th><th>Revenue (this period)</th><th>Revenue (previous)</th><th>Net profit (this period)</th><th>Net profit (previous)</th></tr></thead>
                <tbody>
                    @{
                        var currencies = report.RevenueByCurrency.Select(c => c.Currency)
                            .Concat(report.NetProfitByCurrency.Select(c => c.Currency))
                            .Concat(previous.RevenueByCurrency.Select(c => c.Currency))
                            .Concat(previous.NetProfitByCurrency.Select(c => c.Currency))
                            .Distinct();
                    }
                    @foreach (var currency in currencies)
                    {
                        <tr>
                            <td>@currency</td>
                            <td>@(report.RevenueByCurrency.FirstOrDefault(c => c.Currency == currency)?.Amount.ToString("N3", null) ?? "0.000")</td>
                            <td>@(previous.RevenueByCurrency.FirstOrDefault(c => c.Currency == currency)?.Amount.ToString("N3", null) ?? "0.000")</td>
                            <td>@(report.NetProfitByCurrency.FirstOrDefault(c => c.Currency == currency)?.Amount.ToString("N3", null) ?? "0.000")</td>
                            <td>@(previous.NetProfitByCurrency.FirstOrDefault(c => c.Currency == currency)?.Amount.ToString("N3", null) ?? "0.000")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Record an operating expense</h5>
            <p class="text-muted small">Teacher payroll can never be entered here — it is already counted automatically from PayrollLines.</p>
            @if (Model.StatusMessage is not null)
            {
                <div class="alert alert-success">@Model.StatusMessage</div>
            }
            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            <form method="post" asp-page-handler="RecordExpense" class="row g-2">
                <div class="col-md-2">
                    <label class="form-label" asp-for="NewExpense.CountryId">Country Id</label>
                    <input asp-for="NewExpense.CountryId" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="NewExpense.Category">Category</label>
                    <input asp-for="NewExpense.Category" class="form-control" placeholder="e.g. Rent, Marketing" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" asp-for="NewExpense.Amount">Amount</label>
                    <input asp-for="NewExpense.Amount" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" asp-for="NewExpense.Currency">Currency</label>
                    <input asp-for="NewExpense.Currency" class="form-control" placeholder="JOD" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="NewExpense.IncurredOn">Incurred on</label>
                    <input asp-for="NewExpense.IncurredOn" type="date" class="form-control" />
                </div>
                <div class="col-md-8">
                    <label class="form-label" asp-for="NewExpense.Note">Note (optional)</label>
                    <input asp-for="NewExpense.Note" class="form-control" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">Record expense</button>
                </div>
            </form>
        </div>
    </div>

    <h2>Operating expenses in this range</h2>
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead><tr><th>Date</th><th>Category</th><th>Amount</th><th>Note</th></tr></thead>
            <tbody>
                @foreach (var e in Model.Expenses)
                {
                    <tr>
                        <td>@e.IncurredOn.ToString("yyyy-MM-dd", null)</td>
                        <td>@e.Category</td>
                        <td>@e.Amount.Amount.ToString("N3", null) @e.Amount.Currency</td>
                        <td>@e.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
