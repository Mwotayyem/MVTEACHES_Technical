@page
@model MVTeaches.Web.Pages.Admin.TeachersModel
@using MVTeaches.Domain.Payroll
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = T["Teachers"].Value;
    // Server-side enforcement already lives on every OnPost handler in
    // Teachers.cshtml.cs — this only hides the forms/buttons for a
    // view-only admin so they are not shown a control that would refuse them.
    var canManage = (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.TeachersManage)).Succeeded;
}

<nav class="app-crumbs" aria-label="@T["Breadcrumb"]">
    <a asp-page="/Admin/Dashboard">@T["Dashboard"]</a>
    <span class="app-crumb-sep" aria-hidden="true">/</span>
    <span>@T["Teachers"]</span>
</nav>

<div class="app-page-head">
    <div>
        <h1>@T["Teachers"]</h1>
        <p class="text-muted">@T["A teacher account is always admin-created, never self-registered."]</p>
    </div>
    <div class="app-page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Schedules">@T["Schedules"]</a>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Payroll">@T["Payroll"]</a>
    </div>
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert" tabindex="-1">
        <strong>@T["Some fields still need attention"]</strong>
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

@if (canManage)
{
<div class="card mb-4">
    <div class="card-body">
        <h2 class="card-title h5">@T["Register a teacher"]</h2>
        <form method="post" asp-page-handler="Register" class="row g-3">
            <div class="col-md-3">
                <label class="form-label" asp-for="NewTeacher.FullName">@T["Full name"]</label>
                <input asp-for="NewTeacher.FullName" class="form-control" autocomplete="off" />
                <span asp-validation-for="NewTeacher.FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewTeacher.Email">@T["Email"]</label>
                <input asp-for="NewTeacher.Email" class="form-control" autocomplete="off" />
                <span asp-validation-for="NewTeacher.Email" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewTeacher.Password">@T["Temporary password"]</label>
                <input asp-for="NewTeacher.Password" type="password" class="form-control" autocomplete="new-password" />
                <div class="form-text">@T["At least 8 characters. The teacher can change it after signing in."]</div>
                <span asp-validation-for="NewTeacher.Password" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewTeacher.TimeZoneId">@T["Time zone"]</label>
                <input type="search" class="form-control mb-1" data-mv-select-filter="#teacherTimeZone"
                       placeholder="@T["Search time zones…"]" aria-label="@T["Search time zones…"]" />
                <select asp-for="NewTeacher.TimeZoneId" id="teacherTimeZone" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var tz in Model.TimeZoneIds)
                    {
                        <option value="@tz">@tz</option>
                    }
                </select>
                <div class="form-text">@T["Sessions this teacher publishes are stored against this zone."]</div>
                <span asp-validation-for="NewTeacher.TimeZoneId" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">@T["Register teacher"]</button>
            </div>
        </form>
    </div>
</div>
}
else
{
    <p class="text-muted small">@T["You have view-only access to teachers and cannot register one, set a pay rate, manage allowed levels, or deactivate/reactivate an account."]</p>
}

<div class="app-guide">
    <p class="app-guide-title">@T["Two different things, often confused"]</p>
    <ul>
        <li><strong>@T["Pay rate"]</strong> — @T["how much this teacher is paid. It is money, and it feeds payroll."]</li>
        <li><strong>@T["Levels they may teach"]</strong> — @T["which classes this teacher is allowed to run at all. It is permission, and it has nothing to do with money."]</li>
    </ul>
    <p>@T["A teacher needs both: without a pay rate a delivered session cannot be verified for payment, and without at least one allowed level they cannot publish any session."]</p>
</div>

@if (canManage)
{
<div class="card mb-4" id="pay-rate">
    <div class="card-body">
        <h2 class="card-title h5">@T["How much is this teacher paid?"]</h2>
        <p class="text-muted small">@T["Leave course, level and age group empty for the teacher's ordinary rate. Add a more specific rate only when one particular kind of class pays differently — the most specific one that fits wins at payment time."]</p>
        <form method="post" asp-page-handler="CreateRate" class="row g-3">
            <div class="col-md-3">
                <label class="form-label" asp-for="NewRate.TeacherId">@T["Teacher"]<span class="app-required">*</span></label>
                <input type="search" class="form-control mb-1" data-mv-select-filter="#rateTeacher"
                       placeholder="@T["Search by name…"]" aria-label="@T["Search by name…"]" />
                <select asp-for="NewRate.TeacherId" id="rateTeacher" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var t in Model.Teachers)
                    {
                        <option value="@t.Id">@t.FullName</option>
                    }
                </select>
                <span asp-validation-for="NewRate.TeacherId" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewRate.CourseId">@T["Course (blank = any)"]</label>
                <select asp-for="NewRate.CourseId" class="form-select">
                    <option value="">@T["any"]</option>
                    @foreach (var c in Model.Courses)
                    {
                        <option value="@c.Id">@c.NameEn</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewRate.LevelId">@T["Level (blank = any)"]</label>
                <select asp-for="NewRate.LevelId" class="form-select">
                    <option value="">@T["any"]</option>
                    @foreach (var l in Model.Levels)
                    {
                        <option value="@l.Id">@l.Code</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewRate.AgeGroupId">@T["Age group (blank = any)"]</label>
                <select asp-for="NewRate.AgeGroupId" class="form-select">
                    <option value="">@T["any"]</option>
                    @foreach (var a in Model.AgeGroups)
                    {
                        <option value="@a.Id">@a.Code</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewRate.Amount">@T["Amount"]<span class="app-required">*</span></label>
                <input asp-for="NewRate.Amount" class="form-control" inputmode="decimal" />
                <div class="form-text">@T["What the teacher earns per unit chosen beside it."]</div>
                <span asp-validation-for="NewRate.Amount" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewRate.Currency">@T["Currency"]<span class="app-required">*</span></label>
                <select asp-for="NewRate.Currency" class="form-select">
                    @foreach (var code in Model.Currencies)
                    {
                        <option value="@code">@code</option>
                    }
                </select>
                <span asp-validation-for="NewRate.Currency" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewRate.Unit">@T["Unit"]</label>
                <select asp-for="NewRate.Unit" class="form-select">
                    @foreach (var v in Enum.GetValues<RateUnit>())
                    {
                        <option value="@v">@T["RateUnit." + v]</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewRate.EffectiveFrom">@T["Paid at this rate from"]<span class="app-required">*</span></label>
                <input asp-for="NewRate.EffectiveFrom" type="date" class="form-control" />
                <div class="form-text">@T["Sessions before this date keep whatever rate applied then."]</div>
                <span asp-validation-for="NewRate.EffectiveFrom" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">@T["Save the pay rate"]</button>
                <div class="app-outcome mt-3">@T["Next: when a delivered session is verified on the payroll screen, this is the rate it is paid at."]</div>
            </div>
        </form>
    </div>
</div>
}

<h2>@T["Pay rates in force"]</h2>
<div class="table-responsive mb-4">
    <table class="table table-sm table-striped">
        <thead><tr><th>@T["Teacher"]</th><th>@T["Course"]</th><th>@T["Level"]</th><th>@T["Age group"]</th><th>@T["Rate"]</th><th>@T["Unit"]</th><th>@T["From"]</th><th>@T["To"]</th></tr></thead>
        <tbody>
            @foreach (var r in Model.Rates)
            {
                <tr>
                    <td>@r.TeacherName</td>
                    <td>@(r.CourseName ?? T["any"].Value)</td>
                    <td>@(r.LevelCode ?? T["any"].Value)</td>
                    <td>@(r.AgeGroupCode ?? T["any"].Value)</td>
                    <td>@T.Money(r.Amount, r.Currency)</td>
                    <td>@T["RateUnit." + r.Unit]</td>
                    <td>@T.Date(r.EffectiveFrom)</td>
                    <td>@(r.EffectiveTo is null ? T["Still in effect"].Value : T.Date(r.EffectiveTo.Value))</td>
                </tr>
            }
            @if (Model.Rates.Count == 0)
            {
                <tr>
                    <td colspan="8">
                        <div class="app-empty">
                            <strong>@T["No pay rate set yet."]</strong>
                            <span>@T["A delivered session cannot be verified for payment until a rate covers it — set one above."]</span>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (canManage)
{
<div class="card mb-4" id="allowed-levels">
    <div class="card-body">
        <h2 class="card-title h5">@T["Which levels may this teacher teach?"]</h2>
        <p class="text-muted small">@T["This is permission, not pay. A teacher can only publish sessions for the levels ticked here. Tick as many as apply — a level they already have is simply left as it is."]</p>
        <form method="post" asp-page-handler="GrantLevel" class="row g-3">
            <div class="col-md-4">
                <label class="form-label" asp-for="LevelGrant.TeacherId">@T["Teacher"]<span class="app-required">*</span></label>
                <input type="search" class="form-control mb-1" data-mv-select-filter="#grantLevelTeacher"
                       placeholder="@T["Search by name…"]" aria-label="@T["Search by name…"]" />
                <select asp-for="LevelGrant.TeacherId" id="grantLevelTeacher" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var t in Model.Teachers)
                    {
                        <option value="@t.Id">@t.FullName</option>
                    }
                </select>
                <span asp-validation-for="LevelGrant.TeacherId" class="text-danger small"></span>
            </div>
            @* Owner decision 2026-09-04: which COURSE these levels are in. Asked
               first and never defaulted — a level with no course silently
               authorised every subject the centre teaches. *@
            <div class="col-md-4">
                <label class="form-label" asp-for="LevelGrant.CourseId">@T["Course"]<span class="app-required">*</span></label>
                <select asp-for="LevelGrant.CourseId" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var c in Model.Courses)
                    {
                        <option value="@c.Id">@c.NameEn</option>
                    }
                </select>
                <span asp-validation-for="LevelGrant.CourseId" class="text-danger small"></span>
            </div>
            <div class="col-md-8">
                <label class="form-label">@T["Levels"]<span class="app-required">*</span></label>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var l in Model.Levels)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="LevelGrant.LevelIds"
                                   value="@l.Id" id="grantLevel_@l.Id" />
                            <label class="form-check-label" for="grantLevel_@l.Id">@l.Code</label>
                        </div>
                    }
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">@T["Allow these levels"]</button>
                <div class="app-outcome mt-3">@T["Next: the teacher can publish their own available times for those levels from their own screen."]</div>
            </div>
        </form>
    </div>
</div>
}

<h2>@T["Teachers"]</h2>
<div class="app-toolbar">
    <div class="app-search">
        <input type="search" class="form-control" data-mv-filter="#teachersTable"
               placeholder="@T["Search by name, time zone, or level…"]" aria-label="@T["Search by name, time zone, or level…"]" />
    </div>
</div>
<div class="table-responsive">
    <table class="table table-sm table-striped" id="teachersTable">
        <thead><tr><th>@T["Name"]</th><th>@T["Time zone"]</th><th>@T["Active"]</th><th>@T["Online sessions"]</th><th>@T["Levels they may teach"]</th><th>@T["Actions"]</th></tr></thead>
        <tbody>
            @foreach (var t in Model.Teachers)
            {
                <tr>
                    <td>@t.FullName</td>
                    <td>@t.TimeZoneId</td>
                    <td>
                        @if (t.IsActive)
                        {
                            <span class="app-status is-success">@T["Yes"]</span>
                        }
                        else
                        {
                            <span class="app-status is-muted">@T["No"]</span>
                        }
                    </td>
                    <td>
                        @if (Model.TeachersNotReadyForOnlineSessions.Contains(t.Id))
                        {
                            <span class="app-status is-danger" title="@T["No connected Zoom or Google Meet account — this teacher cannot be assigned online sessions. A free Google account is sufficient."]">@T["Not ready"]</span>
                            <div class="form-text">@T["The teacher connects their own account from their Connections screen. The centre has no shared account, and buys no licence."]</div>
                        }
                        else
                        {
                            <span class="app-status is-success">@T["Ready"]</span>
                        }
                    </td>
                    <td>
                        @* Each chip names the course as well as the level: a
                           teacher authorised for B2 English is not authorised
                           for B2 Spanish, and the chip has to say so. *@
                        @if (Model.GrantsByTeacher.TryGetValue(t.Id, out var grants) && grants.Count > 0)
                        {
                            foreach (var g in grants)
                            {
                                @if (canManage)
                                {
                                    <form method="post" asp-page-handler="RevokeLevel" class="d-inline-block me-1 mb-1">
                                        <input type="hidden" name="teacherId" value="@t.Id" />
                                        <input type="hidden" name="courseId" value="@g.CourseId" />
                                        <input type="hidden" name="levelId" value="@g.LevelId" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="@T["Revoke this level"]"
                                                data-mv-confirm="@T["Revoke this level from this teacher?"]">@g.CourseName @g.LevelCode &times;</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="app-chip me-1">@g.CourseName @g.LevelCode</span>
                                }
                            }
                        }
                        else
                        {
                            <span class="text-muted">@T["None"]</span>
                        }
                    </td>
                    <td>
                        @if (!canManage)
                        {
                            <span class="text-muted small">@T["View only"]</span>
                        }
                        else if (t.IsActive)
                        {
                            <form method="post" asp-page-handler="Deactivate">
                                <input type="hidden" name="teacherId" value="@t.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        data-mv-confirm="@T["Deactivate this teacher?"]">@T["Deactivate"]</button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Reactivate">
                                <input type="hidden" name="teacherId" value="@t.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">@T["Reactivate"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            <tr data-mv-filter-empty="true" hidden>
                <td colspan="6" class="text-muted">@T["No teacher matches this search."]</td>
            </tr>
            @if (Model.Teachers.Count == 0)
            {
                <tr><td colspan="6" class="text-muted">@T["No teachers registered yet — use the form above to add the first one."]</td></tr>
            }
        </tbody>
    </table>
</div>
