@page
@model MVTeaches.Web.Pages.Admin.SchedulesModel
@using MVTeaches.Domain.Scheduling
@using NodaTime
@{
    ViewData["Title"] = T["Schedules"].Value;
}

<h1>@T["Recurring schedules"]</h1>
<p class="text-muted">@T["A fixed weekly schedule, not a free-form booking calendar. Creating one here is what lets the nightly generator (or an admin's \"Trigger now\" on"] <a href="~/hangfire">/hangfire</a>) @T["actually produce real sessions."]</p>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@T["Create a recurring schedule"]</h5>
        <form method="post" asp-page-handler="Create" class="row g-2">
            <div class="col-md-3">
                <label class="form-label" asp-for="NewSchedule.CountryId">@T["Country"]</label>
                <select asp-for="NewSchedule.CountryId" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var c in Model.Countries)
                    {
                        <option value="@c.Id">@c.NameEn</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewSchedule.CourseId">@T["Course"]</label>
                <select asp-for="NewSchedule.CourseId" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var c in Model.Courses)
                    {
                        <option value="@c.Id">@c.NameEn</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewSchedule.LevelId">@T["Level"]</label>
                <select asp-for="NewSchedule.LevelId" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var l in Model.Levels)
                    {
                        <option value="@l.Id">@l.Code</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewSchedule.AgeGroupId">@T["Age group"]</label>
                <select asp-for="NewSchedule.AgeGroupId" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var a in Model.AgeGroups)
                    {
                        <option value="@a.Id">@a.Code</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="NewSchedule.TeacherId">@T["Teacher"]</label>
                @* Owner clarification (2026-08-29): a teacher with no connected
                   Zoom/Google Meet account is not assignable to online sessions.
                   RecurringScheduleService rejects it server-side regardless —
                   this list is only the friendly path. *@
                <select asp-for="NewSchedule.TeacherId" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var t in Model.Teachers.Where(t => !Model.TeachersNotReadyForOnlineSessions.Contains(t.Id)))
                    {
                        <option value="@t.Id">@t.FullName</option>
                    }
                </select>
                @if (Model.TeachersNotReadyForOnlineSessions.Count > 0)
                {
                    <div class="form-text text-danger">
                        @T["Hidden — not ready for online sessions (no connected video account; a free Google account is enough):"]
                        @string.Join(", ", Model.Teachers.Where(t => Model.TeachersNotReadyForOnlineSessions.Contains(t.Id)).Select(t => t.FullName))
                    </div>
                }
            </div>
            <div class="col-md-8">
                <label class="form-label">@T["Days of week"]</label>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var day in Enum.GetValues<IsoDayOfWeek>().Where(d => d != IsoDayOfWeek.None))
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="NewSchedule.DaysOfWeek" value="@((int)day)" id="day_@day" />
                            <label class="form-check-label" for="day_@day">@T["DayOfWeek." + day]</label>
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewSchedule.StartLocal">@T["Start time (local)"]</label>
                <input asp-for="NewSchedule.StartLocal" type="time" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewSchedule.DurationMinutes">@T["Duration (minutes)"]</label>
                <input asp-for="NewSchedule.DurationMinutes" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewSchedule.TimeZoneId">@T["Time zone"]</label>
                <select asp-for="NewSchedule.TimeZoneId" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var tz in Model.TimeZoneIds)
                    {
                        <option value="@tz">@tz</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewSchedule.StartsOn">@T["Starts on"]</label>
                <input asp-for="NewSchedule.StartsOn" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewSchedule.Capacity">@T["Capacity"]</label>
                <input asp-for="NewSchedule.Capacity" class="form-control" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">@T["Create schedule"]</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@T["Enroll a student"]</h5>
        <p class="text-muted small">@T["This enrolls the student directly into every currently-generated, not-yet-started session under the chosen schedule — a one-time bulk action, not a standing membership. A student added to a schedule AFTER new sessions are generated needs enrolling again for those new ones."]</p>
        <form method="post" asp-page-handler="Enroll" class="row g-2">
            <div class="col-md-4">
                <label class="form-label" asp-for="Enroll.RecurringScheduleId">@T["Schedule"]</label>
                <select asp-for="Enroll.RecurringScheduleId" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var s in Model.Schedules)
                    {
                        <option value="@s.Id">@s.CourseName / @s.LevelCode — @s.TeacherName (@s.Days @s.StartLocal)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Enroll.StudentId">@T["Student"]</label>
                <select asp-for="Enroll.StudentId" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var s in Model.Students)
                    {
                        <option value="@s.Id">@s.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">@T["Enroll into upcoming sessions"]</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@T["Cancel a session"]</h5>
        <p class="text-muted small">@T["Give a replacement session and every not-yet-joined enrollment transfers to it with no ledger movement — the substitute session's own Join is the one deduction. Leave it blank for a plain cancellation. A student who already pressed Join before the problem occurred is never touched automatically — approve their specific replacement lesson on"] <a asp-page="/Admin/RescheduleSessions">/Admin/RescheduleSessions</a> @T["instead."]</p>
        <form method="post" asp-page-handler="Cancel" class="row g-2">
            <div class="col-md-3">
                <label class="form-label" asp-for="Cancel.SessionId">@T["Session"]</label>
                <select asp-for="Cancel.SessionId" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var s in Model.UpcomingSessions)
                    {
                        <option value="@s.Id">@T.SessionOption(s.StartsAtUtc, s.ScheduleTimeZone) — @s.CourseName / @s.LevelCode — @s.TeacherName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="Cancel.Reason">@T["Reason"]</label>
                <input asp-for="Cancel.Reason" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="Cancel.ReplacementSessionId">@T["Replacement session (optional)"]</label>
                <select asp-for="Cancel.ReplacementSessionId" class="form-select">
                    <option value="">@T["None"]</option>
                    @foreach (var s in Model.UpcomingSessions)
                    {
                        <option value="@s.Id">@T.SessionOption(s.StartsAtUtc, s.ScheduleTimeZone) — @s.CourseName / @s.LevelCode — @s.TeacherName</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-danger">@T["Cancel session"]</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@T["Reassign a session's teacher"]</h5>
        <p class="text-muted small">
            @T["Only a future session that hasn't started yet. The former teacher's meeting is cancelled under their own connected account (or flagged for admin attention if that account was already revoked) — it is never reused for the new teacher — and a fresh meeting is created under the new teacher's own account the next time the session is started or joined. Enrolled students are notified. A teacher with no connected Zoom or Google Meet account cannot be selected here; a free Google account is sufficient for them to become available."]
        </p>
        <form method="post" asp-page-handler="Reassign" class="row g-2">
            <div class="col-md-5">
                <label class="form-label" asp-for="Reassign.SessionId">@T["Session"]</label>
                <select asp-for="Reassign.SessionId" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var s in Model.UpcomingSessions)
                    {
                        <option value="@s.Id">@T.SessionOption(s.StartsAtUtc, s.ScheduleTimeZone) — @s.CourseName / @s.LevelCode — @s.TeacherName</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label" asp-for="Reassign.NewTeacherId">@T["New teacher"]</label>
                <select asp-for="Reassign.NewTeacherId" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var t in Model.Teachers.Where(t => !Model.TeachersNotReadyForOnlineSessions.Contains(t.Id)))
                    {
                        <option value="@t.Id">@t.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-warning">@T["Reassign"]</button>
            </div>
        </form>
        @if (Model.TeachersNotReadyForOnlineSessions.Count > 0)
        {
            <p class="text-danger small mt-2 mb-0">
                @T["Not selectable (no connected video account):"]
                @string.Join(", ", Model.Teachers.Where(t => Model.TeachersNotReadyForOnlineSessions.Contains(t.Id)).Select(t => t.FullName))
            </p>
        }
    </div>
</div>

<h2>@T["Upcoming sessions (next 14 days)"]</h2>
<div class="table-responsive mb-4">
    <table class="table table-sm table-striped">
        <thead><tr><th>@T["Teacher"]</th><th>@T["Course/Level"]</th><th>@T["When"]</th><th>@T["Seats"]</th><th>@T["Status"]</th></tr></thead>
        <tbody>
            @foreach (var s in Model.UpcomingSessions)
            {
                <tr>
                    <td>@s.TeacherName</td>
                    <td>@s.CourseName / @s.LevelCode</td>
                    <td>
                        @T.SessionMoment(s.StartsAtUtc, s.ScheduleTimeZone)
                        <div class="text-muted small">@DisplayFormat.ZoneLabel(s.ScheduleTimeZone)</div>
                    </td>
                    <td>@s.SeatsTaken / @s.Capacity</td>
                    <td>@T["ClassSessionStatus." + s.Status]</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2>@T["Schedules"]</h2>
<div class="table-responsive">
    <table class="table table-sm table-striped">
        <thead><tr><th>#</th><th>@T["Teacher"]</th><th>@T["Course/Level/Age"]</th><th>@T["Days"]</th><th>@T["Time"]</th><th>@T["Duration"]</th><th>@T["Status"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var s in Model.Schedules)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.TeacherName</td>
                    <td>@s.CourseName / @s.LevelCode / @s.AgeGroupCode</td>
                    <td>@s.Days</td>
                    <td>@s.StartLocal (@s.TimeZoneId)</td>
                    <td>@s.DurationMinutes @T["min"]</td>
                    <td>@T["RecurringScheduleStatus." + s.Status]</td>
                    <td>
                        @if (s.Status == RecurringScheduleStatus.Active)
                        {
                            <form method="post" asp-page-handler="Pause">
                                <input type="hidden" name="scheduleId" value="@s.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Pause"]</button>
                            </form>
                        }
                        else if (s.Status == RecurringScheduleStatus.Paused)
                        {
                            <form method="post" asp-page-handler="Resume">
                                <input type="hidden" name="scheduleId" value="@s.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">@T["Resume"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
