@page
@model MVTeaches.Web.Pages.Admin.PlacementTestsModel
@using MVTeaches.Domain.Placement
@{
    ViewData["Title"] = T["Placement Tests"].Value;
}

<h1>@T["Placement Tests"]</h1>
<p class="text-muted">@T["This content is entirely admin-authored; nothing here is invented by the system. A version cannot be published unless its score ranges fully cover every possible score with no gaps or overlaps."]</p>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
        @if (Model.ValidationErrors.Count > 0)
        {
            <ul class="mb-0">
                @foreach (var e in Model.ValidationErrors)
                {
                    <li>@e</li>
                }
            </ul>
        }
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@T["Create a new draft version"]</h5>
        <form method="post" asp-page-handler="CreateVersion" class="row g-2">
            <div class="col-md-8">
                <label class="form-label" asp-for="NewVersion.Title">@T["Title"]</label>
                <input asp-for="NewVersion.Title" class="form-control" placeholder="@T["e.g. English Placement v3"]" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary">@T["Create draft"]</button>
            </div>
        </form>
    </div>
</div>

<h2>@T["Versions"]</h2>
<div class="table-responsive mb-4">
    <table class="table table-sm table-striped">
        <thead><tr><th>#</th><th>@T["Title"]</th><th>@T["Status"]</th><th>@T["Active"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var v in Model.Versions)
            {
                <tr class="@(Model.EditingVersionId == v.Id ? "table-active" : "")">
                    <td>@v.Id</td>
                    <td>@v.Title</td>
                    <td>@T["PlacementTestStatus." + v.Status]</td>
                    <td>@(v.IsActive ? T["Yes"] : "")</td>
                    <td>
                        <a asp-page="/Admin/PlacementTests" asp-route-versionId="@v.Id" class="btn btn-sm btn-outline-primary">@T["Edit"]</a>
                        @if (v.Status == PlacementTestStatus.Draft)
                        {
                            <form method="post" asp-page-handler="Publish" class="d-inline">
                                <input type="hidden" name="versionId" value="@v.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">@T["Publish"]</button>
                            </form>
                        }
                        @if (v.Status == PlacementTestStatus.Published && !v.IsActive)
                        {
                            <form method="post" asp-page-handler="Activate" class="d-inline">
                                <input type="hidden" name="versionId" value="@v.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-warning">@T["Activate"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.EditingVersion is not null)
{
    <h2>@T["Editing:"] @Model.EditingVersion.Title (#@Model.EditingVersion.Id, @T["PlacementTestStatus." + Model.EditingVersion.Status])</h2>

    @if (Model.EditingVersion.Status == PlacementTestStatus.Draft)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@T["Add a question"]</h5>
                <form method="post" asp-page-handler="AddQuestion" class="row g-2">
                    <input type="hidden" asp-for="NewQuestion.TestVersionId" value="@Model.EditingVersion.Id" />
                    <div class="col-12">
                        <label class="form-label" asp-for="NewQuestion.Text">@T["Question text"]</label>
                        <input asp-for="NewQuestion.Text" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" asp-for="NewQuestion.Points">@T["Points"]</label>
                        <input asp-for="NewQuestion.Points" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" asp-for="NewQuestion.SortOrder">@T["Sort order"]</label>
                        <input asp-for="NewQuestion.SortOrder" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="NewQuestion.CorrectChoiceNumber">@T["Correct choice #"]</label>
                        <select asp-for="NewQuestion.CorrectChoiceNumber" class="form-select">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="NewQuestion.Choice1Text">@T["Choice 1"]</label>
                        <input asp-for="NewQuestion.Choice1Text" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="NewQuestion.Choice2Text">@T["Choice 2"]</label>
                        <input asp-for="NewQuestion.Choice2Text" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="NewQuestion.Choice3Text">@T["Choice 3 (optional)"]</label>
                        <input asp-for="NewQuestion.Choice3Text" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="NewQuestion.Choice4Text">@T["Choice 4 (optional)"]</label>
                        <input asp-for="NewQuestion.Choice4Text" class="form-control" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">@T["Add question"]</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@T["Add a score range → level mapping"]</h5>
                <form method="post" asp-page-handler="AddScoreRange" class="row g-2">
                    <input type="hidden" asp-for="NewScoreRange.TestVersionId" value="@Model.EditingVersion.Id" />
                    <div class="col-md-3">
                        <label class="form-label" asp-for="NewScoreRange.MinScore">@T["Min score"]</label>
                        <input asp-for="NewScoreRange.MinScore" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" asp-for="NewScoreRange.MaxScore">@T["Max score"]</label>
                        <input asp-for="NewScoreRange.MaxScore" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" asp-for="NewScoreRange.LevelId">@T["Level"]</label>
                        <select asp-for="NewScoreRange.LevelId" class="form-select">
                            <option value="">-- @T["select"] --</option>
                            @foreach (var l in Model.Levels)
                            {
                                <option value="@l.Id">@l.Code</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary">@T["Add range"]</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <h4>@T["Questions"]</h4>
    <div class="table-responsive mb-3">
        <table class="table table-sm table-striped">
            <thead><tr><th>#</th><th>@T["Text"]</th><th>@T["Points"]</th><th>@T["Choices (✓ = correct)"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var q in Model.EditingQuestions)
                {
                    <tr>
                        <td>@q.SortOrder</td>
                        <td>@q.Text</td>
                        <td>@q.Points</td>
                        <td>
                            @if (Model.ChoicesByQuestion.TryGetValue(q.Id, out var choices))
                            {
                                foreach (var c in choices)
                                {
                                    <div>@(c.IsCorrect ? "✓ " : "")@c.Text</div>
                                }
                            }
                        </td>
                        <td>
                            @if (Model.EditingVersion.Status == PlacementTestStatus.Draft)
                            {
                                <form method="post" asp-page-handler="RemoveQuestion">
                                    <input type="hidden" name="questionId" value="@q.Id" />
                                    <input type="hidden" name="versionId" value="@Model.EditingVersion.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@T["Remove"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h4>@T["Score ranges"]</h4>
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead><tr><th>@T["Min"]</th><th>@T["Max"]</th><th>@T["Level"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model.EditingScoreRanges)
                {
                    <tr>
                        <td>@r.MinScore</td>
                        <td>@r.MaxScore</td>
                        <td>@(Model.Levels.FirstOrDefault(l => l.Id == r.LevelId)?.Code ?? $"#{r.LevelId}")</td>
                        <td>
                            @if (Model.EditingVersion.Status == PlacementTestStatus.Draft)
                            {
                                <form method="post" asp-page-handler="RemoveScoreRange">
                                    <input type="hidden" name="scoreRangeId" value="@r.Id" />
                                    <input type="hidden" name="versionId" value="@Model.EditingVersion.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@T["Remove"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2>@T["Pending retake requests"]</h2>
<p class="text-muted small">@T["A retake requires explicit admin approval; approving or rejecting is audit-logged."]</p>
<div class="table-responsive">
    <table class="table table-sm table-striped">
        <thead><tr><th>#</th><th>@T["Student"]</th><th>@T["Requested"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var r in Model.PendingRetakeRequests)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@Model.StudentNamesById.GetValueOrDefault(r.StudentId, $"#{r.StudentId}")</td>
                    <td>@r.RequestedAtUtc.ToString()</td>
                    <td>
                        <form method="post" asp-page-handler="ApproveRetake" class="d-inline">
                            <input type="hidden" name="retakeRequestId" value="@r.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-success">@T["Approve"]</button>
                        </form>
                        <form method="post" asp-page-handler="RejectRetake" class="d-inline">
                            <input type="hidden" name="retakeRequestId" value="@r.Id" />
                            <input type="text" name="reason" placeholder="@T["Reason (required)"]" class="form-control form-control-sm d-inline-block" style="width:auto" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">@T["Reject"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
