@page
@model MVTeaches.Web.Pages.Admin.CertificatesModel
@using Microsoft.AspNetCore.Authorization
@using MVTeaches.Infrastructure.Identity
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = T["Certificates"].Value;
    var canManage = (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.CertificatesManage)).Succeeded;
}

<h1>@T["Certificates"]</h1>
<p class="text-muted">@T["Progress is always live, grouped by student, level, and course — never by subscription. Reaching the hour threshold alone never issues a certificate; issuance is always this explicit action."]</p>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<h2>@T["Progress"]</h2>
<div class="app-toolbar">
    <div class="app-search">
        <input type="search" class="form-control" data-mv-filter="#progressTable"
               placeholder="@T["Search by name…"]" aria-label="@T["Search by name…"]" />
    </div>
</div>
<div class="table-responsive mb-4">
    <table class="table table-sm table-striped" id="progressTable">
        <thead><tr><th>@T["Student"]</th><th>@T["Level"]</th><th>@T["Course"]</th><th>@T["Minutes"]</th><th>@T["Required"]</th><th>@T["Eligible"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in Model.Progress)
            {
                <tr>
                    <td>@p.StudentName</td>
                    <td>@p.LevelCode</td>
                    <td>@p.CourseName</td>
                    <td>@T.Minutes(p.MinutesCompleted)</td>
                    <td>@T.Minutes(p.RequiredMinutes)</td>
                    <td>
                        @if (p.IsEligible)
                        {
                            <span class="app-status is-success">@T["Yes"]</span>
                        }
                        else
                        {
                            <span class="app-status is-muted">@T["No"]</span>
                        }
                    </td>
                    <td>
                        @if (p.AlreadyIssued)
                        {
                            <span class="text-muted">@T["Already issued"]</span>
                        }
                        else if (p.IsEligible && canManage)
                        {
                            <form method="post" asp-page-handler="Issue">
                                <input type="hidden" name="studentId" value="@p.StudentId" />
                                <input type="hidden" name="levelId" value="@p.LevelId" />
                                <input type="hidden" name="courseId" value="@p.CourseId" />
                                <button type="submit" class="btn btn-sm btn-success">@T["Issue"]</button>
                            </form>
                        }
                        else if (p.IsEligible)
                        {
                            <span class="text-muted small">@T["View only"]</span>
                        }
                    </td>
                </tr>
            }
            <tr data-mv-filter-empty="true" hidden>
                <td colspan="7" class="text-muted">@T["No student matches this search — try part of the name instead."]</td>
            </tr>
            @if (Model.Progress.Count == 0)
            {
                <tr><td colspan="7" class="text-muted">@T["No progress recorded yet."]</td></tr>
            }
        </tbody>
    </table>
</div>

<h2>@T["Issued certificates"]</h2>
<div class="table-responsive">
    <table class="table table-sm table-striped">
        <thead><tr><th>@T["Number"]</th><th>@T["Student"]</th><th>@T["Level"]</th><th>@T["Status"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in Model.Certificates)
            {
                <tr>
                    <td><span class="app-ref">@c.CertificateNumber</span></td>
                    <td>@c.StudentName</td>
                    <td>@c.LevelCode</td>
                    <td>@T["CertificateStatus." + c.Status]</td>
                    <td>
                        @if (c.Status == MVTeaches.Domain.Certificates.CertificateStatus.Issued && canManage)
                        {
                            <form method="post" asp-page-handler="Revoke">
                                <input type="hidden" name="certificateId" value="@c.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        data-mv-confirm="@T["Revoke this certificate?"]">@T["Revoke"]</button>
                            </form>
                        }
                        else if (c.Status == MVTeaches.Domain.Certificates.CertificateStatus.Issued)
                        {
                            <span class="text-muted small">@T["View only"]</span>
                        }
                    </td>
                </tr>
            }
            @if (Model.Certificates.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">@T["No certificates issued yet."]</td></tr>
            }
        </tbody>
    </table>
</div>
