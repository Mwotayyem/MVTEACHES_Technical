@page
@model MVTeaches.Web.Pages.Admin.PaymentsModel
@using MVTeaches.Domain.Payments
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = T["Payments"].Value;
    // Server-side enforcement already lives on OnPostRecordAsync/OnPostConfirmAsync/
    // OnPostRejectAsync (see Payments.cshtml.cs) — this only hides the forms
    // for a view-only admin so they are not shown a button that would refuse them.
    var canConfirm = (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.PaymentsConfirm)).Succeeded;
}

@functions {
    string Label(string key) => T[key].Value;

    string StatusClass(PaymentStatus status) => status switch
    {
        PaymentStatus.Confirmed => "app-status is-success",
        PaymentStatus.Pending => "app-status is-warning",
        PaymentStatus.Rejected or PaymentStatus.Failed => "app-status is-danger",
        _ => "app-status is-muted",
    };
}

<nav class="app-crumbs" aria-label="@T["Breadcrumb"]">
    <a asp-page="/Admin/Dashboard">@T["Dashboard"]</a>
    <span class="app-crumb-sep" aria-hidden="true">/</span>
    <span>@T["Payments"]</span>
</nav>

<div class="app-page-head">
    <div>
        <h1>@T["Payments"]</h1>
        <p class="text-muted">@T["Payments page intro"]</p>
    </div>
    <div class="app-page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Subscriptions">@T["Subscriptions"]</a>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/PaymentMethods">@T["Payment Methods"]</a>
    </div>
</div>

<div class="app-guide">
    <p class="app-guide-title">@T["What do I do on this screen?"]</p>
    <ol>
        <li>@T["A family sends money outside the platform — cash, CliQ, or a bank transfer. There is no online card payment here."]</li>
        <li>@T["The transfer is recorded against the student, either by the family themselves or by you on this screen."]</li>
        <li>@T["You check the real bank or CliQ account, and only then confirm that the amount actually arrived. Confirming is what activates the package."]</li>
    </ol>
    <p><span class="app-guide-next">@T["Start here:"]</span> @T["the Awaiting confirmation list below — those are the ones with somebody waiting."]</p>
</div>

@if (Model.FilterStudentId is not null)
{
    <div class="alert alert-info d-flex flex-wrap gap-2 align-items-center" role="status">
        <span>@T["Showing only:"] <strong>@(Model.FilterStudentName ?? T["Not specified"].Value)</strong></span>
        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Payments">@T["Show everyone"]</a>
        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/StudentDetails" asp-route-id="@Model.FilterStudentId">@T["Open student profile"]</a>
    </div>
}

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert" tabindex="-1">
        <strong>@T["Some fields still need attention"]</strong>
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

@* Owner report 2026-09-01: 10 JOD was recorded for a student who owed
   exactly 10 JOD on a package - but under "not against a package", so the
   package stayed unfunded while the family had already paid. The unattached
   option is no longer the path of least resistance: when this student owes on
   a package, that package is stated first, with a button that fills the form
   in for it. *@
@if (Model.OwedPackagesForFilteredStudent.Count > 0 && Model.CompletingPackage is null && canConfirm)
{
    <div class="app-callout is-warning">
        <div>
            <strong>@T["This student still owes money on a package."]</strong>
            <ul class="mb-0 mt-1">
                @foreach (var owed in Model.OwedPackagesForFilteredStudent)
                {
                    <li>
                        @owed.LevelCode —
                        @T["Package price"]: @T.Money(owed.Price, owed.Currency) ·
                        @T["Confirmed received"]: @T.Money(owed.ConfirmedReceived, owed.Currency) ·
                        <strong>@T["Remaining owed"]: @T.Money(owed.RemainingOwed, owed.Currency)</strong>
                    </li>
                }
            </ul>
            <p class="mb-0 mt-1">@T["Money arriving from this student is almost certainly for that package. Recording it as unattached money leaves the package inactive even though the family has paid."]</p>
        </div>
        <div class="d-flex flex-column gap-1">
            @foreach (var owed in Model.OwedPackagesForFilteredStudent)
            {
                <a class="btn btn-primary btn-sm" asp-page="/Admin/Payments"
                   asp-route-studentId="@Model.FilterStudentId" asp-route-complete="@owed.Id">
                    @T["Complete the remaining amount for this package"]
                </a>
            }
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        @if (Model.CompletingPackage is not null)
        {
            var c = Model.CompletingPackage;
            <h2 class="card-title h5">@T["Complete the remaining amount for this package"]</h2>
            <p class="text-muted small mb-2">@T["The form below is already filled in for this package and for exactly what it still needs. Change the amount only if a different sum actually arrived."]</p>
            <dl class="row small app-owed-breakdown">
                <dt class="col-sm-5">@T["Package price"]</dt>
                <dd class="col-sm-7">@T.Money(c.Price, c.Currency)</dd>
                <dt class="col-sm-5">@T["Confirmed received"]</dt>
                <dd class="col-sm-7">@T.Money(c.ConfirmedReceived, c.Currency)</dd>
                <dt class="col-sm-5">@T["Remaining owed"]</dt>
                <dd class="col-sm-7 fw-bold">@T.Money(c.RemainingOwed, c.Currency)</dd>
                <dt class="col-sm-5">@T["Amount that will be confirmed"]</dt>
                <dd class="col-sm-7">@T.Money(c.RemainingOwed, c.Currency)</dd>
                <dt class="col-sm-5">@T["The package after confirmation"]</dt>
                <dd class="col-sm-7"><span class="app-status is-success">@T["SubscriptionStatus.Active"]</span></dd>
            </dl>
            <p class="text-muted small">@T["Recording it here only queues it. It still has to be confirmed below, after you have checked the account."]</p>
            <a class="btn btn-sm btn-outline-secondary mb-3" asp-page="/Admin/Payments" asp-route-studentId="@Model.FilterStudentId">@T["Cancel"]</a>
        }
        else
        {
            <h2 class="card-title h5">@T["Record a manual package and payment"]</h2>
            <p class="text-muted small mb-2">@T["Use only for cash, bank transfer, or a correction — not as the routine way a student buys a package."]</p>
        }
        @if (canConfirm)
        {
        <form method="post" asp-page-handler="Record" class="row g-3 align-items-start">
            <input type="hidden" name="studentId" value="@Model.FilterStudentId" />
            <div class="col-md-4">
                <label class="form-label" asp-for="NewPayment.StudentId">@T["Student"]</label>
                <input type="search" class="form-control mb-1" data-mv-select-filter="#paymentStudent"
                       placeholder="@T["Search by name…"]" aria-label="@T["Search by name…"]" />
                <select asp-for="NewPayment.StudentId" id="paymentStudent" class="form-select">
                    <option value="">@T["Select placeholder"]</option>
                    @foreach (var student in Model.Students)
                    {
                        <option value="@student.Id">@student.FullName</option>
                    }
                </select>
                <span asp-validation-for="NewPayment.StudentId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label" asp-for="NewPayment.SubscriptionId">@T["Which package is this paying for?"]</label>
                <select asp-for="NewPayment.SubscriptionId" id="paymentSubscription" class="form-select"
                        data-mv-options-of="#paymentStudent" data-mv-options-empty="#noDraftsForStudent">
                    <option value="">@T["Not paying for a package — just record the money (rare)"]</option>
                    @foreach (var d in Model.DraftSubscriptions)
                    {
                        var price = T.Money(d.Price, d.Currency);
                        var optionLabel = d.ConfirmedReceived > 0
                            ? $"{d.LevelCode} · {Label("Package price")}: {price} ({Label("Remaining owed")}: {T.Money(d.RemainingOwed, d.Currency)})"
                            : $"{d.LevelCode} · {price}";
                        <option value="@d.Id" data-owner="@d.StudentId">@optionLabel</option>
                    }
                </select>
                <div class="form-text">@T["Only this student's own unpaid packages are listed. Attach the payment to the one it pays for — confirming it then activates that package."]</div>
                <div class="form-text text-warning" id="noDraftsForStudent" hidden>
                    @T["This student has no unpaid package. Either they already paid for everything, or the package has not been chosen yet — do that on the packages screen first."]
                </div>
                <div class="form-text text-warning">@T["Only leave it on the first option when the money genuinely is not for any package — a correction, a refund reversal, or a deposit to hold a seat. If the student owes on a package, choosing it here is what lets the package activate."]</div>
            </div>
            <div class="col-12">
                <hr class="my-1" />
                <p class="text-muted small mb-1 fw-semibold">@T["Now, exactly what arrived:"]</p>
            </div>
            <div class="col-md-2">
                <label class="form-label" asp-for="NewPayment.Amount">@T["Amount"]</label>
                <input asp-for="NewPayment.Amount" class="form-control" inputmode="decimal" />
                <span asp-validation-for="NewPayment.Amount" class="text-danger small"></span>
            </div>
            <div class="col-md-2">
                <label class="form-label" asp-for="NewPayment.Currency">@T["Currency"]</label>
                <select asp-for="NewPayment.Currency" class="form-select">
                    @foreach (var code in Model.Currencies)
                    {
                        <option value="@code">@code</option>
                    }
                </select>
                <span asp-validation-for="NewPayment.Currency" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="NewPayment.Method">@T["Method type"]</label>
                <select asp-for="NewPayment.Method" class="form-select">
                    @foreach (var value in Enum.GetValues<PaymentMethod>())
                    {
                        <option value="@value">@T["PaymentMethod." + value]</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">@T["Record"]</button>
            </div>
        </form>
        }
        else
        {
            <p class="text-muted small">@T["You have view-only access to payments and cannot record, confirm, or reject any."]</p>
        }
    </div>
</div>

<h2>@T["Awaiting confirmation"] <span class="app-status @(Model.PendingPayments.Count > 0 ? "is-warning" : "is-muted")">@Model.PendingPayments.Count</span></h2>
<p class="text-muted small">@T["Check the centre's real account first. Confirming here says the money is in the account — it is not an acknowledgement that a receipt was uploaded."]</p>
<div class="mb-4">
    @foreach (var p in Model.PendingPayments)
    {
        <div class="card mb-2">
            <div class="card-body">
                <h3 class="card-title h5 d-flex flex-wrap gap-2 align-items-center">
                    <span class="app-ref">@p.ReferenceCode</span>
                    <a asp-page="/Admin/StudentDetails" asp-route-id="@p.StudentId">@p.StudentName</a>
                    <span>@T.Money(p.Amount, p.Currency)</span>
                    <span class="text-muted fw-normal">(@T["PaymentMethod." + p.Method])</span>
                </h3>
                <p class="mb-2">
                    @if (p.HasSubmittedTransferDetails)
                    {
                        <span class="app-status is-info">@T["Under review"]</span>
                    }
                    else
                    {
                        <span class="app-status is-warning">@T["Awaiting transfer"]</span>
                    }
                </p>
                @if (p.HasSubmittedTransferDetails)
                {
                    <dl class="row small mb-2">
                        <dt class="col-sm-3">@T["Payer name"]</dt><dd class="col-sm-3">@(p.PayerDisplayName ?? T["Not specified"].Value)</dd>
                        <dt class="col-sm-3">@T["Transfer date"]</dt><dd class="col-sm-3">@T.Date(p.TransferDate)</dd>
                        <dt class="col-sm-3">@T["Bank reference number"]</dt><dd class="col-sm-3">@(p.BankReferenceNumber ?? T["Not specified"].Value)</dd>
                        <dt class="col-sm-3">@T["Receipt"]</dt>
                        <dd class="col-sm-3">
                            @if (p.HasReceipt)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-mv-file-modal="#receiptModal"
                                        data-mv-file-url="@Url.Page("/Files/Receipt", new { paymentId = p.Id })">@T["View receipt"]</button>
                            }
                            else
                            {
                                <span class="text-muted">@T["Not specified"]</span>
                            }
                        </dd>
                    </dl>
                }
                @* What this payment is actually funding, and how much that
                   package still needs. Without it the received-amount box was
                   a number typed against nothing. *@
                @if (p.SubscriptionId is not null)
                {
                    <dl class="row small app-owed-breakdown mb-2">
                        <dt class="col-sm-4">@T["Which package is this paying for?"]</dt>
                        <dd class="col-sm-8">@p.PackageLabel</dd>
                        <dt class="col-sm-4">@T["Package price"]</dt>
                        <dd class="col-sm-8">@T.Money(p.PackagePrice, p.Currency)</dd>
                        <dt class="col-sm-4">@T["Confirmed received"]</dt>
                        <dd class="col-sm-8">@T.Money(p.PackagePaid, p.Currency)</dd>
                        <dt class="col-sm-4">@T["Remaining owed"]</dt>
                        <dd class="col-sm-8 fw-bold">@T.Money(p.PackageRemaining, p.Currency)</dd>
                    </dl>
                }
                else
                {
                    <p class="small"><span class="app-status is-muted">@T["Not against any package"]</span></p>
                }
                @if (canConfirm)
                {
                <form method="post" asp-page-handler="Confirm" class="row g-2 align-items-end mb-2">
                    <input type="hidden" name="studentId" value="@Model.FilterStudentId" />
                    <input type="hidden" name="paymentId" value="@p.Id" />
                    <div class="col-auto">
                        <label class="form-label small mb-0" for="received-@p.Id">@T["Actually received amount (if different)"]</label>
                        @{
                            var ceiling = p.SubscriptionId is not null && p.PackageRemaining is not null
                                ? p.PackageRemaining.Value
                                : p.Amount;
                        }
                        @* The cap is a convenience that stops the typo before it
                           is submitted. The refusal itself lives in
                           IPaymentService.ConfirmAsync, which recomputes the
                           remaining balance server-side and rejects an excess
                           whatever the browser sent. *@
                        <input type="number" step="0.001" min="0" max="@ceiling" id="received-@p.Id" name="receivedAmount"
                               class="form-control form-control-sm" style="width:9rem" />
                        <div class="form-text">@T["At most"] @T.Money(ceiling, p.Currency)</div>
                    </div>
                    <div class="col-auto">
                        <label class="form-label small mb-0" for="receivedCurrency-@p.Id">@T["Actually received currency (if different)"]</label>
                        <select id="receivedCurrency-@p.Id" name="receivedCurrency" class="form-select form-select-sm" style="width:8rem">
                            @* This option's value USED to be "" — visually showing the
                               payment's own currency while actually posting an empty
                               string. Typing an amount here and leaving this untouched
                               (exactly what "leave blank when it matches" invites) then
                               made receivedCurrency blank, so the whole override was
                               silently discarded and the payment confirmed at its FULL
                               original amount instead of the amount just typed in — a
                               partial payment could confirm as if paid in full. The
                               value now really is the payment's currency. *@
                            <option value="@p.Currency">@p.Currency</option>
                            @foreach (var code in Model.Currencies)
                            {
                                if (!string.Equals(code, p.Currency, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@code">@code</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-success"
                                data-mv-confirm="@T["Confirm that this amount really arrived in the account?"]">
                            @T["Confirm receipt of the amount and activate the package"]
                        </button>
                    </div>
                    <div class="col-12">
                        <div class="form-text">@T["Leave both blank when the full requested amount arrived as requested."]</div>
                        <div class="form-text text-warning">@T["More than what is still owed cannot be confirmed. If a larger sum really arrived, confirm what is owed and record the difference separately, so the extra money is visible instead of disappearing into an activation."]</div>
                    </div>
                </form>
                <form method="post" asp-page-handler="Reject" class="d-flex gap-1 flex-wrap">
                    <input type="hidden" name="studentId" value="@Model.FilterStudentId" />
                    <input type="hidden" name="paymentId" value="@p.Id" />
                    <input type="text" name="RejectReason" class="form-control form-control-sm" style="max-width:22rem"
                           placeholder="@T["Reason the payer will read"]" aria-label="@T["Reason the payer will read"]" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">@T["Reject / request correction"]</button>
                </form>
                }
                else
                {
                    <p class="text-muted small">@T["You have view-only access to payments and cannot confirm or reject this."]</p>
                }
            </div>
        </div>
    }
    @if (Model.PendingPayments.Count == 0)
    {
        <div class="app-empty">
            <strong>@T["Nothing awaiting confirmation."]</strong>
            <span>@T["New transfers reported by students and guardians appear here."]</span>
        </div>
    }
</div>

<h2>@T["Recent history"]</h2>
@* Owner report 2026-09-01: "a first payment of 50 received 40, a top-up of 10
   received 20, then another 10" read as three unrelated rows, and an admin
   could not tell from them whether the package was settled, short, or overpaid.
   Same payments, same order - gathered under the package they funded, with
   that package's own standing stated once above them. Money that was never
   attached to a package gets its own block at the end, so a general payment can
   never be mistaken for an instalment on a package. *@
<div class="app-toolbar">
    <div class="app-search">
        <input type="search" class="form-control" data-mv-filter="#paymentsHistory"
               placeholder="@T["Search by student, reference, or status…"]" aria-label="@T["Search by student, reference, or status…"]" />
    </div>
</div>

<div id="paymentsHistory">
    @foreach (var group in Model.RecentGroups)
    {
        <article class="card mb-3" data-mv-filter-item>
            <div class="card-body">
                <h3 class="card-title h6 d-flex flex-wrap gap-2 align-items-center">
                    @if (group.SubscriptionId is not null)
                    {
                        <span class="app-chip is-level">@group.Title</span>
                        <span class="text-muted fw-normal small">@T["Package"] #@group.SubscriptionId</span>
                    }
                    else
                    {
                        <span class="app-status is-muted">@group.Title</span>
                    }
                    @if (group.Status is not null)
                    {
                        <span class="@(group.Status == MVTeaches.Domain.Subscriptions.SubscriptionStatus.Active ? "app-status is-success" : "app-status is-warning")">
                            @T["SubscriptionStatus." + group.Status]
                        </span>
                    }
                </h3>

                @if (group.SubscriptionId is not null && group.Price is not null)
                {
                    <dl class="row small app-owed-breakdown mb-2">
                        <dt class="col-sm-3">@T["Package price"]</dt>
                        <dd class="col-sm-3">@T.Money(group.Price, group.Currency)</dd>
                        <dt class="col-sm-3">@T["Confirmed received"]</dt>
                        <dd class="col-sm-3">@T.Money(group.Paid, group.Currency)</dd>
                        <dt class="col-sm-3">@T["Remaining owed"]</dt>
                        <dd class="col-sm-3 fw-bold">
                            @if (group.Remaining > 0m)
                            {
                                <span class="text-danger">@T.Money(group.Remaining, group.Currency)</span>
                            }
                            else
                            {
                                <span class="app-status is-success">@T["Fully paid."]</span>
                            }
                        </dd>
                    </dl>
                }
                else
                {
                    <p class="text-muted small mb-2">@T["These amounts do not fund any package. They activate nothing on their own."]</p>
                }

                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr><th>@T["Reference"]</th><th>@T["Student"]</th><th>@T["Amount"]</th><th>@T["Received"]</th><th>@T["Method type"]</th><th>@T["Status"]</th><th>@T["Note"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var p in group.Payments)
                            {
                                <tr>
                                    <td><span class="app-ref">@p.ReferenceCode</span></td>
                                    <td><a asp-page="/Admin/StudentDetails" asp-route-id="@p.StudentId">@p.StudentName</a></td>
                                    <td>@T.Money(p.Amount, p.Currency)</td>
                                    <td>
                                        @(p.ReceivedAmount is not null ? T.Money(p.ReceivedAmount.Value, p.ReceivedCurrency) : T["Not specified"].Value)
                                        @if (p.Status == PaymentStatus.Confirmed && p.ReceivedAmount is not null && p.ReceivedCurrency == p.Currency && p.ReceivedAmount < p.Amount)
                                        {
                                            <span class="app-status is-warning">@T["Arrived short of what was requested"]</span>
                                        }
                                        else if (p.Status == PaymentStatus.Confirmed && p.ReceivedAmount is not null && p.ReceivedCurrency == p.Currency && p.ReceivedAmount > p.Amount)
                                        {
                                            @* Only history from before the refusal existed can show
                                               this. It is called out rather than left to be spotted
                                               by comparing two columns. *@
                                            <span class="app-status is-danger">@T["More arrived than was requested"]</span>
                                        }
                                    </td>
                                    <td>@T["PaymentMethod." + p.Method]</td>
                                    <td><span class="@StatusClass(p.Status)">@T["PaymentStatus." + p.Status]</span></td>
                                    <td>@p.RejectionReason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </article>
    }

    <div class="app-empty" data-mv-filter-empty="true" hidden>
        @T["No payment matches this search — try part of the student's name or the reference."]
    </div>

    @if (Model.RecentGroups.Count == 0)
    {
        <div class="app-empty"><strong>@T["No payments recorded yet."]</strong></div>
    }
</div>

<div class="modal fade" id="receiptModal" tabindex="-1" aria-labelledby="receiptModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="receiptModalLabel">@T["Receipt"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
            </div>
            <div class="modal-body p-0">
                <iframe data-mv-file-frame title="@T["Receipt"]" style="width:100%;height:75vh;border:0"></iframe>
            </div>
            <div class="modal-footer">
                <a data-mv-file-open-new href="#" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">@T["Open in a new tab"]</a>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@T["Close"]</button>
            </div>
        </div>
    </div>
</div>
