@page
@model MVTeaches.Web.Pages.Admin.PaymentsModel
@using MVTeaches.Domain.Payments
@{
    ViewData["Title"] = "Payments";
}

<h1>Payments</h1>
<p class="text-muted">
    Owner decision 2026-08-30: the <strong>normal</strong> path is the student or guardian buying a published
    package and paying through the payment gateway, with the entitlement activating automatically once the
    gateway's trusted server-side confirmation arrives. No payment provider has been selected yet, so that path
    is not live. Everything on this page is the <strong>exception</strong> path — cash, bank transfer, CliQ, or a
    correction — which is admin-only and written to the audit log.
</p>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">تسجيل باقة ودفع يدوي <span class="text-muted fs-6">(Record a manual package &amp; payment)</span></h5>
        <p class="text-muted small mb-2">Use only for cash, bank transfer, or a correction — not as the routine way a student buys a package.</p>
        <form method="post" asp-page-handler="Record" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label" asp-for="NewPayment.StudentId">Student</label>
                <select asp-for="NewPayment.StudentId" class="form-select">
                    <option value="">-- select --</option>
                    @foreach (var student in Model.Students)
                    {
                        <option value="@student.Id">@student.FullName (#@student.Id)</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label" asp-for="NewPayment.SubscriptionId">Subscription (optional — D-38)</label>
                <select asp-for="NewPayment.SubscriptionId" class="form-select">
                    <option value="">-- none --</option>
                    @foreach (var d in Model.DraftSubscriptions)
                    {
                        <option value="@d.Id">#@d.Id @d.StudentName — @d.Amount.ToString("N3", null) @d.Currency</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label" asp-for="NewPayment.Amount">Amount</label>
                <input asp-for="NewPayment.Amount" class="form-control" />
            </div>
            <div class="col-auto">
                <label class="form-label" asp-for="NewPayment.Currency">Currency</label>
                <input asp-for="NewPayment.Currency" class="form-control" placeholder="JOD" style="width:6rem" />
            </div>
            <div class="col-auto">
                <label class="form-label" asp-for="NewPayment.Method">Method</label>
                <select asp-for="NewPayment.Method" class="form-select">
                    @foreach (var value in Enum.GetValues<PaymentMethod>())
                    {
                        <option value="@value">@value</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Record</button>
            </div>
        </form>
    </div>
</div>

<h2>Awaiting confirmation (@Model.PendingPayments.Count)</h2>
<div class="table-responsive mb-4">
    <table class="table table-sm table-striped">
        <thead>
            <tr><th>Ref</th><th>Student</th><th>Amount</th><th>Method</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model.PendingPayments)
            {
                <tr>
                    <td>@p.ReferenceCode</td>
                    <td>@p.StudentName</td>
                    <td>@p.Amount.ToString("N3", null) @p.Currency</td>
                    <td>@p.Method</td>
                    <td class="d-flex gap-2">
                        <form method="post" asp-page-handler="Confirm">
                            <input type="hidden" name="paymentId" value="@p.Id" />
                            <button type="submit" class="btn btn-sm btn-success">Confirm</button>
                        </form>
                        <form method="post" asp-page-handler="Reject" class="d-flex gap-1">
                            <input type="hidden" name="paymentId" value="@p.Id" />
                            <input type="text" name="RejectReason" class="form-control form-control-sm" placeholder="Reason" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.PendingPayments.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">Nothing awaiting confirmation.</td></tr>
            }
        </tbody>
    </table>
</div>

<h2>Recent history</h2>
<div class="table-responsive">
    <table class="table table-sm table-striped">
        <thead>
            <tr><th>Ref</th><th>Student</th><th>Amount</th><th>Method</th><th>Status</th><th>Note</th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model.RecentPayments)
            {
                <tr>
                    <td>@p.ReferenceCode</td>
                    <td>@p.StudentName</td>
                    <td>@p.Amount.ToString("N3", null) @p.Currency</td>
                    <td>@p.Method</td>
                    <td>@p.Status</td>
                    <td>@p.RejectionReason</td>
                </tr>
            }
        </tbody>
    </table>
</div>
