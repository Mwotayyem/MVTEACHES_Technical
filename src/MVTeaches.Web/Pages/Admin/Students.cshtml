@page
@model MVTeaches.Web.Pages.Admin.StudentsModel
@using MVTeaches.Web.Display
@using MVTeaches.Domain.People
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = T["Students"].Value;
    // Server-side enforcement already lives on every OnPost handler in
    // Students.cshtml.cs — this only hides the correction forms and buttons
    // for a view-only admin so they are not shown a control that would
    // refuse them.
    var canManage = (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.StudentsManage)).Succeeded;
}

@functions {
    string StatusClass(StudentStatus status) => status switch
    {
        StudentStatus.Active => "app-status is-success",
        StudentStatus.PendingVerification or StudentStatus.PendingLevel => "app-status is-warning",
        StudentStatus.PaymentBlocked or StudentStatus.Suspended => "app-status is-danger",
        _ => "app-status is-muted",
    };
}

<div class="app-page-head">
    <div>
        <h1>@T["Students"]</h1>
        <p class="text-muted">@T["Every student the centre knows about. Open a name to see that student's whole file — guardians, level, packages, payments, sessions and attendance."]</p>
    </div>
    <div class="app-page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Dashboard">@T["Dashboard"]</a>
        @if (canManage)
        {
            <a class="btn btn-primary btn-sm" asp-page="/Admin/AssistedRegistration">@T["Register a family step by step"]</a>
        }
    </div>
</div>

<div class="app-guide">
    <p class="app-guide-title">@T["What do I do on this screen?"]</p>
    <p>@T["This screen is the register: find a student, see where they stand, and open their file. The short forms further down are for one-off corrections."]</p>
    @if (canManage)
    {
        <p>
            <span class="app-guide-next">@T["Registering a new family?"]</span>
            @T["Use"] <a asp-page="/Admin/AssistedRegistration">@T["Assisted Registration"]</a> —
            @T["it walks the whole sequence in order: guardian, student, link, level, then the package and its payment."]
        </p>
    }
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert" tabindex="-1">
        <strong>@T["Some fields still need attention"]</strong>
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

@* Owner correction 2026-09-01: the card grid read as a wall of boxes and
   was slower to scan than the table it replaced. Back to a table - but a
   table that still carries the picture the cards were added for: state
   badge, paid/billed meter, balance left, guardian, and the one action that
   actually moves this student forward. The state chips above the table are
   unchanged, and so is every handler and rule below. *@
<div class="app-toolbar">
    <div class="app-search">
        <input type="search" class="form-control" data-mv-filter="#studentRows" data-mv-filter-count="#studentsShown"
               placeholder="@T["Search by name, level, status, or guardian…"]" aria-label="@T["Search by name, level, status, or guardian…"]" />
    </div>
    <span class="text-muted small">@T["Showing"] <span id="studentsShown">@Model.VisibleStudents.Count</span> / @Model.Students.Count</span>
</div>

<div class="app-state-chips" role="group" aria-label="@T["Filter by where the student stands"]">
    <a class="app-state-chip @(Model.StateFilter is null ? "is-on" : null)" asp-page="/Admin/Students">
        @T["Everyone"] <span>@Model.Students.Count</span>
    </a>
    @foreach (var state in new[]
    {
        StudentLifecycleState.Active,
        StudentLifecycleState.StartingSoon,
        StudentLifecycleState.PaymentDue,
        StudentLifecycleState.EndingSoon,
        StudentLifecycleState.Completed,
        StudentLifecycleState.Inactive,
    })
    {
        var count = Model.StateCounts.GetValueOrDefault(state);
        <a class="app-state-chip is-@state.ToString().ToLowerInvariant() @(string.Equals(Model.StateFilter, state.ToString(), StringComparison.OrdinalIgnoreCase) ? "is-on" : null)"
           asp-page="/Admin/Students" asp-route-state="@state">
            @T["StudentLifecycleState." + state] <span>@count</span>
        </a>
    }
</div>

<div class="table-responsive mb-4">
    <table class="table app-register">
        <thead>
            <tr>
                <th scope="col">@T["Student"]</th>
                <th scope="col">@T["Level and package"]</th>
                <th scope="col">@T["Where they stand"]</th>
                <th scope="col">@T["Paid"]</th>
                <th scope="col">@T["Still owed"]</th>
                <th scope="col">@T["Balance left"]</th>
                <th scope="col">@T["Lessons ahead"]</th>
                <th scope="col">@T["Guardian"]</th>
                <th scope="col">@T["Next step"]</th>
                <th scope="col" class="text-end">@T["Actions"]</th>
            </tr>
        </thead>
        <tbody id="studentRows">
            @foreach (var student in Model.VisibleStudents)
            {
                <tr data-mv-filter-item class="@(student.NeedsAttention ? "is-attention" : null)">
                    <th scope="row">
                        <a class="app-record-link" asp-page="/Admin/StudentDetails" asp-route-id="@student.Id">
                            <span class="app-record-name">@student.FullName</span>
                            <span class="app-record-sub">@T["Student number"] @student.Id · @student.CountryName</span>
                        </a>
                    </th>
                    <td>
                        @if (student.CurrentLevelCode is null)
                        {
                            <span class="app-chip is-missing">@T["Awaiting a level"]</span>
                        }
                        else
                        {
                            <span class="app-chip is-level">@student.CurrentLevelCode</span>
                        }
                        @* Owner report 2026-09-05: a Draft package is a package.
                           This used to say "no package" on the same row whose
                           state chip said a payment was due, because only an
                           ACTIVE subscription reached this line. *@
                        @switch (student.PackageStanding)
                        {
                            case StudentPackageStanding.AwaitingPayment:
                                <div><span class="app-chip is-missing">@T["Package awaiting payment"]</span></div>
                                <div class="text-muted small">@student.PackageName</div>
                                break;
                            case StudentPackageStanding.Active:
                                <div class="text-muted small">@student.PackageName</div>
                                break;
                            case StudentPackageStanding.Finished:
                                <div class="text-muted small">@T["No package running"]</div>
                                break;
                            default:
                                <div class="text-muted small">@T["No package"]</div>
                                break;
                        }
                        @if (student.StartsOn is not null && student.ExpiresOn is not null)
                        {
                            <div class="text-muted small">@T.Date(student.StartsOn.Value) → @T.Date(student.ExpiresOn.Value)</div>
                        }
                    </td>
                    <td><span class="@StudentLifecycle.StatusClass(student.State)">@T["StudentLifecycleState." + student.State]</span></td>
                    <td>
                        @if (student.Currency is null)
                        {
                            <span class="text-muted">—</span>
                        }
                        else
                        {
                            <span class="app-cell-figure">@T.Money(student.Paid, student.Currency)</span>
                            <div class="text-muted small">@T["of"] @T.Money(student.Billed, student.Currency)</div>
                            <div class="app-meter app-meter-sm" role="img"
                                 aria-label="@T["{0}% of the billed amount has been paid.", student.PaidPercent]">
                                <span class="app-meter-fill @(student.Outstanding <= 0m ? "is-success" : "is-warning")"
                                      style="width:@(student.PaidPercent)%"></span>
                            </div>
                        }
                    </td>
                    <td>
                        @if (student.Currency is null)
                        {
                            <span class="text-muted">—</span>
                        }
                        else if (student.Outstanding > 0m)
                        {
                            <span class="app-cell-figure is-bad">@T.Money(student.Outstanding, student.Currency)</span>
                        }
                        else
                        {
                            <span class="app-status is-success">@T["Fully paid."]</span>
                        }
                    </td>
                    <td>
                        <span class="app-cell-figure">@T.Minutes(student.RemainingMinutes)</span>
                        @if (student.PurchasedMinutes > 0)
                        {
                            <div class="app-meter app-meter-sm" role="img"
                                 aria-label="@T["{0}% of the purchased time has been used.", student.UsedPercent]">
                                <span class="app-meter-fill @(student.UsedPercent >= 85 ? "is-warning" : "is-primary")"
                                      style="width:@(student.UsedPercent)%"></span>
                            </div>
                        }
                    </td>
                    <td>@student.UpcomingLessonCount</td>
                    <td>
                        @if (student.Guardians.Count > 0)
                        {
                            @foreach (var guardian in student.Guardians)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <span>@guardian.FullName</span>
                                    @* Owner decision 2026-09-04: the way out of a
                                       wrong guardian link. The reason is required
                                       by the service, not merely by this form. *@
                                    @if (canManage)
                                    {
                                        <form method="post" asp-page-handler="UnlinkGuardian" class="d-inline-flex gap-1 align-items-center">
                                            <input type="hidden" name="guardianId" value="@guardian.GuardianId" />
                                            <input type="hidden" name="studentId" value="@student.Id" />
                                            <input type="text" name="unlinkReason" class="form-control form-control-sm"
                                                   style="max-width: 12rem" placeholder="@T["Why?"]" required
                                                   aria-label="@T["Why is this guardian being unlinked?"]" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    data-mv-confirm="@T["Unlink this guardian from this student? Packages, payments and remaining hours are not affected."]">@T["Unlink"]</button>
                                        </form>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <span class="app-chip is-missing">@T["No guardian linked"]</span>
                        }
                        @* Owner decision 2026-09-04: accounts created before a
                           phone became mandatory are flagged here, never blocked
                           — the centre can see which families it cannot ring and
                           fix them one at a time. A number on EITHER the
                           student's own login or any linked guardian's counts. *@
                        @if (!student.HasReachablePhone)
                        {
                            <div><span class="app-chip is-missing">@T["Missing phone"]</span></div>
                        }
                    </td>
                    <td class="text-muted small">
                        @if (student.Status == StudentStatus.PendingVerification)
                        {
                            @T["Confirm the registration details with the family."]
                        }
                        else if (student.CurrentLevelCode is null)
                        {
                            @T["Set the level so packages can be bought."]
                        }
                        else if (student.PackageStanding == StudentPackageStanding.AwaitingPayment)
                        {
                            @T["A package is bought and waiting on its payment — confirm the money to activate it."]
                        }
                        else if (student.State == StudentLifecycleState.PaymentDue)
                        {
                            @T["Collect or confirm the outstanding amount."]
                        }
                        else if (student.State == StudentLifecycleState.EndingSoon)
                        {
                            @T["Talk to the family about renewing."]
                        }
                        else if (student.Guardians.Count == 0)
                        {
                            @T["Link a guardian so somebody can be reached."]
                        }
                        else
                        {
                            @T["Nothing needed right now."]
                        }
                    </td>
                    <td class="text-end">
                        <div class="app-row-actions">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/StudentDetails" asp-route-id="@student.Id">@T["Open file"]</a>
                            @if (student.PackageStanding == StudentPackageStanding.AwaitingPayment)
                            {
                                @* The one thing this row needs doing, as its own button. *@
                                <a class="btn btn-sm btn-primary" asp-page="/Admin/Payments" asp-route-studentId="@student.Id">@T["Take the payment"]</a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Payments" asp-route-studentId="@student.Id">@T["Payments"]</a>
                            }
                            @if (canManage && student.CurrentLevelCode is null)
                            {
                                <a class="btn btn-sm btn-primary" asp-page="/Admin/Students" asp-route-studentId="@student.Id" asp-fragment="assign-level">@T["Set the level now"]</a>
                            }
                            @if (canManage && student.Guardians.Count == 0)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Students" asp-route-studentId="@student.Id" asp-fragment="link-guardian">@T["Link a guardian"]</a>
                            }
                            @if (canManage && student.Status == StudentStatus.PendingVerification)
                            {
                                @* Renamed 2026-09-01. It used to read "Mark verified", which said
                                   nothing about WHAT was being verified - the person, the account,
                                   the phone, or the paperwork. It is the registration details:
                                   StudentStatus goes PendingVerification -> PendingLevel, which is
                                   the step that lets a level be assigned. Same handler, same
                                   service call, same single status change. *@
                                <form method="post" asp-page-handler="Verify" class="d-inline">
                                    <input type="hidden" name="studentId" value="@student.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                            title="@T["The centre has contacted the family and checked the name, phone number and date of birth. This does not assign a level and does not touch any payment."]"
                                            data-mv-confirm="@T["Confirm this student's registration details are correct?"]">@T["Confirm registration details"]</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Students.Count == 0)
            {
                <tr><td colspan="10">
                    <div class="app-empty">
                        <strong>@T["No students registered yet."]</strong>
                        <span>@T["Start with a guardian, then the student — the assisted registration screen does both in order."]</span>
                        @if (canManage)
                        {
                            <span><a class="btn btn-primary btn-sm mt-2" asp-page="/Admin/AssistedRegistration">@T["Register a family step by step"]</a></span>
                        }
                    </div>
                </td></tr>
            }
            else if (Model.VisibleStudents.Count == 0)
            {
                <tr><td colspan="10">
                    <div class="app-empty">
                        <strong>@T["No student is in that state right now."]</strong>
                        <span><a class="btn btn-sm btn-outline-primary mt-2" asp-page="/Admin/Students">@T["Everyone"]</a></span>
                    </div>
                </td></tr>
            }
            <tr data-mv-filter-empty="true" hidden>
                <td colspan="10">
                    <div class="app-empty">@T["No student matches this search — try part of the name instead."]</div>
                </td>
            </tr>
        </tbody>
    </table>
</div>

@if (canManage)
{
<h2>@T["Single corrections"]</h2>
<p class="text-muted">@T["Use these only for a one-off fix on somebody who already exists. A brand-new family belongs in assisted registration, which keeps the whole sequence in order."]</p>

@if (Model.FocusStudentName is not null)
{
    <div class="alert alert-info d-flex flex-wrap gap-2 align-items-center" role="status">
        <span>@T["The forms below are pre-filled for:"] <strong>@Model.FocusStudentName</strong></span>
        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Students">@T["Clear"]</a>
        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/StudentDetails" asp-route-id="@Model.FocusStudentId">@T["Open file"]</a>
    </div>
}

@*
    UX pass (2026-09-03, owner-requested nav/screen simplification): these four
    forms used to sit as four equally-loud cards in two rows — a one-off "set
    this student's level" errand looked exactly as important as "register a
    brand-new guardian," which the owner reported as confusing. An accordion
    (plain Bootstrap, already loaded — no new library) keeps every form
    exactly as it was: same handler, same asp-for bindings, same validation —
    only which ones are visible at once has changed. "Set or change a level"
    (the most common single correction, and the one the owner specifically
    asked to make clearer) opens by default; the other three start collapsed
    behind their own header. The existing #assign-level / #link-guardian deep
    links from AssistedRegistration, Schedules, and StudentDetails still work
    unchanged — those ids are untouched — and wireHashAccordion() in site.js
    (progressive enhancement, degrades to "assign-level open" with JS off)
    opens whichever section the link actually pointed at.
*@
<div class="accordion mb-4" id="studentCorrectionsAccordion">
    <div class="accordion-item">
        <h3 class="accordion-header" id="assign-level-heading">
            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                    data-bs-target="#assign-level" aria-expanded="true" aria-controls="assign-level">
                @T["Set or change a student's level"]
            </button>
        </h3>
        <div id="assign-level" class="accordion-collapse collapse show" aria-labelledby="assign-level-heading" data-bs-parent="#studentCorrectionsAccordion">
            <div class="accordion-body">
                <p class="text-muted small">@T["A student cannot buy any package before a level is set. Normally the level comes from the placement test the student takes themselves; setting it here is an explicit, recorded override."]</p>
                <form method="post" asp-page-handler="AssignLevel">
                    <div class="mb-2">
                        <label class="form-label" asp-for="LevelAssignment.StudentId">@T["Student"]<span class="app-required">*</span></label>
                        <input type="search" class="form-control mb-1" data-mv-select-filter="#levelStudent"
                               placeholder="@T["Search by name…"]" aria-label="@T["Search by name…"]" />
                        <select asp-for="LevelAssignment.StudentId" id="levelStudent" class="form-select">
                            <option value="">@T["Select placeholder"]</option>
                            @foreach (var student in Model.Students)
                            {
                                <option value="@student.Id">@Model.PickerLabel(student)</option>
                            }
                        </select>
                        <span asp-validation-for="LevelAssignment.StudentId" class="text-danger small"></span>
                    </div>
                    @* Owner decision 2026-09-04: a level belongs to a course, so
                       the course is asked for first and is never defaulted - a
                       silent default would write the level into the wrong ladder. *@
                    <div class="mb-2">
                        <label class="form-label" asp-for="LevelAssignment.CourseId">@T["Course"]<span class="app-required">*</span></label>
                        <select asp-for="LevelAssignment.CourseId" class="form-select">
                            <option value="">@T["Select placeholder"]</option>
                            @foreach (var course in Model.Courses)
                            {
                                <option value="@course.Id">@course.NameEn</option>
                            }
                        </select>
                        <div class="form-text">@T["A student can hold a different level in each course."]</div>
                        <span asp-validation-for="LevelAssignment.CourseId" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="LevelAssignment.LevelId">@T["Level"]<span class="app-required">*</span></label>
                        <select asp-for="LevelAssignment.LevelId" class="form-select">
                            <option value="">@T["Select placeholder"]</option>
                            @foreach (var level in Model.Levels)
                            {
                                <option value="@level.Id">@level.Code — @Model.DisplayLevel(level)</option>
                            }
                        </select>
                        <span asp-validation-for="LevelAssignment.LevelId" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="LevelAssignment.Reason">@T["Why this level?"]<span class="app-required">*</span></label>
                        <input asp-for="LevelAssignment.Reason" class="form-control" placeholder="@T["e.g. interview result, or a transfer from another centre"]" />
                        <div class="form-text">@T["Kept on the student's level history — write what an auditor would need to understand this decision."]</div>
                        <span asp-validation-for="LevelAssignment.Reason" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">@T["Set the level"]</button>
                    <div class="app-outcome mt-3">@T["After this, the student can buy any package published for that level."]</div>
                </form>
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h3 class="accordion-header" id="link-guardian-heading">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#link-guardian" aria-expanded="false" aria-controls="link-guardian">
                @T["Link a guardian to a student"]
            </button>
        </h3>
        <div id="link-guardian" class="accordion-collapse collapse" aria-labelledby="link-guardian-heading" data-bs-parent="#studentCorrectionsAccordion">
            <div class="accordion-body">
                <p class="text-muted small">@T["Pick both by name — start typing to narrow a long list."]</p>
                <form method="post" asp-page-handler="LinkGuardian">
                    <div class="mb-2">
                        <label class="form-label" asp-for="Link.StudentId">@T["Student"]<span class="app-required">*</span></label>
                        <input type="search" class="form-control mb-1" data-mv-select-filter="#linkStudent"
                               placeholder="@T["Search by name…"]" aria-label="@T["Search by name…"]" />
                        <select asp-for="Link.StudentId" id="linkStudent" class="form-select">
                            <option value="">@T["Select placeholder"]</option>
                            @foreach (var student in Model.Students)
                            {
                                <option value="@student.Id">@Model.PickerLabel(student)</option>
                            }
                        </select>
                        <span asp-validation-for="Link.StudentId" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="Link.GuardianId">@T["Guardian"]<span class="app-required">*</span></label>
                        <input type="search" class="form-control mb-1" data-mv-select-filter="#linkGuardian"
                               placeholder="@T["Search by name…"]" aria-label="@T["Search by name…"]" />
                        <select asp-for="Link.GuardianId" id="linkGuardian" class="form-select">
                            <option value="">@T["Select placeholder"]</option>
                            @foreach (var guardian in Model.Guardians)
                            {
                                <option value="@guardian.Id">@guardian.FullName</option>
                            }
                        </select>
                        <span asp-validation-for="Link.GuardianId" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="Link.Relationship">@T["Relationship"]</label>
                        <select asp-for="Link.Relationship" class="form-select">
                            @foreach (var value in Enum.GetValues<GuardianRelationship>())
                            {
                                <option value="@value">@T["GuardianRelationship." + value]</option>
                            }
                        </select>
                    </div>
                    <div class="form-check mb-2">
                        <input asp-for="Link.IsPrimary" class="form-check-input" />
                        <label class="form-check-label" asp-for="Link.IsPrimary">@T["This is the main guardian"]</label>
                    </div>
                    <button type="submit" class="btn btn-primary">@T["Link"]</button>
                    <div class="app-outcome mt-3">@T["A linked guardian can see this student and pay for their packages."]</div>
                </form>
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h3 class="accordion-header" id="register-guardian-heading">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#register-guardian" aria-expanded="false" aria-controls="register-guardian">
                @T["Register a guardian only"]
            </button>
        </h3>
        <div id="register-guardian" class="accordion-collapse collapse" aria-labelledby="register-guardian-heading" data-bs-parent="#studentCorrectionsAccordion">
            <div class="accordion-body">
                <p class="text-muted small">@T["A guardian always signs in with an email and a password. Give them a temporary one; they change it after the first sign-in."]</p>
                <form method="post" asp-page-handler="RegisterGuardian">
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewGuardian.FullName">@T["Full name"]<span class="app-required">*</span></label>
                        <input asp-for="NewGuardian.FullName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="NewGuardian.FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewGuardian.PhoneNumber">@T["Phone number"]<span class="app-required">*</span></label>
                        <input asp-for="NewGuardian.PhoneNumber" type="tel" class="form-control" autocomplete="off" />
                        <div class="form-text">@T["The number the centre calls about this family. Include the country code."]</div>
                        <span asp-validation-for="NewGuardian.PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewGuardian.Email">@T["Email"]<span class="app-required">*</span></label>
                        <input asp-for="NewGuardian.Email" class="form-control" autocomplete="off" />
                        <span asp-validation-for="NewGuardian.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewGuardian.Password">@T["Temporary password"]<span class="app-required">*</span></label>
                        <input asp-for="NewGuardian.Password" type="password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">@T["At least 8 characters. The guardian can change it after signing in."]</div>
                        <span asp-validation-for="NewGuardian.Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">@T["Register guardian"]</button>
                </form>
            </div>
        </div>
    </div>

    <div class="accordion-item">
        <h3 class="accordion-header" id="register-student-heading">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#register-student" aria-expanded="false" aria-controls="register-student">
                @T["Register a student only"]
            </button>
        </h3>
        <div id="register-student" class="accordion-collapse collapse" aria-labelledby="register-student-heading" data-bs-parent="#studentCorrectionsAccordion">
            <div class="accordion-body">
                <p class="text-muted small">@T["Most children have no sign-in of their own: leave the last two fields empty and the child is reached entirely through their guardian's account."]</p>
                <form method="post" asp-page-handler="RegisterStudent">
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewStudent.FullName">@T["Full name"]<span class="app-required">*</span></label>
                        <input asp-for="NewStudent.FullName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="NewStudent.FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewStudent.CountryId">@T["Country"]<span class="app-required">*</span></label>
                        <select asp-for="NewStudent.CountryId" class="form-select">
                            <option value="">@T["Select placeholder"]</option>
                            @foreach (var country in Model.Countries)
                            {
                                <option value="@country.Id">@Model.DisplayCountry(country)</option>
                            }
                        </select>
                        <span asp-validation-for="NewStudent.CountryId" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewStudent.DateOfBirth">@T["Date of birth"]<span class="app-required">*</span></label>
                        <input asp-for="NewStudent.DateOfBirth" type="date" class="form-control" />
                        <div class="form-text">@T["Used to pick the right age group for sessions."]</div>
                        <span asp-validation-for="NewStudent.DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="app-outcome mb-3">@T["A child with no email of their own signs in through their guardian — the guardian's account is what opens the session. Fill the two fields below only for an adult student, or an older student who really will sign in alone."]</div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewStudent.LoginEmail">@T["Sign-in email (only if the student signs in alone)"]</label>
                        <input asp-for="NewStudent.LoginEmail" class="form-control" autocomplete="off" />
                        <span asp-validation-for="NewStudent.LoginEmail" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewStudent.LoginPassword">@T["Sign-in password (only if the student signs in alone)"]</label>
                        <input asp-for="NewStudent.LoginPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewStudent.LoginPassword" class="text-danger small"></span>
                    </div>
                    @* Owner decision 2026-09-04: required only alongside a login -
                       see RegisterStudentInput.PhoneNumber for why. *@
                    <div class="mb-3">
                        <label class="form-label" asp-for="NewStudent.PhoneNumber">@T["Phone number (required if the student signs in alone)"]</label>
                        <input asp-for="NewStudent.PhoneNumber" type="tel" class="form-control" autocomplete="off" />
                        <span asp-validation-for="NewStudent.PhoneNumber" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">@T["Register student"]</button>
                </form>
            </div>
        </div>
    </div>
</div>
}
else
{
    <p class="text-muted small">@T["You have view-only access to students and cannot register a guardian or a student, link a guardian, assign a level, or confirm registration details."]</p>
}
