@page
@model MVTeaches.Web.Pages.Admin.StudentsModel
@using MVTeaches.Domain.People
@{
    ViewData["Title"] = T["Students"].Value;
}

@functions {
    string StatusClass(StudentStatus status) => status switch
    {
        StudentStatus.Active => "app-status is-success",
        StudentStatus.PendingVerification or StudentStatus.PendingLevel => "app-status is-warning",
        StudentStatus.PaymentBlocked or StudentStatus.Suspended => "app-status is-danger",
        _ => "app-status is-muted",
    };
}

<div class="app-page-head">
    <div>
        <h1>@T["Students"]</h1>
        <p class="text-muted">@T["Every student the centre knows about. Open a name to see that student's whole file — guardians, level, packages, payments, sessions and attendance."]</p>
    </div>
    <div class="app-page-actions">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Dashboard">@T["Dashboard"]</a>
        <a class="btn btn-primary btn-sm" asp-page="/Admin/AssistedRegistration">@T["Register a family step by step"]</a>
    </div>
</div>

<div class="app-guide">
    <p class="app-guide-title">@T["What do I do on this screen?"]</p>
    <p>@T["This screen is the register: find a student, see where they stand, and open their file. The short forms further down are for one-off corrections."]</p>
    <p>
        <span class="app-guide-next">@T["Registering a new family?"]</span>
        @T["Use"] <a asp-page="/Admin/AssistedRegistration">@T["Assisted Registration"]</a> —
        @T["it walks the whole sequence in order: guardian, student, link, level, then the package and its payment."]
    </p>
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert" tabindex="-1">
        <strong>@T["Some fields still need attention"]</strong>
        <div asp-validation-summary="All" class="mb-0"></div>
    </div>
}

<div class="app-toolbar">
    <div class="app-search">
        <input type="search" class="form-control" data-mv-filter="#studentsTable" data-mv-filter-count="#studentsShown"
               placeholder="@T["Search by name, level, status, or guardian…"]" aria-label="@T["Search by name, level, status, or guardian…"]" />
    </div>
    <span class="text-muted small">@T["Showing"] <span id="studentsShown">@Model.Students.Count</span> / @Model.Students.Count</span>
</div>
<div class="table-responsive mb-4">
    <table class="table table-sm table-striped" id="studentsTable">
        <thead>
            <tr>
                <th>@T["Name"]</th>
                <th>@T["Country"]</th>
                <th>@T["Status"]</th>
                <th>@T["Level"]</th>
                <th>@T["Guardians"]</th>
                <th>@T["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.Students)
            {
                <tr>
                    <td><a class="fw-bold" asp-page="/Admin/StudentDetails" asp-route-id="@student.Id">@student.FullName</a></td>
                    <td>@student.CountryName</td>
                    <td><span class="@StatusClass(student.Status)">@T["StudentStatus." + student.Status]</span></td>
                    <td>
                        @if (student.CurrentLevelCode is null)
                        {
                            <span class="app-status is-warning">@T["Awaiting a level"]</span>
                        }
                        else
                        {
                            @student.CurrentLevelCode
                        }
                    </td>
                    <td>@(student.GuardianNames.Count > 0 ? string.Join("، ", student.GuardianNames) : T["Not specified"].Value)</td>
                    <td>
                        <div class="d-flex gap-1 flex-wrap align-items-center">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/StudentDetails" asp-route-id="@student.Id">@T["Open file"]</a>
                            @if (student.CurrentLevelCode is null)
                            {
                                <a class="btn btn-sm btn-primary" asp-page="/Admin/Students" asp-route-studentId="@student.Id" asp-fragment="assign-level">@T["Set the level now"]</a>
                            }
                            @if (student.GuardianNames.Count == 0)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/Students" asp-route-studentId="@student.Id" asp-fragment="link-guardian">@T["Link a guardian"]</a>
                            }
                            @if (student.Status == StudentStatus.PendingVerification)
                            {
                                <form method="post" asp-page-handler="Verify" class="d-inline">
                                    <input type="hidden" name="studentId" value="@student.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                            data-mv-confirm="@T["Mark this student as verified?"]">@T["Mark verified"]</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            <tr data-mv-filter-empty="true" hidden>
                <td colspan="6" class="text-muted">@T["No student matches this search — try part of the name instead."]</td>
            </tr>
            @if (Model.Students.Count == 0)
            {
                <tr>
                    <td colspan="6">
                        <div class="app-empty">
                            <strong>@T["No students registered yet."]</strong>
                            <span>@T["Start with a guardian, then the student — the assisted registration screen does both in order."]</span>
                            <span><a class="btn btn-primary btn-sm mt-2" asp-page="/Admin/AssistedRegistration">@T["Register a family step by step"]</a></span>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2>@T["Single corrections"]</h2>
<p class="text-muted">@T["Use these only for a one-off fix on somebody who already exists. A brand-new family belongs in assisted registration, which keeps the whole sequence in order."]</p>

@if (Model.FocusStudentName is not null)
{
    <div class="alert alert-info d-flex flex-wrap gap-2 align-items-center" role="status">
        <span>@T["The forms below are pre-filled for:"] <strong>@Model.FocusStudentName</strong></span>
        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Students">@T["Clear"]</a>
        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/StudentDetails" asp-route-id="@Model.FocusStudentId">@T["Open file"]</a>
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-6" id="assign-level">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="card-title h5">@T["Set or change a student's level"]</h3>
                <p class="text-muted small">@T["A student cannot buy any package before a level is set. Normally the level comes from the placement test the student takes themselves; setting it here is an explicit, recorded override."]</p>
                <form method="post" asp-page-handler="AssignLevel">
                    <div class="mb-2">
                        <label class="form-label" asp-for="LevelAssignment.StudentId">@T["Student"]<span class="app-required">*</span></label>
                        <input type="search" class="form-control mb-1" data-mv-select-filter="#levelStudent"
                               placeholder="@T["Search by name…"]" aria-label="@T["Search by name…"]" />
                        <select asp-for="LevelAssignment.StudentId" id="levelStudent" class="form-select">
                            <option value="">@T["Select placeholder"]</option>
                            @foreach (var student in Model.Students)
                            {
                                <option value="@student.Id">@Model.PickerLabel(student)</option>
                            }
                        </select>
                        <span asp-validation-for="LevelAssignment.StudentId" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="LevelAssignment.LevelId">@T["Level"]<span class="app-required">*</span></label>
                        <select asp-for="LevelAssignment.LevelId" class="form-select">
                            <option value="">@T["Select placeholder"]</option>
                            @foreach (var level in Model.Levels)
                            {
                                <option value="@level.Id">@level.Code — @Model.DisplayLevel(level)</option>
                            }
                        </select>
                        <span asp-validation-for="LevelAssignment.LevelId" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="LevelAssignment.Reason">@T["Why this level?"]<span class="app-required">*</span></label>
                        <input asp-for="LevelAssignment.Reason" class="form-control" placeholder="@T["e.g. interview result, or a transfer from another centre"]" />
                        <div class="form-text">@T["Kept on the student's level history — write what an auditor would need to understand this decision."]</div>
                        <span asp-validation-for="LevelAssignment.Reason" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">@T["Set the level"]</button>
                    <div class="app-outcome mt-3">@T["After this, the student can buy any package published for that level."]</div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6" id="link-guardian">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="card-title h5">@T["Link a guardian to a student"]</h3>
                <p class="text-muted small">@T["Pick both by name — start typing to narrow a long list."]</p>
                <form method="post" asp-page-handler="LinkGuardian">
                    <div class="mb-2">
                        <label class="form-label" asp-for="Link.StudentId">@T["Student"]<span class="app-required">*</span></label>
                        <input type="search" class="form-control mb-1" data-mv-select-filter="#linkStudent"
                               placeholder="@T["Search by name…"]" aria-label="@T["Search by name…"]" />
                        <select asp-for="Link.StudentId" id="linkStudent" class="form-select">
                            <option value="">@T["Select placeholder"]</option>
                            @foreach (var student in Model.Students)
                            {
                                <option value="@student.Id">@Model.PickerLabel(student)</option>
                            }
                        </select>
                        <span asp-validation-for="Link.StudentId" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="Link.GuardianId">@T["Guardian"]<span class="app-required">*</span></label>
                        <input type="search" class="form-control mb-1" data-mv-select-filter="#linkGuardian"
                               placeholder="@T["Search by name…"]" aria-label="@T["Search by name…"]" />
                        <select asp-for="Link.GuardianId" id="linkGuardian" class="form-select">
                            <option value="">@T["Select placeholder"]</option>
                            @foreach (var guardian in Model.Guardians)
                            {
                                <option value="@guardian.Id">@guardian.FullName</option>
                            }
                        </select>
                        <span asp-validation-for="Link.GuardianId" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="Link.Relationship">@T["Relationship"]</label>
                        <select asp-for="Link.Relationship" class="form-select">
                            @foreach (var value in Enum.GetValues<GuardianRelationship>())
                            {
                                <option value="@value">@T["GuardianRelationship." + value]</option>
                            }
                        </select>
                    </div>
                    <div class="form-check mb-2">
                        <input asp-for="Link.IsPrimary" class="form-check-input" />
                        <label class="form-check-label" asp-for="Link.IsPrimary">@T["This is the main guardian"]</label>
                    </div>
                    <button type="submit" class="btn btn-primary">@T["Link"]</button>
                    <div class="app-outcome mt-3">@T["A linked guardian can see this student and pay for their packages."]</div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6" id="register-guardian">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="card-title h5">@T["Register a guardian only"]</h3>
                <p class="text-muted small">@T["A guardian always signs in with an email and a password. Give them a temporary one; they change it after the first sign-in."]</p>
                <form method="post" asp-page-handler="RegisterGuardian">
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewGuardian.FullName">@T["Full name"]<span class="app-required">*</span></label>
                        <input asp-for="NewGuardian.FullName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="NewGuardian.FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewGuardian.Email">@T["Email"]<span class="app-required">*</span></label>
                        <input asp-for="NewGuardian.Email" class="form-control" autocomplete="off" />
                        <span asp-validation-for="NewGuardian.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewGuardian.Password">@T["Temporary password"]<span class="app-required">*</span></label>
                        <input asp-for="NewGuardian.Password" type="password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">@T["At least 8 characters. The guardian can change it after signing in."]</div>
                        <span asp-validation-for="NewGuardian.Password" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">@T["Register guardian"]</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6" id="register-student">
        <div class="card h-100">
            <div class="card-body">
                <h3 class="card-title h5">@T["Register a student only"]</h3>
                <p class="text-muted small">@T["Most children have no sign-in of their own: leave the last two fields empty and the child is reached entirely through their guardian's account."]</p>
                <form method="post" asp-page-handler="RegisterStudent">
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewStudent.FullName">@T["Full name"]<span class="app-required">*</span></label>
                        <input asp-for="NewStudent.FullName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="NewStudent.FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewStudent.CountryId">@T["Country"]<span class="app-required">*</span></label>
                        <select asp-for="NewStudent.CountryId" class="form-select">
                            <option value="">@T["Select placeholder"]</option>
                            @foreach (var country in Model.Countries)
                            {
                                <option value="@country.Id">@Model.DisplayCountry(country)</option>
                            }
                        </select>
                        <span asp-validation-for="NewStudent.CountryId" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewStudent.DateOfBirth">@T["Date of birth"]<span class="app-required">*</span></label>
                        <input asp-for="NewStudent.DateOfBirth" type="date" class="form-control" />
                        <div class="form-text">@T["Used to pick the right age group for sessions."]</div>
                        <span asp-validation-for="NewStudent.DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="app-outcome mb-3">@T["A child with no email of their own signs in through their guardian — the guardian's account is what opens the session. Fill the two fields below only for an adult student, or an older student who really will sign in alone."]</div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewStudent.LoginEmail">@T["Sign-in email (only if the student signs in alone)"]</label>
                        <input asp-for="NewStudent.LoginEmail" class="form-control" autocomplete="off" />
                        <span asp-validation-for="NewStudent.LoginEmail" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" asp-for="NewStudent.LoginPassword">@T["Sign-in password (only if the student signs in alone)"]</label>
                        <input asp-for="NewStudent.LoginPassword" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewStudent.LoginPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">@T["Register student"]</button>
                </form>
            </div>
        </div>
    </div>
</div>
