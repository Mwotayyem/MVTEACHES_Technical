@page
@model MVTeaches.Web.Pages.Admin.AdminUsersModel
@{
    ViewData["Title"] = T["Admin accounts and permissions"].Value;
}

<div class="app-page-head">
    <div>
        <h1>@T["Admin accounts and permissions"]</h1>
        <p class="text-muted">@T["Only a SystemAdmin account can open this page. A plain Admin starts with no permissions at all — grant exactly what each one needs, screen by screen."]</p>
    </div>
</div>

@* Owner decision 2026-09-04: the checkboxes below were already accurate, but
   nothing on the page said what the two SUFFIXES mean, so a SystemAdmin had to
   infer the rule from the labels. This states it once, plainly. It documents
   the behaviour that is already enforced - it does not change it. *@
<div class="alert alert-info">
    <strong>@T["How these permissions work"]</strong>
    <ul class="mb-0 mt-2 small">
        <li>@T["No permission ticked for a screen: the admin does not see it in the menu and cannot open it, even with a direct link."]</li>
        <li>@T["\"View\" only: the admin can open the screen and read it, but every button that changes data is refused by the server, not merely hidden."]</li>
        <li>@T["\"Manage\", \"Confirm\", or \"Approve\": the admin can carry out that specific action. These are separate on purpose — someone may read payments without being able to confirm money."]</li>
        <li>@T["A SystemAdmin always has everything, and is not affected by these ticks."]</li>
    </ul>
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
<div asp-validation-summary="All" class="text-danger"></div>

<div class="card mb-4" style="max-width: 32rem;">
    <div class="card-body">
        <h2 class="card-title h5">@T["Create a new Admin account"]</h2>
        <p class="text-muted small">@T["Never SystemAdmin — this screen creates a plain Admin only. Who holds SystemAdmin is decided outside this app."]</p>
        <form method="post" asp-page-handler="CreateAdmin">
            <div class="mb-3">
                <label class="form-label" asp-for="NewAdmin.Email">@T["Email"]</label>
                <input asp-for="NewAdmin.Email" class="form-control" autocomplete="off" />
                <span asp-validation-for="NewAdmin.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="NewAdmin.Password">@T["Temporary password"]</label>
                <input asp-for="NewAdmin.Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewAdmin.Password" class="text-danger"></span>
                <div class="form-text">@T["Tell this password to the new admin through a separate, secure channel — never write it here or in a chat message. They must open \"Change password\" after their first sign-in."]</div>
            </div>
            <button type="submit" class="btn btn-primary">@T["Create Admin account"]</button>
        </form>
    </div>
</div>

<h2 class="h5">@T["Existing Admin accounts"]</h2>
@if (Model.Admins.Count == 0)
{
    <p class="text-muted">@T["No plain Admin accounts yet."]</p>
}
else
{
    @foreach (var admin in Model.Admins)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h3 class="card-title h6">@admin.Email</h3>
                <form method="post" asp-page-handler="SavePermissions">
                    <input type="hidden" name="EditingAdminId" value="@admin.Id" />

                    <div class="mb-2">
                        <strong class="small">@T["Payments"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Payments.View" id="perm-@admin.Id-pv"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Payments.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-pv">@T["View payments"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Payments.Confirm" id="perm-@admin.Id-pc"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Payments.Confirm")" />
                            <label class="form-check-label" for="perm-@admin.Id-pc">@T["Confirm, reject, or record payments"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Payments.Manage" id="perm-@admin.Id-pm"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Payments.Manage")" />
                            <label class="form-check-label" for="perm-@admin.Id-pm">@T["Manage payment methods"]</label>
                            @* Owner decision 2026-09-04: /Admin/PaymentMethods left the
                               menu, so this tick no longer produces a visible link. It
                               still governs the page itself. Say so, or it reads as broken. *@
                            <div class="form-text">@T["The payment-methods screen is no longer in the menu while payments are collected manually — this permission still controls it if it is opened by its direct link."]</div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <strong class="small">@T["Payroll"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Payroll.View" id="perm-@admin.Id-rv"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Payroll.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-rv">@T["View payroll"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Payroll.Approve" id="perm-@admin.Id-ra"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Payroll.Approve")" />
                            <label class="form-check-label" for="perm-@admin.Id-ra">@T["Verify, approve, and close payroll"]</label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <strong class="small">@T["Subscriptions"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Subscriptions.View" id="perm-@admin.Id-sv"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Subscriptions.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-sv">@T["View subscriptions"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Subscriptions.Manage" id="perm-@admin.Id-sm"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Subscriptions.Manage")" />
                            <label class="form-check-label" for="perm-@admin.Id-sm">@T["Create, purchase, or grant subscriptions"]</label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <strong class="small">@T["Students"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Students.View" id="perm-@admin.Id-tv"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Students.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-tv">@T["View the student register and student files"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Students.Manage" id="perm-@admin.Id-tm"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Students.Manage")" />
                            <label class="form-check-label" for="perm-@admin.Id-tm">@T["Register, link, assign levels, confirm registration, and assisted registration"]</label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <strong class="small">@T["Student notes"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.StudentNotes.View" id="perm-@admin.Id-nv"
                                   checked="@admin.GrantedPermissions.Contains("Admin.StudentNotes.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-nv">@T["View the written notes on a student's file"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.StudentNotes.Manage" id="perm-@admin.Id-nm"
                                   checked="@admin.GrantedPermissions.Contains("Admin.StudentNotes.Manage")" />
                            <label class="form-check-label" for="perm-@admin.Id-nm">@T["Add a written note to a student's file"]</label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <strong class="small">@T["Teachers"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Teachers.View" id="perm-@admin.Id-tev"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Teachers.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-tev">@T["View teachers, pay rates, and allowed levels"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Teachers.Manage" id="perm-@admin.Id-tem"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Teachers.Manage")" />
                            <label class="form-check-label" for="perm-@admin.Id-tem">@T["Register teachers, set pay rates, manage allowed levels, and deactivate/reactivate them"]</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong class="small">@T["Schedules"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Schedules.View" id="perm-@admin.Id-scv"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Schedules.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-scv">@T["View weekly classes, upcoming sessions, and rosters"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Schedules.Manage" id="perm-@admin.Id-scm"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Schedules.Manage")" />
                            <label class="form-check-label" for="perm-@admin.Id-scm">@T["Create, enroll, cancel, reassign, pause/resume, reschedule, and approve make-up lessons"]</label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <strong class="small">@T["Compensation"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Compensation.View" id="perm-@admin.Id-cov"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Compensation.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-cov">@T["View make-up (compensation) requests"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Compensation.Manage" id="perm-@admin.Id-com"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Compensation.Manage")" />
                            <label class="form-check-label" for="perm-@admin.Id-com">@T["Approve or reject a make-up (compensation) request"]</label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <strong class="small">@T["Placement Tests"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.PlacementTests.View" id="perm-@admin.Id-ptv"
                                   checked="@admin.GrantedPermissions.Contains("Admin.PlacementTests.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-ptv">@T["View placement tests, questions, score bands, and retake requests"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.PlacementTests.Manage" id="perm-@admin.Id-ptm"
                                   checked="@admin.GrantedPermissions.Contains("Admin.PlacementTests.Manage")" />
                            <label class="form-check-label" for="perm-@admin.Id-ptm">@T["Create, edit, publish, or activate a placement test, and decide retake requests"]</label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <strong class="small">@T["Certificates"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Certificates.View" id="perm-@admin.Id-crv"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Certificates.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-crv">@T["View student progress and issued certificates"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Certificates.Manage" id="perm-@admin.Id-crm"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Certificates.Manage")" />
                            <label class="form-check-label" for="perm-@admin.Id-crm">@T["Issue or revoke a certificate"]</label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <strong class="small">@T["Dashboard"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Dashboard.View" id="perm-@admin.Id-dbv"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Dashboard.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-dbv">@T["View the dashboard"]</label>
                        </div>
                    </div>

                    <div class="mb-2">
                        <strong class="small">@T["Financial Report"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.FinancialReport.View" id="perm-@admin.Id-frv"
                                   checked="@admin.GrantedPermissions.Contains("Admin.FinancialReport.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-frv">@T["View the financial report"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.FinancialReport.Manage" id="perm-@admin.Id-frm"
                                   checked="@admin.GrantedPermissions.Contains("Admin.FinancialReport.Manage")" />
                            <label class="form-check-label" for="perm-@admin.Id-frm">@T["Record a running cost"]</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong class="small">@T["Offer posters"]</strong>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Posters.View" id="perm-@admin.Id-pov"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Posters.View")" />
                            <label class="form-check-label" for="perm-@admin.Id-pov">@T["View offer posters"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="Granted" value="Admin.Posters.Manage" id="perm-@admin.Id-pom"
                                   checked="@admin.GrantedPermissions.Contains("Admin.Posters.Manage")" />
                            <label class="form-check-label" for="perm-@admin.Id-pom">@T["Create, edit, show, or hide a poster"]</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-outline-primary btn-sm">@T["Save permissions"]</button>
                </form>
            </div>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
