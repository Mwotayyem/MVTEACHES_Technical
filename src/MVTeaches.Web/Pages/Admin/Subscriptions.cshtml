@page
@model MVTeaches.Web.Pages.Admin.SubscriptionsModel
@using MVTeaches.Domain.Catalog
@using MVTeaches.Domain.Subscriptions
@{
    ViewData["Title"] = "Subscriptions";
}

<h1>Pricing plans &amp; subscriptions</h1>
<p class="text-muted">§23/§19.2/D-13/D-38 — the "purchase" half of purchase-and-payment. A subscription purchased here stays <strong>Draft</strong> until the matching payment is recorded and confirmed on <a asp-page="/Admin/Payments">/Admin/Payments</a>, which activates it and posts the ledger entry — that step already exists and is tested. An admin-granted subscription (no payment) activates immediately.</p>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Create a pricing plan</h5>
                <form method="post" asp-page-handler="CreatePlan">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label" asp-for="NewPlan.CountryId">Country</label>
                            <select asp-for="NewPlan.CountryId" class="form-select">
                                <option value="">-- select --</option>
                                @foreach (var c in Model.Countries)
                                {
                                    <option value="@c.Id">@c.NameEn (@c.CurrencyCode)</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label" asp-for="NewPlan.CourseId">Course</label>
                            <select asp-for="NewPlan.CourseId" class="form-select">
                                <option value="">-- select --</option>
                                @foreach (var c in Model.Courses)
                                {
                                    <option value="@c.Id">@c.NameEn</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label" asp-for="NewPlan.LevelId">Level (blank = every level)</label>
                            <select asp-for="NewPlan.LevelId" class="form-select">
                                <option value="">-- any level --</option>
                                @foreach (var l in Model.Levels)
                                {
                                    <option value="@l.Id">@l.Code</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label" asp-for="NewPlan.SessionType">Session type</label>
                            <select asp-for="NewPlan.SessionType" class="form-select">
                                @foreach (var v in Enum.GetValues<SessionType>())
                                {
                                    <option value="@v">@v</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label" asp-for="NewPlan.SessionsCount">Sessions</label>
                            <input asp-for="NewPlan.SessionsCount" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" asp-for="NewPlan.MinutesTotal">Minutes total</label>
                            <input asp-for="NewPlan.MinutesTotal" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" asp-for="NewPlan.Amount">Amount</label>
                            <input asp-for="NewPlan.Amount" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" asp-for="NewPlan.Currency">Currency</label>
                            <input asp-for="NewPlan.Currency" class="form-control" placeholder="JOD" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" asp-for="NewPlan.ValidityDays">Validity (days)</label>
                            <input asp-for="NewPlan.ValidityDays" class="form-control" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Create plan</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6 d-flex flex-column gap-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Purchase a subscription from a plan</h5>
                <form method="post" asp-page-handler="Purchase" class="row g-2">
                    <div class="col-6">
                        <label class="form-label" asp-for="Purchase.StudentId">Student</label>
                        <select asp-for="Purchase.StudentId" class="form-select">
                            <option value="">-- select --</option>
                            @foreach (var s in Model.Students)
                            {
                                <option value="@s.Id">@s.FullName (#@s.Id)</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" asp-for="Purchase.PricingPlanId">Plan</label>
                        <select asp-for="Purchase.PricingPlanId" class="form-select">
                            <option value="">-- select --</option>
                            @foreach (var p in Model.Plans)
                            {
                                <option value="@p.Id">#@p.Id @p.CourseName @(p.LevelCode ?? "any") — @p.Amount @p.Currency</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" asp-for="Purchase.LevelId">Level (for the subscription)</label>
                        <select asp-for="Purchase.LevelId" class="form-select">
                            <option value="">-- select --</option>
                            @foreach (var l in Model.Levels)
                            {
                                <option value="@l.Id">@l.Code</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" asp-for="Purchase.Origin">Origin</label>
                        <select asp-for="Purchase.Origin" class="form-select">
                            <option value="@SubscriptionOrigin.GuardianPurchase">GuardianPurchase</option>
                            <option value="@SubscriptionOrigin.SelfPurchase">SelfPurchase</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Purchase (creates Draft)</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Grant a subscription free (D-13, admin, no payment)</h5>
                <form method="post" asp-page-handler="Grant" class="row g-2">
                    <div class="col-6">
                        <label class="form-label" asp-for="Grant.StudentId">Student</label>
                        <select asp-for="Grant.StudentId" class="form-select">
                            <option value="">-- select --</option>
                            @foreach (var s in Model.Students)
                            {
                                <option value="@s.Id">@s.FullName (#@s.Id)</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" asp-for="Grant.CountryId">Country</label>
                        <select asp-for="Grant.CountryId" class="form-select">
                            <option value="">-- select --</option>
                            @foreach (var c in Model.Countries)
                            {
                                <option value="@c.Id">@c.NameEn</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" asp-for="Grant.CourseId">Course</label>
                        <select asp-for="Grant.CourseId" class="form-select">
                            <option value="">-- select --</option>
                            @foreach (var c in Model.Courses)
                            {
                                <option value="@c.Id">@c.NameEn</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label" asp-for="Grant.LevelId">Level</label>
                        <select asp-for="Grant.LevelId" class="form-select">
                            <option value="">-- select --</option>
                            @foreach (var l in Model.Levels)
                            {
                                <option value="@l.Id">@l.Code</option>
                            }
                        </select>
                    </div>
                    <div class="col-4">
                        <label class="form-label" asp-for="Grant.SessionsCount">Sessions</label>
                        <input asp-for="Grant.SessionsCount" class="form-control" />
                    </div>
                    <div class="col-4">
                        <label class="form-label" asp-for="Grant.MinutesTotal">Minutes</label>
                        <input asp-for="Grant.MinutesTotal" class="form-control" />
                    </div>
                    <div class="col-4">
                        <label class="form-label" asp-for="Grant.ValidityDays">Validity (days)</label>
                        <input asp-for="Grant.ValidityDays" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="Grant.Reason">Reason (mandatory, D-13)</label>
                        <input asp-for="Grant.Reason" class="form-control" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-warning">Grant free</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<h2>Active plans</h2>
<div class="table-responsive mb-4">
    <table class="table table-sm table-striped">
        <thead><tr><th>#</th><th>Country</th><th>Course</th><th>Level</th><th>Type</th><th>Sessions</th><th>Minutes</th><th>Price</th><th>Validity</th></tr></thead>
        <tbody>
            @foreach (var p in Model.Plans)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.CountryCode</td>
                    <td>@p.CourseName</td>
                    <td>@(p.LevelCode ?? "any")</td>
                    <td>@p.SessionType</td>
                    <td>@p.SessionsCount</td>
                    <td>@p.MinutesTotal</td>
                    <td>@p.Amount.ToString("N3", null) @p.Currency</td>
                    <td>@p.ValidityDays d</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2>Recent subscriptions</h2>
<div class="table-responsive">
    <table class="table table-sm table-striped">
        <thead><tr><th>#</th><th>Student</th><th>Course/Level</th><th>Price</th><th>Status</th><th>Origin</th><th>Balance (min)</th><th>Expires</th></tr></thead>
        <tbody>
            @foreach (var s in Model.RecentSubscriptions)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.StudentName</td>
                    <td>@s.CourseName / @s.LevelCode</td>
                    <td>@s.Price.ToString("N3", null) @s.Currency</td>
                    <td>@s.Status</td>
                    <td>@s.Origin</td>
                    <td>@s.BalanceMinutes</td>
                    <td>@s.ExpiresOn.ToString("yyyy-MM-dd", null)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
