@page
@model MVTeaches.Web.Pages.Admin.PayrollModel
@using MVTeaches.Domain.Payroll
@{
    ViewData["Title"] = T["Payroll"].Value;
}

<h1>@T["Payroll"]</h1>
<p class="text-muted">@T["The payroll cycle: declare → verify → aggregate → review → approve → pay → close. Whoever declared a delivery cannot also verify it."]</p>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<h2>@T["Declared, awaiting verification"] (@Model.DeclaredDeliveries.Count)</h2>
<div class="table-responsive mb-4">
    <table class="table table-sm table-striped">
        <thead><tr><th>@T["Session"]</th><th>@T["Teacher"]</th><th>@T["Declared minutes"]</th><th>@T["Note"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var d in Model.DeclaredDeliveries)
            {
                <tr>
                    <td>#@d.SessionId</td>
                    <td>@d.TeacherName</td>
                    <td>@d.DeclaredMinutes</td>
                    <td>@d.Note</td>
                    <td class="d-flex gap-2">
                        <form method="post" asp-page-handler="Verify">
                            <input type="hidden" name="sessionId" value="@d.SessionId" />
                            <button type="submit" class="btn btn-sm btn-success">@T["Verify"]</button>
                        </form>
                        <form method="post" asp-page-handler="Reject" class="d-flex gap-1">
                            <input type="hidden" name="sessionId" value="@d.SessionId" />
                            <input type="text" name="RejectReason" class="form-control form-control-sm" placeholder="@T["Reason"]" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">@T["Reject"]</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.DeclaredDeliveries.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">@T["Nothing awaiting verification."]</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@T["Open a payroll period"]</h5>
        <form method="post" asp-page-handler="OpenPeriod" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label" asp-for="NewPeriod.CountryId">@T["Country"]</label>
                <select asp-for="NewPeriod.CountryId" class="form-select">
                    <option value="">-- @T["select"] --</option>
                    @foreach (var country in Model.Countries)
                    {
                        <option value="@country.Id">@country.NameEn</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label" asp-for="NewPeriod.Start">@T["Start"]</label>
                <input asp-for="NewPeriod.Start" type="date" class="form-control" />
            </div>
            <div class="col-auto">
                <label class="form-label" asp-for="NewPeriod.End">@T["End"]</label>
                <input asp-for="NewPeriod.End" type="date" class="form-control" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">@T["Open period"]</button>
            </div>
        </form>
    </div>
</div>

<h2>@T["Periods"]</h2>
<div class="table-responsive">
    <table class="table table-sm table-striped">
        <thead><tr><th>#</th><th>@T["Country"]</th><th>@T["Range"]</th><th>@T["Status"]</th><th>@T["Lines"]</th><th>@T["Total"]</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in Model.Periods)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.CountryId</td>
                    <td>@p.Start.ToString("yyyy-MM-dd", null) — @p.End.ToString("yyyy-MM-dd", null)</td>
                    <td>@T["PayrollPeriodStatus." + p.Status]</td>
                    <td>@p.LineCount</td>
                    <td>@p.TotalAmount.ToString("N3", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td class="d-flex gap-2 flex-wrap">
                        @if (p.Status == PayrollPeriodStatus.Open)
                        {
                            <form method="post" asp-page-handler="Aggregate">
                                <input type="hidden" name="periodId" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">@T["Aggregate"]</button>
                            </form>
                            <form method="post" asp-page-handler="MoveToReview">
                                <input type="hidden" name="periodId" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Move to review"]</button>
                            </form>
                        }
                        @if (p.Status == PayrollPeriodStatus.Review)
                        {
                            <form method="post" asp-page-handler="Approve">
                                <input type="hidden" name="periodId" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-success">@T["Approve"]</button>
                            </form>
                        }
                        @if (p.Status == PayrollPeriodStatus.Approved)
                        {
                            <form method="post" asp-page-handler="MarkPaid">
                                <input type="hidden" name="periodId" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-success">@T["Mark paid"]</button>
                            </form>
                        }
                        @if (p.Status == PayrollPeriodStatus.Paid)
                        {
                            <form method="post" asp-page-handler="Close">
                                <input type="hidden" name="periodId" value="@p.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Close"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
