@page
@model MVTeaches.Web.Pages.PurchasePackageModel
@using MVTeaches.Domain.Payments
@{
    ViewData["Title"] = T["Purchase Package"].Value;
}

<h1>@T["Purchase Package"]</h1>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@* Offer posters (owner decision 2026-09-01). Shown above everything else and
   outside every branch below, because a student who has not taken the
   placement test yet still deserves to see what the centre is offering. They
   are pictures and words only - nothing here is clickable into a purchase,
   and the packages a student may actually buy are still decided entirely by
   the eligibility rules further down. *@
@if (Model.Posters.Count > 0)
{
    <section class="app-offer-rail" aria-label="@T["Current offers"]">
        @foreach (var poster in Model.Posters)
        {
            <article class="app-poster app-poster-offer">
                @if (poster.HasImage)
                {
                    <div class="app-poster-image">
                        @* The cache-buster belongs INSIDE Url.Page, exactly as
                           /Admin/Posters does it. Appended outside, it produced a
                           second "?" (.../PosterImage?posterId=5?v=17) which the
                           query parser reads as a posterId of "5?v=17" - no image
                           at all. Same bug, student-facing half. *@
                        <img src="@Url.Page("/Files/PosterImage", new { posterId = poster.Id, v = poster.ImageFileId })"
                             alt="@poster.Title" loading="lazy" />
                    </div>
                }
                <div class="app-poster-body">
                    <h3>@poster.Title</h3>
                    @if (!string.IsNullOrWhiteSpace(poster.Details))
                    {
                        <p class="app-poster-note">@poster.Details</p>
                    }
                </div>
            </article>
        }
    </section>
}

@if (Model.NoProfileLinked)
{
    <div class="alert alert-warning">@T["Your account has no linked profile yet — ask an admin to create one for you."]</div>
}
else if (Model.IsGuardian && Model.SelectedStudentId is null)
{
    <p class="text-muted">@T["Choose which child to purchase a package for."]</p>
    <ul class="list-group app-choice-list">
        @foreach (var c in Model.Children)
        {
            <li class="list-group-item list-group-item-action p-0">
                <a asp-page="/PurchasePackage" asp-route-studentId="@c.StudentId" class="app-choice-link">
                    <span>@c.FullName</span>
                    <span class="app-choice-arrow" aria-hidden="true">&#8250;</span>
                </a>
            </li>
        }
    </ul>
}
else
{
    @if (Model.IsGuardian)
    {
        <p class="text-muted">@T["Acting for {0}", Model.SelectedStudentName ?? ""] — <a asp-page="/PurchasePackage">@T["choose a different child"]</a>.</p>
    }

    @if (Model.NeedsPlacementTest)
    {
        <div class="alert alert-info">
            @T["A free placement test is required before any package can be purchased."]
            <a asp-page="/PlacementTest" asp-route-studentId="@Model.SelectedStudentId" class="alert-link">@T["Take the placement test"]</a>.
        </div>
    }
    else
    {
        @if (Model.PurchasedByGuardianOnly)
        {
            <div class="alert alert-info">@T["Packages for this student are purchased by their guardian. Please ask your guardian to buy it from their own account, or contact the centre."]</div>
        }

        @* Owner decision 2026-09-04 (multi-course levels): a student is placed
           separately in every course they study, so this names all of them
           rather than picking one. Each chip is a different shelf of packages. *@
        <p class="text-muted">
            <span class="me-1">@T["Your current levels:"]</span>
            @foreach (var placement in Model.CurrentPlacements)
            {
                <span class="app-chip is-level">@placement.CourseName @placement.LevelCode</span>
            }
        </p>
        <p class="text-muted">@T["Only packages published for a course and a level you are placed in are shown — a Group package books only Group sessions, and a Private package books only Private sessions."]</p>

        @if (Model.EligiblePlans.Count == 0)
        {
            <div class="alert alert-warning">@T["No packages are currently published for your courses and levels — please contact the centre."]</div>
        }
        else
        {
            @* A price list is not a choice. These are posters: one tall card per
               package, with the level as its face, the price as the loudest thing
               on it, and the facts underneath in a fixed order so two packages can
               be compared by looking at the same spot twice. Pure CSS - no image is
               uploaded, no column is added, and the form posts exactly what the
               table version posted. *@
            <div class="app-poster-rail">
                @foreach (var p in Model.EligiblePlans)
                {
                    <article class="app-poster">
                        <div class="app-poster-face" aria-hidden="true">
                            <span class="app-poster-level">@p.LevelCode</span>
                            <span class="app-poster-kind">@T["SessionType." + p.SessionType]</span>
                        </div>
                        <div class="app-poster-body">
                            <h3>@p.CourseName</h3>
                            <p class="app-poster-price">
                                <strong>@T.Money(p.Amount, p.Currency)</strong>
                            </p>
                            <dl class="app-poster-facts">
                                <div>
                                    <dt>@T["Lessons"]</dt>
                                    <dd>@p.SessionsCount</dd>
                                </div>
                                <div>
                                    <dt>@T["Each lesson"]</dt>
                                    <dd>@T.Minutes(p.SessionsCount > 0 ? p.MinutesTotal / p.SessionsCount : p.MinutesTotal)</dd>
                                </div>
                                <div>
                                    <dt>@T["Total time"]</dt>
                                    <dd>@T.Minutes(p.MinutesTotal)</dd>
                                </div>
                                <div>
                                    <dt>@T["Valid for"]</dt>
                                    <dd>@T["{0} day(s)", p.ValidityDays]</dd>
                                </div>
                            </dl>
                            @* A guardian is registered as responsible for this
                               student, so the purchase is theirs to make. The
                               prices stay visible - only the button goes. The
                               server refuses the request either way. *@
                            @if (Model.PurchasedByGuardianOnly)
                            {
                                <p class="app-poster-note mb-0">@T["Your guardian buys this package for you."]</p>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Purchase">
                                    <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                                    <input type="hidden" name="pricingPlanId" value="@p.Id" />
                                    <button type="submit" class="btn btn-primary w-100">@T["Request this package"]</button>
                                </form>
                                <p class="app-poster-note">@T["Requesting it does not charge you. The centre confirms your payment first, and only then does the package activate."]</p>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    }

    @if (Model.UnpaidDraftSubscriptions.Count > 0)
    {
        @* A package that was paid short is finished HERE, on the same package,
           not by buying another one. The backend already worked this way -
           RequestOwnPaymentAsync asks for the remaining owed amount, not the
           full price - but the screen said "choose a payment method" either
           way, so a payer who had already transferred most of it had no reason
           to believe this was the right place to finish. It now says which of
           the two situations each package is in, and how much is left. *@
        @* Owner report 2026-09-05: every heading and card in this section names
           the child. A guardian sees one child at a time here, but the message
           that sends them here is about a specific child, and "your package"
           reads as the family's when there are two daughters in the system. *@
        <h2 id="finish-paying">
            @if (Model.UnpaidDraftSubscriptions.Any(d => d.ConfirmedReceived > 0))
            {
                @(Model.SelectedStudentName is null
                    ? T["Finish paying for your package"].Value
                    : T["Finish paying for {0}'s package", Model.SelectedStudentName].Value)
            }
            else
            {
                @(Model.SelectedStudentName is null
                    ? T["Choose a payment method"].Value
                    : T["Choose a payment method for {0}", Model.SelectedStudentName].Value)
            }
        </h2>
        @if (Model.ActiveMethods.Count == 0)
        {
            <div class="alert alert-warning">@T["No payment methods are currently available — please contact the centre."]</div>
        }
        else
        {
            @foreach (var s in Model.UnpaidDraftSubscriptions)
            {
                var paidPercent = s.Price <= 0m ? 0 : (int)Math.Round(Math.Clamp(s.ConfirmedReceived / s.Price * 100m, 0m, 100m));
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">
                            @(Model.SelectedStudentName is null
                                ? T["Package request #{0}", s.Id].Value
                                : T["Package request #{0} for {1}", s.Id, Model.SelectedStudentName].Value)
                            — @T.Money(s.Price, s.Currency)
                        </h5>
                        <dl class="row small mb-2">
                            <dt class="col-sm-3">@T["Package price"]</dt>
                            <dd class="col-sm-9">@T.Money(s.Price, s.Currency)</dd>
                            <dt class="col-sm-3">@T["Confirmed received"]</dt>
                            <dd class="col-sm-9">@T.Money(s.ConfirmedReceived, s.Currency)</dd>
                            <dt class="col-sm-3">@T["Remaining owed"]</dt>
                            <dd class="col-sm-9 fw-bold">@T.Money(s.RemainingOwed, s.Currency)</dd>
                        </dl>
                        <div class="app-meter mb-2" role="img"
                             aria-label="@T["{0}% of the billed amount has been paid.", paidPercent]">
                            <span class="app-meter-fill @(s.RemainingOwed <= 0m ? "is-success" : "is-warning")" style="width:@(paidPercent)%"></span>
                        </div>
                        <p class="small text-muted">@T["A package stays inactive until the whole price is confirmed. Paying part of it is recorded, but it does not start the package."]</p>
                        @if (s.ConfirmedReceived > 0)
                        {
                            <div class="alert alert-warning small">@T["Your earlier transfer arrived short of the full price — this is normal after bank/transfer fees. Send the remaining amount below to activate the package. Do not request a new package."]</div>
                        }
                        <form method="post" asp-page-handler="RequestPayment" class="row g-2">
                            <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                            <input type="hidden" name="subscriptionId" value="@s.Id" />
                            <div class="col-md-8">
                                <select name="paymentMethodConfigId" class="form-select">
                                    @foreach (var m in Model.ActiveMethods)
                                    {
                                        <option value="@m.Id">@T["PaymentMethod." + m.Type] — @m.BeneficiaryName (@m.AcceptedCurrenciesCsv)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-primary w-100">
                                    @T["Request payment of {0}", T.Money(s.RemainingOwed, s.Currency)]
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        }
    }

    @if (Model.OwnPayments.Count > 0)
    {
        <h2>@T["Payment requests"]</h2>
        @foreach (var p in Model.OwnPayments)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">
                        @T["Reference"]: @p.ReferenceCode — @T.Money(p.Amount, p.Currency)
                        (@T["PaymentMethod." + p.Method])
                    </h5>
                    <p>
                        @if (p.Status == PaymentStatus.Pending && !p.HasSubmittedTransferDetails)
                        {
                            <span class="badge bg-warning text-dark">@T["Awaiting transfer"]</span>
                        }
                        else if (p.Status == PaymentStatus.Pending)
                        {
                            <span class="badge bg-info text-dark">@T["Under review"]</span>
                        }
                        else
                        {
                            <span>@T["PaymentStatus." + p.Status]</span>
                        }
                    </p>
                    @if (p.Status == PaymentStatus.Confirmed && p.ReceivedAmount is not null && p.ReceivedCurrency == p.Currency && p.ReceivedAmount < p.Amount)
                    {
                        <div class="alert alert-warning small">
                            @T["Only {0} of the required {1} was confirmed as received — the package stays inactive until the remaining {2} is sent and confirmed.",
                                T.Money(p.ReceivedAmount.Value, p.Currency),
                                T.Money(p.Amount, p.Currency),
                                T.Money(p.Amount - p.ReceivedAmount.Value, p.Currency)]
                        </div>
                    }

                    @if (p.Status == PaymentStatus.Rejected && p.RejectionReason is not null)
                    {
                        <div class="alert alert-danger">
                            <strong>@T["Needs correction"]:</strong> @p.RejectionReason
                        </div>
                    }

                    @if (p.Status == PaymentStatus.Pending && p.Method != PaymentMethod.Cash)
                    {
                        <details class="mt-2" open="@(!p.HasSubmittedTransferDetails)">
                            <summary class="fw-semibold">@T["Before you transfer"]</summary>
                            <div class="alert alert-info mt-2">
                                <ul class="mb-2">
                                    <li>@T["Verify the beneficiary number/IBAN and name match exactly. If they differ, do not transfer — contact the admin instead."]</li>
                                    <li>@T["Verify the amount and currency before sending."]</li>
                                    <li><strong>@T["The full package price must arrive at the centre's account after any transfer fees are deducted. If a smaller amount arrives, the remaining difference must be sent before the package can activate."]</strong></li>
                                    <li>@T["Mention the reference {0} in your transfer notes.", p.ReferenceCode]</li>
                                    <li>@T["Keep your receipt and upload it below."]</li>
                                    <li>@T["Uploading a receipt does not mean your payment is approved or your package is active yet."]</li>
                                    <li>@T["If you sent money to the wrong party, contact your bank AND the admin immediately — a refund can never be promised."]</li>
                                </ul>
                            </div>
                            <form method="post" asp-page-handler="SubmitTransfer" enctype="multipart/form-data" class="row g-2">
                                <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                                <input type="hidden" name="Transfer.PaymentId" value="@p.Id" />
                                <div class="col-md-4">
                                    <label class="form-label">@T["Payer name"]</label>
                                    <input name="Transfer.PayerDisplayName" class="form-control" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">@T["Transfer date"]</label>
                                    <input name="Transfer.TransferDate" type="date" class="form-control" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">@T["Bank reference number"]</label>
                                    <input name="Transfer.BankReferenceNumber" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@T["Receipt"]</label>
                                    <input name="Transfer.Receipt" type="file" accept="image/jpeg,image/png,application/pdf" class="form-control" required />
                                </div>
                                <div class="col-12 form-check">
                                    <input type="checkbox" name="Transfer.Acknowledged" value="true" class="form-check-input" id="ack-@p.Id" required />
                                    <label class="form-check-label" for="ack-@p.Id">@T["I have read and understood the verification instructions above."]</label>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary">@T["Submit transfer details"]</button>
                                </div>
                            </form>
                        </details>
                    }
                </div>
            </div>
        }
    }
}
