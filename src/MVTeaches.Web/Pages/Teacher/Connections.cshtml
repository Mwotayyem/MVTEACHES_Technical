@page
@model MVTeaches.Web.Pages.Teacher.ConnectionsModel
@using MVTeaches.Domain.Integrations
@{
    ViewData["Title"] = T["Connections"].Value;
}

<h1>@T["Video meeting connections"]</h1>

@if (Model.NoTeacherProfileLinked)
{
    <div class="alert alert-warning">@T["Your account has the Teacher role but no linked teacher profile yet — ask an admin to create one for you."]</div>
}
else
{
    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success">@Model.StatusMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="app-guide">
        <p class="app-guide-title">@T["Does every teacher have to connect an account?"]</p>
        <p><strong>@T["Yes."]</strong> @T["Each teacher connects their own personal Zoom or Google account, and the centre has no shared account of its own. Your lessons are hosted under your account, so a lesson cannot be created for you until one is connected."]</p>
        <p class="app-guide-title">@T["Is there an MVTeaches account we could all use instead?"]</p>
        <p><strong>@T["No, and there will not be."]</strong> @T["The centre decided against one central account: it would stop two teachers from teaching at the same time, and it would put your meetings under somebody else's login."]</p>
        <p class="app-guide-title">@T["Does this cost me anything?"]</p>
        <p><strong>@T["No."]</strong> @T["A free Google account is enough. The centre does not buy, provide, or repay any video licence, and you are never asked for your Zoom or Google password — you sign in with them directly."]</p>
        @* Owner direction (product, not yet built): Zoom becomes the default
           for teachers who already have a Zoom subscription, with Google Meet
           as the alternative for short lessons or for teachers without one.
           Stated here as direction only - no Zoom integration work is done,
           and nothing on this screen behaves differently because of it. *@
        <p class="app-guide-title">@T["Which one should I connect?"]</p>
        <p>@T["Either one works today, and you can connect both and choose which is used for new lessons. Where the centre is heading: Zoom will be the default for teachers who already pay for a Zoom subscription, and Google Meet stays the alternative — for shorter lessons, and for anyone who does not have Zoom. Nothing changes for you until the centre says so."]</p>
        <p class="app-guide-title">@T["What happens when I press Connect?"]</p>
        <ol class="mb-0">
            <li>@T["Press \"Connect Google Meet\" (or Zoom) in the table below."]</li>
            <li>@T["Choose your Google account on the page it takes you to."]</li>
            <li>@T["Approve the access MVTeaches is asking for."]</li>
            <li>@T["You land back here — check that this provider's row now says \"Connected\"."]</li>
        </ol>
    </div>

    @if (Model.NotReadyForOnlineSessions)
    {
        <div class="alert alert-danger">
            <h5 class="alert-heading">@T["Not ready for online sessions."]</h5>
            <p>
                @T["You have no connected video account, so you cannot be assigned online sessions yet. Connect one below — a free Google account is sufficient, no payment of any kind is required."]
            </p>
            <hr />
            <p class="mb-1"><strong>@T["If you don't have a Google account yet:"]</strong></p>
            <ol class="mb-0">
                <li>@T["Go to accounts.google.com/signup and create a free account."]</li>
                <li>@T["Come back to this page and press Connect Google Meet."]</li>
                <li>@T["Sign in with that account and approve the access MVTeaches asks for."]</li>
            </ol>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr><th>@T["Provider"]</th><th>@T["Status"]</th><th>@T["Account"]</th><th>@T["Capability"]</th><th>@T["Default for new sessions"]</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var provider in new[] { VideoProviderType.Zoom, VideoProviderType.GoogleMeet })
                {
                    var connection = Model.Connections.FirstOrDefault(c => c.Provider == provider);
                    <tr>
                        <td class="fw-semibold">@MVTeaches.Web.Pages.Teacher.ConnectionsModel.Describe(provider)</td>
                        <td>
                            @if (connection is null)
                            {
                                <span class="text-muted">@T["Not connected"]</span>
                            }
                            else if (connection.Status == ProviderConnectionStatus.Connected)
                            {
                                <span class="text-success">@T["Connected"]</span>
                            }
                            else
                            {
                                <span class="text-danger">@T["ProviderConnectionStatus." + connection.Status]</span>
                            }
                        </td>
                        <td>@(connection?.ExternalAccountEmail ?? "—")</td>
                        <td>
                            @if (connection is null)
                            {
                                <span class="text-muted">—</span>
                            }
                            else if (provider == VideoProviderType.Zoom)
                            {
                                @if (connection.CapabilityTier == MeetingCapabilityTier.Full)
                                {
                                    <span class="text-success">@T["Licensed — full-length sessions"]</span>
                                }
                                else
                                {
                                    <span class="text-warning">@T["Basic (free) — meetings limited to {0} minutes, including one-to-one", connection.CapabilityMinutesLimit ?? 40]</span>
                                }
                            }
                            else
                            {
                                <span>@T["Free Google limits assumed: one-to-one up to 24 hours, 3+ participants up to 60 minutes"]</span>
                            }
                        </td>
                        <td>
                            @if (connection?.IsDefault == true)
                            {
                                <span class="badge bg-primary">@T["Default"]</span>
                            }
                            else if (connection?.Status == ProviderConnectionStatus.Connected)
                            {
                                <form method="post" asp-page-handler="SetDefault">
                                    <input type="hidden" name="provider" value="@provider" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Make default"]</button>
                                </form>
                            }
                        </td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Connect" class="d-inline">
                                <input type="hidden" name="provider" value="@provider" />
                                <button type="submit" class="btn btn-sm btn-primary">
                                    @(connection is null ? T["Connect"] : T["Reconnect"]) @MVTeaches.Web.Pages.Teacher.ConnectionsModel.Describe(provider)
                                </button>
                            </form>
                            @if (connection is not null && connection.Status == ProviderConnectionStatus.Connected)
                            {
                                <form method="post" asp-page-handler="Disconnect" class="d-inline">
                                    <input type="hidden" name="provider" value="@provider" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@T["Disconnect"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted small">
        @T["Changing your default provider affects only sessions whose meeting hasn't been created yet — an existing session keeps the meeting it already has, under the account that created it."]
    </p>
}
