@page
@model MVTeaches.Web.Pages.Teacher.PublishSlotsModel
@using MVTeaches.Domain.Catalog
@{
    ViewData["Title"] = T["Publish Slots"].Value;
}

<h1>@T["Publish Slots"]</h1>

@if (Model.NoTeacherProfileLinked)
{
    <div class="alert alert-warning">@T["Your account has the Teacher role but no linked teacher profile yet — ask an admin to create one for you."]</div>
}
else
{
    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success">@Model.StatusMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.AuthorizedLevels.Count == 0)
    {
        <div class="alert alert-warning">@T["You have not been authorized for any level yet — ask an admin to grant one on your profile before you can publish a slot."]</div>
    }

    <p class="text-muted">@T["Publish a bookable slot for students or guardians to book directly. Seats fill automatically from the session type you pick (Group = 4 seats, Private = 1 seat) — you never set the seat count yourself. Times are shown and entered in your own registered time zone."]</p>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@T["New slot"]</h5>
            <form method="post" class="row g-2">
                <div class="col-md-3">
                    <label class="form-label" asp-for="NewSlot.CountryId">@T["Country"]</label>
                    <select asp-for="NewSlot.CountryId" class="form-select">
                        <option value="">-- @T["select"] --</option>
                        @foreach (var c in Model.Countries)
                        {
                            <option value="@c.Id">@c.NameEn</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="NewSlot.CourseId">@T["Course"]</label>
                    <select asp-for="NewSlot.CourseId" class="form-select">
                        <option value="">-- @T["select"] --</option>
                        @foreach (var c in Model.Courses)
                        {
                            <option value="@c.Id">@c.NameEn</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="NewSlot.LevelId">@T["Level (only levels you're authorized for)"]</label>
                    <select asp-for="NewSlot.LevelId" class="form-select">
                        <option value="">-- @T["select"] --</option>
                        @foreach (var l in Model.AuthorizedLevels)
                        {
                            <option value="@l.Id">@l.Code</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="NewSlot.AgeGroupId">@T["Age group"]</label>
                    <select asp-for="NewSlot.AgeGroupId" class="form-select">
                        <option value="">-- @T["select"] --</option>
                        @foreach (var a in Model.AgeGroups)
                        {
                            <option value="@a.Id">@a.Code</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="NewSlot.Date">@T["Date"]</label>
                    <input asp-for="NewSlot.Date" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="NewSlot.StartLocal">@T["Start time"]</label>
                    <input asp-for="NewSlot.StartLocal" type="time" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="NewSlot.DurationMinutes">@T["Duration (minutes)"]</label>
                    <input asp-for="NewSlot.DurationMinutes" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="NewSlot.SessionType">@T["Type"]</label>
                    <select asp-for="NewSlot.SessionType" class="form-select">
                        <option value="@SessionType.Group">@T["Group (4 seats)"]</option>
                        <option value="@SessionType.Private">@T["Private (1 seat)"]</option>
                    </select>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">@T["Publish slot"]</button>
                </div>
            </form>
        </div>
    </div>

    <h2>@T["Your upcoming slots"]</h2>
    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>@T["Local start"]</th>
                    <th>@T["Duration"]</th>
                    <th>@T["Type"]</th>
                    <th>@T["Course and level"]</th>
                    <th>@T["Age group"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["Seats booked / capacity"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.UpcomingSlots)
                {
                    <tr>
                        <td>@s.LocalDateAndTime</td>
                        <td>@T["Minutes format", s.DurationMinutes]</td>
                        <td>@T["SessionType." + s.SessionType]</td>
                        <td>@s.CourseName / @s.LevelCode</td>
                        <td>@s.AgeGroupCode</td>
                        <td>@T["ClassSessionStatus." + s.Status]</td>
                        <td>@s.SeatsTaken / @s.Capacity</td>
                    </tr>
                }
                @if (Model.UpcomingSlots.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted">@T["No upcoming slots published yet."]</td></tr>
                }
            </tbody>
        </table>
    </div>
}
