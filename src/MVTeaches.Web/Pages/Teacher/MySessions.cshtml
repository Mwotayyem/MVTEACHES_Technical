@page
@model MVTeaches.Web.Pages.Teacher.MySessionsModel
@using NodaTime
@{
    ViewData["Title"] = T["My Sessions"].Value;
}

<h1>@T["My Sessions"]</h1>

@if (Model.NoTeacherProfileLinked)
{
    <div class="alert alert-warning">@T["Your account has the Teacher role but no linked teacher profile yet — ask an admin to create one for you."]</div>
}
else
{
    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success">@Model.StatusMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    @if (Model.NotReadyForOnlineSessions)
    {
        <div class="alert alert-danger">
            <strong>@T["Not ready for online sessions."]</strong> @T["You have no connected video account, so you cannot start meetings and cannot be assigned new online sessions. A free Google account is enough — no paid subscription of any kind is required."]
            <a asp-page="/Teacher/Connections" class="alert-link">@T["Connect an account"]</a>.
        </div>
    }

    <p class="text-muted">@T["Last 30 days and next 7 days. Declaring is only offered once a session has actually ended — an admin verifies afterward on a separate account."]</p>

    <partial name="_SessionFlowGuide" />

    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead><tr><th>@T["When"]</th><th>@T["Course and level"]</th><th>@T["Minutes"]</th><th>@T["Session status"]</th><th>@T["Meeting"]</th><th>@T["Delivery"]</th><th></th></tr></thead>
            <tbody>
                @foreach (var s in Model.Sessions)
                {
                    <tr>
                        <td>
                            @T.SessionMoment(s.StartsAtUtc, s.ScheduleTimeZone)
                            <div class="text-muted small">@DisplayFormat.ZoneLabel(s.ScheduleTimeZone)</div>
                        </td>
                        <td>@s.CourseName / @s.LevelCode</td>
                        <td>@T.Minutes(s.DurationMinutes)</td>
                        <td>@T["ClassSessionStatus." + s.Status]</td>
                        <td>
                            @if (s.MeetingStatus is null)
                            {
                                <span class="text-muted">@T["Not created yet"]</span>
                            }
                            else
                            {
                                <span>@T["VideoProviderType." + s.MeetingProvider] — @T["MeetingProvisioningStatus." + s.MeetingStatus]</span>
                            }
                            @if (!string.IsNullOrEmpty(s.CapabilityWarning))
                            {
                                @* Owner decision 2026-08-30: a warning, never a block — the
                                   Start button below stays available regardless. *@
                                <div class="alert alert-warning py-1 px-2 mt-1 mb-0 small" role="alert">
                                    <strong>⚠ @T["Account limit:"]</strong> @s.CapabilityWarning
                                </div>
                            }
                        </td>
                        <td>@(s.DeliveryState is not null ? T["DeliveryState." + s.DeliveryState].Value : "—")</td>
                        <td>
                            @if (s.CanStart)
                            {
                                @* The host link is fetched fresh and redirected to server-side — never rendered here. *@
                                <form method="post" asp-page-handler="Start" class="d-inline">
                                    <input type="hidden" name="sessionId" value="@s.SessionId" />
                                    <button type="submit" class="btn btn-sm btn-success">@T["Start session"]</button>
                                </form>
                            }
                            @if (s.CanDeclare)
                            {
                                <form method="post" asp-page-handler="Declare" class="d-flex gap-1">
                                    <input type="hidden" name="sessionId" value="@s.SessionId" />
                                    <input type="number" name="declaredMinutes" class="form-control form-control-sm" style="width:6rem" value="@s.DurationMinutes" />
                                    <input type="text" name="note" class="form-control form-control-sm" placeholder="@T["Note (optional)"]" />
                                    <button type="submit" class="btn btn-sm btn-primary">@T["Declare"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Sessions.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted">@T["No sessions in this window."]</td></tr>
                }
            </tbody>
        </table>
    </div>
}
