@page
@model MVTeaches.Web.Pages.Teacher.MyPayHistoryModel
@{
    ViewData["Title"] = T["My Pay History"].Value;
}

<h1>@T["My Pay History"]</h1>

@if (Model.NoTeacherProfileLinked)
{
    <div class="alert alert-warning">@T["This account has no linked teacher profile yet — ask an admin to link it on /Admin/Teachers."]</div>
}
else
{
    @if (Model.Totals.Count > 0)
    {
        <div class="row mb-3">
            @foreach (var t in Model.Totals)
            {
                <div class="col-auto">
                    <div class="card">
                        <div class="card-body">
                            <h6 class="card-subtitle mb-2 text-muted">@t.Currency</h6>
                            <p class="mb-1"><strong>@T["Paid:"]</strong> @T.Money(t.Paid, t.Currency)</p>
                            <p class="mb-0"><strong>@T["Pending (verified, not yet paid):"]</strong> @T.Money(t.Pending, t.Currency)</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>@T["Session date"]</th>
                    <th>@T["Course and level"]</th>
                    <th>@T["Minutes"]</th>
                    <th>@T["Rate"]</th>
                    <th>@T["Amount"]</th>
                    <th>@T["Period"]</th>
                    <th>@T["Period status"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td>@T.DateTimeUtc(l.SessionStartsAtUtc)</td>
                        <td>@l.CourseName / @l.LevelCode</td>
                        <td>@T.Minutes(l.Minutes)</td>
                        <td>@T.Money(l.RateAmount, l.Currency)</td>
                        <td>@T.Money(l.Amount, l.Currency)</td>
                        <td>@T.Date(l.PeriodStart) — @T.Date(l.PeriodEnd)</td>
                        <td>@T["PayrollPeriodStatus." + l.PeriodStatus]</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Lines.Count == 0)
        {
            <p class="text-muted">@T["No payroll lines yet — these appear once a declared delivery is verified and an admin aggregates it into a payroll period."]</p>
        }
    </div>
}
