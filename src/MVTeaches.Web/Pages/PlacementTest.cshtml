@page
@model MVTeaches.Web.Pages.PlacementTestModel
@using MVTeaches.Application.Placement
@{
    ViewData["Title"] = T["Placement Test"].Value;
}

<h1>@T["Placement Test"]</h1>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.NoProfileLinked)
{
    <div class="alert alert-warning">@T["Your account has no linked profile yet — ask an admin to create one for you."]</div>
}
else if (Model.IsGuardian && Model.SelectedStudentId is null)
{
    <p class="text-muted">@T["Choose which child to take the placement test for. Each child's attempt, result, and level are completely separate."]</p>
    <ul class="list-group app-choice-list">
        @foreach (var c in Model.Children)
        {
            <li class="list-group-item list-group-item-action p-0">
                <a asp-page="/PlacementTest" asp-route-studentId="@c.StudentId" class="app-choice-link">
                    <span>@c.FullName</span>
                    <span class="app-choice-arrow" aria-hidden="true">&#8250;</span>
                </a>
            </li>
        }
    </ul>
}
else
{
    @if (Model.IsGuardian)
    {
        <p class="text-muted">@T["Acting for {0}", Model.SelectedStudentName ?? ""] — <a asp-page="/PlacementTest">@T["choose a different child"]</a>.</p>
    }

    @if (Model.JustScoredPoints is not null)
    {
        <div class="alert alert-info">
            <strong>@T["Score: {0}", Model.JustScoredPoints]</strong> — @T["assigned level:"] <strong>@Model.JustAssignedLevelCode</strong>.
            @T["You may now purchase a package matching this level."]
        </div>
    }
    else if (Model.QuizQuestions is not null)
    {
        <p class="text-muted">@T["Answer every question, then submit. Your answers are scored on the server only — nothing here reveals which choice is correct beforehand."]</p>
        <div class="app-toolbar" role="status" aria-live="polite">
            <strong>@T["Answered"]: <span id="answeredCount">0</span> / @Model.QuizQuestions.Count</strong>
            <span class="text-muted small">@T["Every question must be answered before the test can be submitted."]</span>
        </div>
        <form method="post" asp-page-handler="Submit" id="placementForm">
            <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
            <input type="hidden" name="attemptId" value="@Model.QuizAttemptId" />
            @for (var i = 0; i < Model.QuizQuestions.Count; i++)
            {
                var q = Model.QuizQuestions[i];
                <div class="card mb-3">
                    <div class="card-body">
                        <input type="hidden" name="answers[@i].QuestionId" value="@q.QuestionId" />
                        <fieldset>
                            <legend class="card-title h5">
                                <span class="app-ref">@T["Question {0} of {1}", i + 1, Model.QuizQuestions.Count]</span>
                                <span class="d-block mt-2">@q.Text</span>
                            </legend>
                            @foreach (var choice in q.Options)
                            {
                                <div class="form-check py-1">
                                    <input class="form-check-input" type="radio" name="answers[@i].SelectedChoiceId" value="@choice.ChoiceId" id="q@(q.QuestionId)_c@(choice.ChoiceId)" required />
                                    <label class="form-check-label" for="q@(q.QuestionId)_c@(choice.ChoiceId)">@choice.Text</label>
                                </div>
                            }
                        </fieldset>
                    </div>
                </div>
            }
            <button type="submit" class="btn btn-primary btn-lg">@T["Submit test"]</button>
        </form>

        @section Scripts {
            <script>
                // Counts answered questions as the student goes. No validation
                // decision lives here — the radios are still `required`, and the
                // score is still computed on the server alone.
                (function () {
                    var form = document.getElementById("placementForm");
                    var output = document.getElementById("answeredCount");
                    if (!form || !output) { return; }
                    function update() {
                        var names = {};
                        form.querySelectorAll("input[type=radio]:checked").forEach(function (input) { names[input.name] = true; });
                        output.textContent = Object.keys(names).length;
                    }
                    form.addEventListener("change", update);
                    update();
                })();
            </script>
        }
    }
    else if (Model.Eligibility is not null)
    {
        switch (Model.Eligibility)
        {
            case PlacementEligibilityStatus.EligibleFirstAttempt:
                <p>@T["Complete the free placement test to unlock package purchases matching your level."]</p>
                <form method="post" asp-page-handler="Start">
                    <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                    <button type="submit" class="btn btn-primary">@T["Take the free placement test"]</button>
                </form>
                break;

            case PlacementEligibilityStatus.AttemptInProgress:
                <p>@T["There is an unfinished attempt — resume it below."]</p>
                <form method="post" asp-page-handler="Start">
                    <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                    <button type="submit" class="btn btn-primary">@T["Resume the test"]</button>
                </form>
                break;

            case PlacementEligibilityStatus.RetakeApprovedReadyToStart:
                <p>@T["Your retake request was approved — you may take the test again."]</p>
                <form method="post" asp-page-handler="Start">
                    <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                    <button type="submit" class="btn btn-primary">@T["Take the test"]</button>
                </form>
                break;

            case PlacementEligibilityStatus.RetakePending:
                <div class="alert alert-info">@T["A retake request is awaiting admin approval."]</div>
                break;

            case PlacementEligibilityStatus.AlreadyCompletedNoRetakeApproved:
                @if (Model.MostRecentResult is not null)
                {
                    <div class="alert alert-info">
                        @T["Most recent result:"] <strong>@T["{0} points", Model.MostRecentResult.Score]</strong> — @T["Level"] <strong>@Model.MostRecentResult.LevelCode</strong>.
                        @T["Package purchases are restricted to this level."]
                    </div>
                }
                <p class="text-muted">@T["Want a different level? A retake requires admin approval."]</p>
                <form method="post" asp-page-handler="RequestRetake">
                    <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                    <button type="submit" class="btn btn-outline-secondary">@T["Request a retake"]</button>
                </form>
                break;
        }
    }
}
