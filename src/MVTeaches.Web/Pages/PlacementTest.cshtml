@page
@model MVTeaches.Web.Pages.PlacementTestModel
@using MVTeaches.Application.Placement
@{
    ViewData["Title"] = "Placement Test";
}

<h1>Placement test</h1>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.NoProfileLinked)
{
    <div class="alert alert-warning">Your account has no linked profile yet — ask an admin to create one for you.</div>
}
else if (Model.IsGuardian && Model.SelectedStudentId is null)
{
    <p class="text-muted">Choose which child to take the placement test for. Each child's attempt, result, and level are completely separate.</p>
    <ul class="list-group">
        @foreach (var c in Model.Children)
        {
            <li class="list-group-item">
                <a asp-page="/PlacementTest" asp-route-studentId="@c.StudentId">@c.FullName</a>
            </li>
        }
    </ul>
}
else
{
    @if (Model.IsGuardian)
    {
        <p class="text-muted">Acting for <strong>@Model.SelectedStudentName</strong> — <a asp-page="/PlacementTest">choose a different child</a>.</p>
    }

    @if (Model.JustScoredPoints is not null)
    {
        <div class="alert alert-info">
            <strong>Score: @Model.JustScoredPoints</strong> — assigned level: <strong>@Model.JustAssignedLevelCode</strong>.
            You may now purchase a package matching this level.
        </div>
    }
    else if (Model.QuizQuestions is not null)
    {
        <p class="text-muted">Answer every question, then submit. Your answers are scored on the server only — nothing here reveals which choice is correct beforehand.</p>
        <form method="post" asp-page-handler="Submit">
            <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
            <input type="hidden" name="attemptId" value="@Model.QuizAttemptId" />
            @for (var i = 0; i < Model.QuizQuestions.Count; i++)
            {
                var q = Model.QuizQuestions[i];
                <div class="card mb-3">
                    <div class="card-body">
                        <input type="hidden" name="answers[@i].QuestionId" value="@q.QuestionId" />
                        <h5 class="card-title">@(i + 1). @q.Text</h5>
                        @foreach (var choice in q.Options)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="answers[@i].SelectedChoiceId" value="@choice.ChoiceId" id="q@(q.QuestionId)_c@(choice.ChoiceId)" required />
                                <label class="form-check-label" for="q@(q.QuestionId)_c@(choice.ChoiceId)">@choice.Text</label>
                            </div>
                        }
                    </div>
                </div>
            }
            <button type="submit" class="btn btn-primary">Submit test</button>
        </form>
    }
    else if (Model.Eligibility is not null)
    {
        switch (Model.Eligibility)
        {
            case PlacementEligibilityStatus.EligibleFirstAttempt:
                <p>Complete the free placement test to unlock package purchases matching your level.</p>
                <form method="post" asp-page-handler="Start">
                    <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                    <button type="submit" class="btn btn-primary">Take the free placement test</button>
                </form>
                break;

            case PlacementEligibilityStatus.AttemptInProgress:
                <p>There is an unfinished attempt — resume it below.</p>
                <form method="post" asp-page-handler="Start">
                    <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                    <button type="submit" class="btn btn-primary">Resume the test</button>
                </form>
                break;

            case PlacementEligibilityStatus.RetakeApprovedReadyToStart:
                <p>Your retake request was approved — you may take the test again.</p>
                <form method="post" asp-page-handler="Start">
                    <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                    <button type="submit" class="btn btn-primary">Take the test</button>
                </form>
                break;

            case PlacementEligibilityStatus.RetakePending:
                <div class="alert alert-info">A retake request is awaiting admin approval.</div>
                break;

            case PlacementEligibilityStatus.AlreadyCompletedNoRetakeApproved:
                @if (Model.MostRecentResult is not null)
                {
                    <div class="alert alert-info">
                        Most recent result: <strong>@Model.MostRecentResult.Score points</strong> — level <strong>@Model.MostRecentResult.LevelCode</strong>.
                        Package purchases are restricted to this level.
                    </div>
                }
                <p class="text-muted">Want a different level? A retake requires admin approval.</p>
                <form method="post" asp-page-handler="RequestRetake">
                    <input type="hidden" name="studentId" value="@Model.SelectedStudentId" />
                    <button type="submit" class="btn btn-outline-secondary">Request a retake</button>
                </form>
                break;
        }
    }
}
