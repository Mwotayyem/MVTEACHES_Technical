@page
@model ErrorModel
@{
    ViewData["Title"] = T["Error"];
}

<section class="status-panel">
    <div class="status-icon danger" aria-hidden="true"></div>
    <div>
        <h1>@T["Something went wrong."]</h1>
        <p class="text-muted">@T["The request could not be completed. Try again, or contact the system owner if the problem continues."]</p>
        @if (Model.ShowRequestId)
        {
            <p class="small">
                <strong>@T["Request ID"]:</strong> <code>@Model.RequestId</code>
            </p>
        }
        <a class="btn btn-primary" asp-page="/Index">@T["Back home"]</a>
    </div>
</section>
