@page
@model MVTeaches.Web.Pages.Guardian.MyChildrenModel
@using MVTeaches.Domain.People
@{
    ViewData["Title"] = T["My Children"].Value;
}

@functions {
    string StudentStatusClass(StudentStatus status) => status switch
    {
        StudentStatus.Active => "app-status is-success",
        StudentStatus.PendingVerification or StudentStatus.PendingLevel => "app-status is-warning",
        StudentStatus.PaymentBlocked or StudentStatus.Suspended => "app-status is-danger",
        _ => "app-status is-muted",
    };
}

<h1>@T["My Children"]</h1>

@if (Model.NoGuardianProfileLinked)
{
    <div class="alert alert-warning" role="alert">@T["Your account has the Guardian role but no linked guardian profile yet — ask an admin to link you to your children on /Admin/Students."]</div>
}
else
{
    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <h2 class="h4">@T["Children"]</h2>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-4">
        @foreach (var child in Model.Children)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="card-title h5">@child.FullName</h3>
                        <dl class="row small mb-0">
                            <dt class="col-6">@T["Student number"]</dt>
                            <dd class="col-6"><span class="app-ref">@child.StudentId</span></dd>
                            <dt class="col-6">@T["Current level"]</dt>
                            <dd class="col-6">@(child.LevelCode ?? T["Not specified"].Value)</dd>
                            <dt class="col-6">@T["Status"]</dt>
                            <dd class="col-6"><span class="@StudentStatusClass(child.Status)">@T["StudentStatus." + child.Status]</span></dd>
                            <dt class="col-6">@T["Sessions in this window"]</dt>
                            <dd class="col-6">@child.UpcomingSessionCount</dd>
                        </dl>
                    </div>
                </div>
            </div>
        }
        @if (Model.Children.Count == 0)
        {
            <div class="col-12">
                <div class="app-empty">
                    <strong>@T["No children linked to your account yet."]</strong>
                    <span>@T["Ask the centre to link your children to your account."]</span>
                </div>
            </div>
        }
    </div>

    @* Owner decision 2026-09-04: a guardian adds their own children rather
       than phoning the centre. Each child becomes an independent student with
       their own level, package and remaining hours — nothing is shared between
       siblings. No level or package is offered here: those come from the
       centre, and offering them would promise something this page cannot give. *@
    <details class="card mb-4">
        <summary class="card-body pb-0" style="cursor: pointer;">
            <span class="h5">@T["Add a child"]</span>
        </summary>
        <div class="card-body pt-2">
            <p class="text-muted small">@T["Each child gets their own record, their own level and their own package. The centre sets the level after you add them."]</p>
            <form method="post" asp-page-handler="AddChild" class="row g-2">
                <div class="col-md-6">
                    <label class="form-label" asp-for="NewChild.FullName">@T["Full name"]<span class="app-required">*</span></label>
                    <input asp-for="NewChild.FullName" class="form-control" autocomplete="off" />
                    <span asp-validation-for="NewChild.FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="NewChild.DateOfBirth">@T["Date of birth"]<span class="app-required">*</span></label>
                    <input asp-for="NewChild.DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="NewChild.DateOfBirth" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="NewChild.CountryId">@T["Country"]<span class="app-required">*</span></label>
                    <select asp-for="NewChild.CountryId" class="form-select">
                        <option value="">@T["Select placeholder"]</option>
                        @foreach (var country in Model.Countries)
                        {
                            <option value="@country.Id">@Model.DisplayCountry(country)</option>
                        }
                    </select>
                    <span asp-validation-for="NewChild.CountryId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" asp-for="NewChild.PhoneNumber">@T["Phone number (optional for a child under a guardian)"]</label>
                    <input asp-for="NewChild.PhoneNumber" type="tel" class="form-control" autocomplete="off" />
                    <span asp-validation-for="NewChild.PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">@T["Add this child"]</button>
                </div>
            </form>
        </div>
    </details>

    @* Owner decision 2026-09-04: a guardian books their child's lessons here.
       A child registered by their guardian has no login of their own, so
       before this there was no path to a seat at all except an admin. The
       table matches the Sessions one below deliberately - it is the same kind
       of working list, read the same way. *@
    <h2 class="h4">@T["Book a lesson"]</h2>
    <p class="text-muted">@T["The next 30 days, showing only lessons in a course and level your child is placed in. Booking holds a seat; the hours are drawn from the package when you press Join, not now."]</p>

    <div class="table-responsive mb-4">
        <table class="table table-sm table-striped">
            <thead><tr><th>@T["Child"]</th><th>@T["When"]</th><th>@T["Teacher"]</th><th>@T["Course and level"]</th><th>@T["Seats"]</th><th>@T["Actions"]</th></tr></thead>
            <tbody>
                @foreach (var b in Model.BookableSessions)
                {
                    <tr>
                        <td><strong>@b.StudentName</strong></td>
                        <td>
                            @T.SessionMoment(b.StartsAtUtc, b.StudentTimeZone)
                            <div class="text-muted small">@DisplayFormat.ZoneLabel(b.StudentTimeZone)</div>
                            @if (!string.Equals(b.StudentTimeZone, b.ScheduleTimeZone, StringComparison.Ordinal))
                            {
                                <div class="text-muted small">@T["Centre time: {0} ({1})", T.SessionMoment(b.StartsAtUtc, b.ScheduleTimeZone), DisplayFormat.ZoneLabel(b.ScheduleTimeZone)]</div>
                            }
                            <div class="text-muted small">@T["{0} minutes", b.DurationMinutes]</div>
                        </td>
                        <td>@b.TeacherName</td>
                        <td>@b.CourseName / @b.LevelCode</td>
                        <td>@b.SeatsTaken / @b.Capacity</td>
                        <td>
                            @* A full lesson and one already booked are both shown
                               with the reason said out loud rather than dropped
                               from the list: a lesson that quietly vanishes reads
                               as a mistake. *@
                            @if (b.AlreadyBooked)
                            {
                                <span class="app-status is-success">@T["Booked"]</span>
                            }
                            else if (b.SeatsTaken >= b.Capacity)
                            {
                                <span class="text-muted">@T["Full"]</span>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Book">
                                    <input type="hidden" name="sessionId" value="@b.SessionId" />
                                    <input type="hidden" name="studentId" value="@b.StudentId" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">@T["Book for {0}", b.StudentName]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.BookableSessions.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted">@T["No lessons are open for booking at your children's courses and levels right now."]</td></tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="h4">@T["Sessions"]</h2>
    <p class="text-muted">@T["Yesterday through the next 7 days. Press Join once the session has started — the child's full attendance for that session is recorded immediately; pressing again does nothing extra."]</p>

    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead><tr><th>@T["Child"]</th><th>@T["When"]</th><th>@T["Teacher"]</th><th>@T["Course and level"]</th><th>@T["Status"]</th><th>@T["Actions"]</th></tr></thead>
            <tbody>
                @foreach (var s in Model.UpcomingSessions)
                {
                    <tr>
                        <td><strong>@s.StudentName</strong></td>
                        <td>
                            @* Owner decision 2026-09-04: the child's own country
                               time first, always labelled. The centre's own
                               schedule time is added underneath ONLY when the two
                               differ - showing it always would just repeat the
                               line above for the many families in the same zone. *@
                            @T.SessionMoment(s.StartsAtUtc, s.StudentTimeZone)
                            <div class="text-muted small">@DisplayFormat.ZoneLabel(s.StudentTimeZone)</div>
                            @if (!string.Equals(s.StudentTimeZone, s.ScheduleTimeZone, StringComparison.Ordinal))
                            {
                                <div class="text-muted small">@T["Centre time: {0} ({1})", T.SessionMoment(s.StartsAtUtc, s.ScheduleTimeZone), DisplayFormat.ZoneLabel(s.ScheduleTimeZone)]</div>
                            }
                        </td>
                        <td>@s.TeacherName</td>
                        <td>@s.CourseName / @s.LevelCode</td>
                        <td>
                            @if (s.AlreadyPresent)
                            {
                                <span class="app-status is-success">@T["Present"]</span>
                            }
                            else
                            {
                                <span class="text-muted">@T["ClassSessionStatus." + s.SessionStatus]</span>
                            }
                        </td>
                        <td>
                            @if (s.CanJoin)
                            {
                                @* One press, one child, one session - the hidden
                                   studentId is what the service authorizes and
                                   deducts against, and it is per row. The label
                                   names the child so a parent with several
                                   children can see which button is which. *@
                                <form method="post" asp-page-handler="Join">
                                    <input type="hidden" name="sessionId" value="@s.SessionId" />
                                    <input type="hidden" name="studentId" value="@s.StudentId" />
                                    <button type="submit" class="btn btn-sm btn-primary">@T["Join as {0}", s.StudentName]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.UpcomingSessions.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted">@T["No sessions in this window."]</td></tr>
                }
            </tbody>
        </table>
    </div>
}
