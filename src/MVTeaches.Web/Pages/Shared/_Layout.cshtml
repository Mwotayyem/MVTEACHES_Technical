@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using MVTeaches.Web.Resources
@inject IStringLocalizer<SharedResource> T
@inject IWebHostEnvironment Env
@inject IAuthorizationService AuthorizationService
@{
    var culture = CultureInfo.CurrentUICulture.Name;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var requestPath = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var title = ViewData["Title"]?.ToString() ?? T["MVTEACHES"].Value;

    bool IsCurrent(string page) => string.Equals(currentPage, page, StringComparison.OrdinalIgnoreCase);
    string NavClass(string page) => IsCurrent(page) ? "app-nav-link active" : "app-nav-link";

    // Security review 2026-09-02 (Review Required — Authorization) Stage 1:
    // this hides links only — the real enforcement is server-side on each
    // page/handler (see PermissionAuthorizationHandler). Computed once here
    // and reused by both the desktop sidebar and the mobile offcanvas below,
    // rather than repeating the same four checks twice. Skipped entirely for
    // non-admin accounts, since none of these links render for them anyway.
    var isAdminRole = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.SystemAdmin);
    var isSystemAdmin = User.IsInRole(RoleNames.SystemAdmin);
    var canViewPayments = isAdminRole && (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.PaymentsView)).Succeeded;
    // Owner decision 2026-09-04: /Admin/PaymentMethods leaves the navigation
    // entirely. The centre collects money by manual transfer and confirms it
    // by hand until an e-commerce decision is taken, so the method catalogue
    // is a one-off setup screen, not daily work — it was already SystemAdmin-
    // only in the sidebar (2026-09-03) and now has no sidebar entry at all.
    // NOTHING else changed: the page, its [Authorize(Policy=PaymentsManage)],
    // its handlers, and the payment_method_configs table are all untouched,
    // and anyone holding Payments.Manage still opens it directly by URL.
    // No flag is computed for it any more.
    // Owner UX-simplification decision (2026-09-03): /Admin/Payroll's own
    // open-period/approve/pay workflow is intentionally not part of the daily
    // admin nav in this MVP stage (see FinancialReport's read-only "Teacher
    // dues" section for the number admins actually need day to day). No nav
    // flag is computed for it anymore — this only removes the sidebar entry
    // point; the page itself, its [Authorize(Policy=PayrollView)], and every
    // OnPost handler are completely untouched and still reachable by URL.
    var canViewSubscriptions = isAdminRole && (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.SubscriptionsView)).Succeeded;
    // Stage 2 (2026-09-03): /Admin/AssistedRegistration requires Manage for
    // its GET too (see its own class-level policy), not View — so its link
    // is gated on canManageStudents, not canViewStudents.
    var canViewStudents = isAdminRole && (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.StudentsView)).Succeeded;
    var canManageStudents = isAdminRole && (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.StudentsManage)).Succeeded;
    // Stage 2B (2026-09-03): /Admin/RescheduleSessions shares Schedules'
    // View key for its own GET (see its own class-level policy) — one flag
    // gates both links.
    var canViewTeachers = isAdminRole && (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.TeachersView)).Succeeded;
    var canViewSchedules = isAdminRole && (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.SchedulesView)).Succeeded;
    var canViewCompensation = isAdminRole && (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.CompensationView)).Succeeded;
    var canViewPlacementTests = isAdminRole && (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.PlacementTestsView)).Succeeded;
    var canViewCertificates = isAdminRole && (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.CertificatesView)).Succeeded;
    // Stage 2D (2026-09-03): the last three admin pages that still fell back
    // to the bare Admin/SystemAdmin-role check.
    var canViewDashboard = isAdminRole && (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.DashboardView)).Succeeded;
    var canViewFinancialReport = isAdminRole && (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.FinancialReportView)).Succeeded;
    var canViewPosters = isAdminRole && (await AuthorizationService.AuthorizeAsync(User, PermissionKeys.PostersView)).Succeeded;
}
@functions {
    // Inline, single-colour line icons for the sidebar. Deliberately hand-written
    // paths rather than an icon package: the nav has one icon per entry and
    // adding a dependency for 20 glyphs is not worth the weight (see CLAUDE.md
    // on new libraries). Every icon is aria-hidden — the link text is the label.
    static readonly IReadOnlyDictionary<string, string> NavIconPaths = new Dictionary<string, string>
    {
        ["grid"] = "<rect x='3' y='3' width='7' height='7' rx='1.5'/><rect x='14' y='3' width='7' height='7' rx='1.5'/><rect x='3' y='14' width='7' height='7' rx='1.5'/><rect x='14' y='14' width='7' height='7' rx='1.5'/>",
        ["users"] = "<path d='M16 19v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V19'/><circle cx='9' cy='7' r='3'/><path d='M22 19v-1.5a4 4 0 0 0-3-3.87'/><path d='M16 4.13a4 4 0 0 1 0 5.74'/>",
        ["user-plus"] = "<path d='M15 19v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V19'/><circle cx='8.5' cy='7' r='3'/><path d='M19 8v6'/><path d='M22 11h-6'/>",
        ["academic"] = "<path d='M3 9l9-4 9 4-9 4-9-4z'/><path d='M7 11v4.5c0 1.1 2.2 2.5 5 2.5s5-1.4 5-2.5V11'/><path d='M21 9v5'/>",
        ["clipboard"] = "<rect x='6' y='4' width='12' height='17' rx='2'/><path d='M9 4V3h6v1'/><path d='M9 12l2 2 4-4'/>",
        ["package"] = "<path d='M12 3l8 4v10l-8 4-8-4V7l8-4z'/><path d='M4 7l8 4 8-4'/><path d='M12 11v10'/>",
        ["card"] = "<rect x='2.5' y='5' width='19' height='14' rx='2.5'/><path d='M2.5 10h19'/><path d='M6.5 15h3'/>",
        ["wallet"] = "<path d='M3 7.5A2.5 2.5 0 0 1 5.5 5H18a2 2 0 0 1 2 2v1'/><rect x='3' y='7.5' width='18' height='11.5' rx='2.5'/><circle cx='16.5' cy='13' r='1.2'/>",
        ["calendar"] = "<rect x='3' y='5' width='18' height='16' rx='2.5'/><path d='M3 10h18'/><path d='M8 3v4'/><path d='M16 3v4'/>",
        ["refresh"] = "<path d='M20 11a8 8 0 0 0-14-4.5L3 9'/><path d='M4 13a8 8 0 0 0 14 4.5L21 15'/><path d='M3 5v4h4'/><path d='M21 19v-4h-4'/>",
        ["inbox"] = "<path d='M3 13h5l1.5 3h5L16 13h5'/><path d='M4.5 5.5h15l1.5 7.5v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4z'/>",
        ["banknote"] = "<rect x='2.5' y='6' width='19' height='12' rx='2.5'/><circle cx='12' cy='12' r='2.5'/><path d='M6 10v4'/><path d='M18 10v4'/>",
        ["chart"] = "<path d='M4 20V4'/><path d='M4 20h16'/><rect x='7.5' y='12' width='3' height='5' rx='1'/><rect x='13' y='8' width='3' height='9' rx='1'/>",
        ["award"] = "<circle cx='12' cy='9' r='5'/><path d='M8.5 13.5L7 21l5-2.5L17 21l-1.5-7.5'/>",
        ["video"] = "<rect x='2.5' y='6' width='13' height='12' rx='2.5'/><path d='M15.5 10.5L21.5 7v10l-6-3.5'/>",
        ["clock"] = "<circle cx='12' cy='12' r='8.5'/><path d='M12 7.5V12l3 1.75'/>",
        ["receipt"] = "<path d='M6 3h12v18l-3-1.5L12 21l-3-1.5L6 21z'/><path d='M9.5 8h5'/><path d='M9.5 12h5'/>",
        ["link"] = "<path d='M10 13.5a3.5 3.5 0 0 0 5 0l3-3a3.5 3.5 0 1 0-5-5l-1 1'/><path d='M14 10.5a3.5 3.5 0 0 0-5 0l-3 3a3.5 3.5 0 1 0 5 5l1-1'/>",
        ["cart"] = "<circle cx='9.5' cy='19' r='1.4'/><circle cx='17' cy='19' r='1.4'/><path d='M2.5 4h2.2l2.3 11h11l2-8H6'/>",
        ["shield"] = "<path d='M12 3l7.5 3v5.5c0 4.5-3.2 7.7-7.5 9.2-4.3-1.5-7.5-4.7-7.5-9.2V6z'/><path d='M9.5 12l2 2 3.5-3.5'/>",
        ["home"] = "<path d='M4 10.5L12 4l8 6.5'/><path d='M6 9.5V20h12V9.5'/><path d='M10 20v-5h4v5'/>",
        ["dot"] = "<circle cx='12' cy='12' r='4'/>",
    };

    Microsoft.AspNetCore.Html.IHtmlContent NavIcon(string name)
    {
        var path = NavIconPaths.TryGetValue(name, out var found) ? found : NavIconPaths["dot"];
        return new Microsoft.AspNetCore.Html.HtmlString(
            "<span class=\"app-nav-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" focusable=\"false\">" + path + "</svg></span>");
    }
}
<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - @T["MVTEACHES"]</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Almarai:wght@300;400;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVTeaches.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @if (Env.IsStaging())
    {
        <div class="app-staging-banner" role="alert">
            بيانات تجريبية — Local Staging — ليست بيانات حقيقية · Test data — not real data
        </div>
    }
    <div class="app-shell">
        <header class="app-topbar">
            <div class="app-brand">
                <a class="app-brand-mark" asp-area="" asp-page="/Index" aria-label="@T["MVTEACHES"]">MV</a>
                <div>
                    <a class="app-brand-name" asp-area="" asp-page="/Index">@T["MVTEACHES"]</a>
                    <div class="app-brand-subtitle">@T["Online Education Platform"]</div>
                </div>
            </div>

            <button class="app-menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav"
                    aria-controls="mobileNav" aria-label="@T["Open navigation"]">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="app-topbar-actions">
                <form method="post" asp-page="/Culture" class="app-language-switch" aria-label="@T["Language"]">
                    <input type="hidden" name="returnUrl" value="@requestPath" />
                    <button type="submit" name="culture" value="ar-JO" class="@(culture.StartsWith("ar", StringComparison.OrdinalIgnoreCase) ? "active" : "")">العربية</button>
                    <button type="submit" name="culture" value="en" class="@(culture.StartsWith("en", StringComparison.OrdinalIgnoreCase) ? "active" : "")">English</button>
                </form>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @await Component.InvokeAsync("CurrentUserName")
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Account/ChangePassword">@T["Change password"]</a>
                    <form method="post" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">@T["Sign out"]</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" asp-area="" asp-page="/Account/Login">@T["Sign in"]</a>
                }
            </div>
        </header>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="app-sidebar" aria-label="@T["Primary navigation"]">
                <nav class="app-nav">
                    @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.SystemAdmin))
                    {
                        @* Owner decision 2026-09-04 (nav decluttering): headings
                           that stood over a single link were carrying no
                           information — the link already said what it was. The
                           groups below are merged so every heading names a real
                           set, and Dashboard leads with no heading at all since
                           it is the first thing in the list. Only headings moved:
                           every link, icon, and permission flag is unchanged. *@
                        @if (canViewDashboard)
                        {
                            <a class="@NavClass("/Admin/Dashboard")" asp-page="/Admin/Dashboard">@NavIcon("grid")@T["Dashboard"]</a>
                        }
                        <div class="app-nav-group">@T["Students and Guardians"]</div>
                        @if (canViewStudents)
                        {
                            <a class="@NavClass("/Admin/Students")" asp-page="/Admin/Students">@NavIcon("users")@T["Students"]</a>
                        }
                        @if (canManageStudents)
                        {
                            <a class="@NavClass("/Admin/AssistedRegistration")" asp-page="/Admin/AssistedRegistration">@NavIcon("user-plus")@T["Assisted Registration"]</a>
                        }
                        <div class="app-nav-group">@T["Teachers and Placement"]</div>
                        @if (canViewTeachers)
                        {
                            <a class="@NavClass("/Admin/Teachers")" asp-page="/Admin/Teachers">@NavIcon("academic")@T["Teachers"]</a>
                        }
                        @if (canViewPlacementTests)
                        {
                            <a class="@NavClass("/Admin/PlacementTests")" asp-page="/Admin/PlacementTests">@NavIcon("clipboard")@T["Placement Tests"]</a>
                        }
                        <div class="app-nav-group">@T["Packages and Payments"]</div>
                        @if (canViewSubscriptions)
                        {
                            <a class="@NavClass("/Admin/Subscriptions")" asp-page="/Admin/Subscriptions">@NavIcon("package")@T["Subscriptions"]</a>
                        }
                        @if (canViewPayments)
                        {
                            <a class="@NavClass("/Admin/Payments")" asp-page="/Admin/Payments">@NavIcon("card")@T["Payments"]</a>
                        }
                        @if (canViewPosters)
                        {
                            <a class="@NavClass("/Admin/Posters")" asp-page="/Admin/Posters">@NavIcon("package")@T["Offer posters"]</a>
                        }
                        <div class="app-nav-group">@T["Scheduling and Attendance"]</div>
                        @if (canViewSchedules)
                        {
                            <a class="@NavClass("/Admin/Schedules")" asp-page="/Admin/Schedules">@NavIcon("calendar")@T["Schedules"]</a>
                        }
                        @if (canViewCompensation)
                        {
                            <a class="@NavClass("/Admin/CompensationRequests")" asp-page="/Admin/CompensationRequests">@NavIcon("inbox")@T["Compensation Requests"]</a>
                        }
                        @* Owner UX-simplification decision (2026-09-03): Reschedule / Compensation
                           is not part of the daily nav in this MVP stage — the student/guardian
                           compensation-request flow above is the simpler path the owner wants
                           surfaced. The page, its [Authorize(Policy=SchedulesView)], and both
                           OnPost handlers (OnPostRescheduleAsync/OnPostApproveAsync) are untouched;
                           it is still reachable directly by URL for anyone holding that permission. *@
                        @* Owner decision 2026-09-04: this heading used to read
                           "Payroll and Expenses", which stopped being true once
                           /Admin/Payroll left the nav (2026-09-03) and only the
                           financial report remained under it — a heading naming
                           two things that are not there. It now names what is
                           actually below it. /Admin/Payroll itself, its policy,
                           and its handlers remain untouched and URL-reachable;
                           FinancialReport's read-only "Teacher dues" section is
                           the number admins need day to day. *@
                        <div class="app-nav-group">@T["Reports and Certificates"]</div>
                        @if (canViewFinancialReport)
                        {
                            <a class="@NavClass("/Admin/FinancialReport")" asp-page="/Admin/FinancialReport">@NavIcon("chart")@T["Financial Report"]</a>
                        }
                        @if (canViewCertificates)
                        {
                            <a class="@NavClass("/Admin/Certificates")" asp-page="/Admin/Certificates">@NavIcon("award")@T["Certificates"]</a>
                        }
                        @if (isSystemAdmin)
                        {
                            <div class="app-nav-group">@T["Administration"]</div>
                            <a class="@NavClass("/Admin/AdminUsers")" asp-page="/Admin/AdminUsers">@NavIcon("shield")@T["Admin accounts and permissions"]</a>
                        }
                    }
                    @if (User.IsInRole(RoleNames.Teacher))
                    {
                        <div class="app-nav-group">@T["Teacher workspace"]</div>
                        <a class="@NavClass("/Teacher/MySessions")" asp-page="/Teacher/MySessions">@NavIcon("video")@T["My Sessions"]</a>
                        <a class="@NavClass("/Teacher/PublishSlots")" asp-page="/Teacher/PublishSlots">@NavIcon("clock")@T["Publish Slots"]</a>
                        <a class="@NavClass("/Teacher/MyPayHistory")" asp-page="/Teacher/MyPayHistory">@NavIcon("receipt")@T["My Pay History"]</a>
                        <a class="@NavClass("/Teacher/Connections")" asp-page="/Teacher/Connections">@NavIcon("link")@T["Connections"]</a>
                    }
                    @if (User.IsInRole(RoleNames.Guardian))
                    {
                        <div class="app-nav-group">@T["Guardian workspace"]</div>
                        <a class="@NavClass("/Guardian/MyChildren")" asp-page="/Guardian/MyChildren">@NavIcon("users")@T["My Children"]</a>
                        <a class="@NavClass("/PlacementTest")" asp-page="/PlacementTest">@NavIcon("clipboard")@T["Placement Test"]</a>
                        <a class="@NavClass("/PurchasePackage")" asp-page="/PurchasePackage">@NavIcon("cart")@T["Purchase Package"]</a>
                    }
                    @if (User.IsInRole(RoleNames.Student))
                    {
                        <div class="app-nav-group">@T["Student workspace"]</div>
                        <a class="@NavClass("/Student/MySessions")" asp-page="/Student/MySessions">@NavIcon("video")@T["My Sessions"]</a>
                        <a class="@NavClass("/PlacementTest")" asp-page="/PlacementTest">@NavIcon("clipboard")@T["Placement Test"]</a>
                        <a class="@NavClass("/PurchasePackage")" asp-page="/PurchasePackage">@NavIcon("cart")@T["Purchase Package"]</a>
                    }
                    <div class="app-nav-group">@T["System"]</div>
                    <a class="@NavClass("/Privacy")" asp-page="/Privacy">@NavIcon("shield")@T["Privacy"]</a>
                </nav>
            </aside>
        }

        <div class="offcanvas @(isRtl ? "offcanvas-end" : "offcanvas-start")" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
            <div class="offcanvas-header">
                <h2 class="offcanvas-title h5" id="mobileNavLabel">@T["Navigation"]</h2>
                <button type="button" class="btn-close @(isRtl ? "ms-0 me-auto" : "")" data-bs-dismiss="offcanvas" aria-label="@T["Close"]"></button>
            </div>
            <div class="offcanvas-body">
                <nav class="app-nav">
                    <a class="@NavClass("/Index")" asp-page="/Index">@NavIcon("home")@T["Home"]</a>
                    @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.SystemAdmin))
                    {
                        @if (canViewDashboard)
                        {
                            <a class="@NavClass("/Admin/Dashboard")" asp-page="/Admin/Dashboard">@NavIcon("grid")@T["Dashboard"]</a>
                        }
                        @if (canViewStudents)
                        {
                            <a class="@NavClass("/Admin/Students")" asp-page="/Admin/Students">@NavIcon("users")@T["Students"]</a>
                        }
                        @if (canManageStudents)
                        {
                            <a class="@NavClass("/Admin/AssistedRegistration")" asp-page="/Admin/AssistedRegistration">@NavIcon("user-plus")@T["Assisted Registration"]</a>
                        }
                        @if (canViewTeachers)
                        {
                            <a class="@NavClass("/Admin/Teachers")" asp-page="/Admin/Teachers">@NavIcon("academic")@T["Teachers"]</a>
                        }
                        @if (canViewSchedules)
                        {
                            <a class="@NavClass("/Admin/Schedules")" asp-page="/Admin/Schedules">@NavIcon("calendar")@T["Schedules"]</a>
                        }
                        @if (canViewSubscriptions)
                        {
                            <a class="@NavClass("/Admin/Subscriptions")" asp-page="/Admin/Subscriptions">@NavIcon("package")@T["Subscriptions"]</a>
                        }
                        @if (canViewPayments)
                        {
                            <a class="@NavClass("/Admin/Payments")" asp-page="/Admin/Payments">@NavIcon("card")@T["Payments"]</a>
                        }
                        @if (canViewPosters)
                        {
                            <a class="@NavClass("/Admin/Posters")" asp-page="/Admin/Posters">@NavIcon("package")@T["Offer posters"]</a>
                        }
                        @if (isSystemAdmin)
                        {
                            <a class="@NavClass("/Admin/AdminUsers")" asp-page="/Admin/AdminUsers">@NavIcon("shield")@T["Admin accounts and permissions"]</a>
                        }
                    }
                    @if (User.IsInRole(RoleNames.Teacher))
                    {
                        <a class="@NavClass("/Teacher/MySessions")" asp-page="/Teacher/MySessions">@NavIcon("video")@T["My Sessions"]</a>
                        <a class="@NavClass("/Teacher/PublishSlots")" asp-page="/Teacher/PublishSlots">@NavIcon("clock")@T["Publish Slots"]</a>
                        <a class="@NavClass("/Teacher/MyPayHistory")" asp-page="/Teacher/MyPayHistory">@NavIcon("receipt")@T["My Pay History"]</a>
                        <a class="@NavClass("/Teacher/Connections")" asp-page="/Teacher/Connections">@NavIcon("link")@T["Connections"]</a>
                    }
                    @if (User.IsInRole(RoleNames.Guardian))
                    {
                        <a class="@NavClass("/Guardian/MyChildren")" asp-page="/Guardian/MyChildren">@NavIcon("users")@T["My Children"]</a>
                    }
                    @if (User.IsInRole(RoleNames.Student))
                    {
                        <a class="@NavClass("/Student/MySessions")" asp-page="/Student/MySessions">@NavIcon("video")@T["My Sessions"]</a>
                    }
                    @if (User.IsInRole(RoleNames.Guardian) || User.IsInRole(RoleNames.Student))
                    {
                        <a class="@NavClass("/PlacementTest")" asp-page="/PlacementTest">@NavIcon("clipboard")@T["Placement Test"]</a>
                        <a class="@NavClass("/PurchasePackage")" asp-page="/PurchasePackage">@NavIcon("cart")@T["Purchase Package"]</a>
                    }
                    <a class="@NavClass("/Privacy")" asp-page="/Privacy">@NavIcon("shield")@T["Privacy"]</a>
                </nav>
            </div>
        </div>

        <main class="app-main @(User.Identity?.IsAuthenticated == true ? "" : "public")" role="main">
            @RenderBody()
        </main>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <footer class="app-footer">
                <span>&copy; 2026 @T["MVTEACHES"]</span>
                <a asp-area="" asp-page="/Privacy">@T["Privacy"]</a>
            </footer>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
