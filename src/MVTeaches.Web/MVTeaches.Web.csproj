<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\MVTeaches.Domain\MVTeaches.Domain.csproj" />
    <ProjectReference Include="..\MVTeaches.Application\MVTeaches.Application.csproj" />
    <ProjectReference Include="..\MVTeaches.Infrastructure\MVTeaches.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Design-time only, for `dotnet ef migrations` run with this as the startup
         project — never touches runtime behavior (PrivateAssets keeps it out of
         the published output). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>af1408e2-6734-4d27-948a-1477a376483d</UserSecretsId>
  </PropertyGroup>

</Project>
